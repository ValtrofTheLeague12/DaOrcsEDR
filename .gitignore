# MEGA evidence storage. The scripts are tracked; nothing else in here is.
# The sealed credential no longer lives here at all - it moved to
# %APPDATA%\IAProject\mega-secrets\ (see mega/credential.py secrets_dir()), so
# `git add -A`, a repo backup or an archive of this tree cannot reach it. The
# denies below stay as a backstop in case anything is ever re-sealed in place:
# credential.key next to credentials.enc opens the account.
!mega/
mega/*
!mega/login.py
!mega/upload.py
!mega/credential.py
!mega/megacmd.py
!mega/list.py
!mega/recover.py
!mega/README.md
mega/credentials.enc
mega/credential.key
mega/*.gpg
mega/*.key
mega/*.enc
mega/*.bak

# Native orchestration wrapper for the MEGA uploader.
!include/
!include/mega/
!include/mega/mega_runner.hpp
!src/
!src/mega/
!src/mega/mega_runner.cpp

# Admin orchestration panel - Flask backend. The repo ignores by default and
# whitelists, so both the entry point and the package directory have to be
# re-included before anything inside them can be added (git will not descend
# into an excluded directory). Same trap that hid mega/megacmd.py.
!python/admin_server.py
!python/panel/
!python/panel/*
# HMAC key for the panel's session cookie. Generated on first run, 0600, and
# signing-key shaped: anything holding it can mint a session. The !python/panel/*
# above re-includes the whole directory, so it has to be denied explicitly or it
# gets committed and every install starts sharing one signing key.
python/panel/.session-key

# Admin orchestration panel - React front end. Source and the lockfile are
# tracked so the build is reproducible; node_modules and dist are not. dist is
# a build artefact, and committing it makes the served bundle a tracked file
# that silently goes stale.
!admin-panel.ps1
!admin-web/
admin-web/node_modules
admin-web/dist
!admin-web/package.json
!admin-web/package-lock.json
!admin-web/vite.config.ts
!admin-web/tsconfig.json
!admin-web/index.html
!admin-web/src
!admin-web/src/**

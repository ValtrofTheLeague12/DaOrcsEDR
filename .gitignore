!admin-terminal/
admin-terminal/*
!admin-terminal/admin.py
!admin-terminal/activate.py
!admin-terminal/builder.py
!admin-terminal/core.py
!admin-terminal/qiling_setup.py
!admin-terminal/vms.py
!admin-terminal/vms.json
!admin-terminal/qiling_vm.py
!qiling_dlls/
qiling_dlls/*
!qiling_dlls/dll_collector.bat
!qiling_dlls/known_hosts.ssh
!qiling_dlls/vm_info.json
!qiling_dlls/qilin-service.install.sh
!qiling_dlls/qilin-check-service.sh
!qiling_dlls/templates/
qiling_dlls/templates/*
!qiling_dlls/templates/*.j2
# python/ is the single home for every Python script in the tree. The repo
# ignores by default and whitelists, so python/ has to be re-included as a
# directory before anything inside it can be (git will not descend into an
# excluded directory). This does not untrack anything already tracked.
!python/
python/*
!python/api/
!python/templates/
!python/templates/*.j2
# ClamAV host-side tooling.
!python/clamd/
python/clamd/*
!python/clamd/clamd-python.py
!python/clamd/scan_remote.py
!python/clamd/_collect_clamd_artifacts.py
!python/clamd/_configure_clamd.pyc
!python/clamd/vm_info.json
!python/clamd/test_clamd_connection.sh
!python/clamd/requirements.txt
# Qiling emulation tooling. qiling_dlls/ keeps only what gets staged onto the
# analysis VM (rootfs.tar.gz, examples/, templates/, dll_collector.bat), and its
# basename is still the VM's remote_dir - see admin-terminal/vms.json.
!python/qiling/
python/qiling/*
!python/qiling/_qiling_script.py
!python/qiling/_configure_quiling.py
!python/qiling/_check_vm_connection.py
!python/qiling/_collect_qiling_artifacts.py
!python/qiling/_build_dashboard.py
!python/qiling/_cti_intel.py
!python/qiling/requirements.txt
!tests/
tests/*
!tests/test_server_queue.py
!tests/test_admin_terminal.py
!tests/test_qiling_setup.py
!tests/test_pipeline_cli.py
!config/
config/*
!config/artifacts.yaml
# Global analysis settings - the ones that apply to every run. Unlisted, the
# shipped default is invisible and every checkout silently runs with
# whatever the operator's shell happens to say.
!config/analysis.yaml
# The YARA check's own persisted switches (currently only whether files that
# fail to compile are ignored). Gets written when the checkbox in the console
# is toggled, so it must be tracked - a setting that silently resets on a
# re-clone is the same one nobody can rely on.
!config/yara_check.json
# The build's hardening settings (ASLR, high-entropy VA, DEP/NX, stack
# protector). Tracked for the same reason as yara_check.json, and then some:
# the panel writes it, build.ps1 reads it, and a re-clone that silently reset
# every protection would produce a binary nobody can tell from a deliberately
# weakened one. The intent has to survive the checkout.
!config/hardening.json
# The sample factory's GitHub source definitions (URL + kind, no fetched
# values). Tracked for the same reason: the two seeded sources and any source
# an operator adds are configuration, and an empty pool after a re-clone would
# look like the feature is broken. The dumps themselves stay in ressources/,
# ignored.
!config/sample_resources.json
!config/systemd/
config/systemd/*
!config/systemd/qilin-service/
config/systemd/qilin-service/*
!config/systemd/qilin-service/*.service
# MEGA evidence storage. The scripts are tracked; nothing else in here is.
# The sealed credential no longer lives here at all - it moved to
# %APPDATA%\IAProject\mega-secrets\ (see mega/credential.py secrets_dir()), so
# `git add -A`, a repo backup or an archive of this tree cannot reach it. The
# denies below stay as a backstop in case anything is ever re-sealed in place:
# credential.key next to credentials.enc opens the account.
!mega/
mega/*
!mega/login.py
!mega/upload.py
!mega/credential.py
!mega/megacmd.py
!mega/list.py
!mega/recover.py
!mega/README.md
mega/credentials.enc
mega/credential.key
mega/*.gpg
mega/*.key
mega/*.enc
mega/*.bak

# Native orchestration wrapper for the MEGA uploader.
!include/
!include/mega/
!include/mega/mega_runner.hpp
!src/
!src/mega/
!src/mega/mega_runner.cpp

# Admin orchestration panel - Flask backend. The repo ignores by default and
# whitelists, so both the entry point and the package directory have to be
# re-included before anything inside them can be added (git will not descend
# into an excluded directory). Same trap that hid mega/megacmd.py.
!python/admin_server.py
!python/panel/
!python/panel/**

# Scripts directly in python/. `die_scan.py` and `malapi_pipeline.py` were
# already invisible here before this line existed - the same trap as src/ and
# include/, with `!python/panel/**` covering only the subdirectory.
!python/*.py
# HMAC key for the panel's session cookie. Generated on first run, 0600, and
# signing-key shaped: anything holding it can mint a session. The !python/panel/**
# above re-includes the whole directory, so it has to be denied explicitly or it
# gets committed and every install starts sharing one signing key.
python/panel/.session-key
python/panel/**/__pycache__/
# Local operator scratch in the utils package. config/vm_info.json holds VM
# credentials; vm_utility.py is an unfinished local tool that the panel never
# imports. Neither belongs in a checkout.
python/panel/utils/config/
python/panel/utils/vm_utility.py

# Admin orchestration panel - React front end. Source and the lockfile are
# tracked so the build is reproducible; node_modules and dist are not. dist is
# a build artefact, and committing it makes the served bundle a tracked file
# that silently goes stale.
!admin-panel.ps1
!admin-web/
admin-web/node_modules
admin-web/dist
!admin-web/package.json
!admin-web/package-lock.json
!admin-web/vite.config.ts
!admin-web/tsconfig.json
!admin-web/index.html
!admin-web/src
!admin-web/src/**

# ---------------------------------------------------------------------------
# Source trees, wholesale.
#
# The whitelist above needs a line per file, which means every new source file
# is invisible to `git status` until someone remembers to add one here - a trap
# that has already cost work twice in this project. src/ and include/ contain
# nothing but .c/.cpp/.h/.hpp (checked: no generated files, no build output), so
# they can simply be unignored whole.
# ---------------------------------------------------------------------------
!src/
!src/**
!include/
!include/**

# The logos the startup and crash banners resolve, in their documented order:
# crash.logo -> daorcs.logo -> pdcursor.logo. The .swp is a vim swap file for an
# art file under edit, and stays ignored.
!logos/
!logos/*.logo

# tools/ holds vendored checkouts (cminer, bin, compressor_tool,
# sample_archive) that stay ignored on purpose. Only the scripts added to it are
# listed, rather than !tools/*.py, so titlecase_summaries.py stays excluded as
# it was.
!tools/
!tools/selftest_cli.py
!tools/dll_closure.py
!tools/panel_mem_probe.py
!tools/BUILD_PANEL_PLAN.md
# tools/yarGen/ holds our own maintenance script for the yarGen-Go checkout,
# which cannot live in the checkout itself: that is a nested git repository,
# so a file inside it is tracked by neither repository and every fix to it is
# one re-clone from being lost.
!tools/yarGen/
!tools/yarGen/**

# Documentation, split by topic. Without this the whole docs/ tree is
# invisible, which is the same trap as everything above - and worse here,
# because a README that links into a directory git is not tracking looks fine
# locally and 404s for everyone else.
!docs/
!docs/**

# Every runnable command, with the output each one actually produced. Same
# whitelist trap as docs/: a COMMANDS.md that exists on disk and not in the
# repository is the most quietly useless file there is.
!COMMANDS.md

# `!mega/` unignores the directory but the leading `*` re-ignores what is inside
# it, so each file still needs its own line - the same rule the whole rest of
# this file follows.
!mega/seal.py
!mega/test_seal.py

# Unit tests. The whole tree, because a whitelist that has to be edited per new
# test file is the same trap as above, and a test that is invisible is a test
# that does not exist as far as the next person is concerned.
!unit/
!unit/**

# ...but not the byte-code pytest leaves in it. Later patterns win, so these go
# after the negation above; without them a test run makes the tree dirty.
unit/**/__pycache__/
unit/**/*.pyc

# Generated artefacts that were tracked before .gitignore existed, removed on
# 2026-10-19. None are referenced by code; they were the reason a fresh clone
# carried a stray .pyc and two editor backups.
*.pyc
python/clamd/_configure_clamd.pyc
*.bak
# WinHTTrack mirror state. Its own readme warns these may carry credentials
# from the mirrored sites, which is reason enough not to version them. The
# cache itself is still tracked - only the regenerable old/ and the logs go.
**/hts-log.txt
**/hts-cache/doit.log
**/hts-cache/old.zip
**/hts-cache/old.lst

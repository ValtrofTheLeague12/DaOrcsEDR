# Secrets and local credentials
# .env holds real values and must never be committed; .env.example is the
# committed template that documents which keys the project expects.
.env
.env.*
!.env.example
secrets.json
bitwarden*.json
*.pem
*.key
*.pfx
*.p12
credentials.json
# Local agent launcher: machine specific, and it holds a gateway token in
# plain text (ANTHROPIC_AUTH_TOKEN), so it must never be committed.
claude.ps1


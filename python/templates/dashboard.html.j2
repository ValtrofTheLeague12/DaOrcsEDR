/* Zoom the map onto one country (used by the side list). */
function geoFocus(cc) {
  const svgEl = document.getElementById("geoSvg"), p = geoState.pos[cc];
  if (!svgEl || !p || !geoZoom) return;
  const W = svgEl.clientWidth || 960, H = svgEl.clientHeight || 600;
  const k = 4;
  d3.select(svgEl).transition().duration(500)
    .call(geoZoom.transform, d3.zoomIdentity.translate(W / 2 - k * p[0], H / 2 - k * p[1]).scale(k));

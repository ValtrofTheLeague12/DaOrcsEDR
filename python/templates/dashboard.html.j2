/* ═══ D3 Charts ═══ */
function addTip(sel) {
  let tip = document.getElementById("d3tip");
  if (!tip) { tip = document.createElement("div"); tip.id="d3tip"; tip.className="d3-tip"; document.body.appendChild(tip); }
  sel.on("mousemove", (ev,d) => {
    tip.style.display = "block";
    tip.style.left = (ev.pageX+12)+"px";
    tip.style.top = (ev.pageY-10)+"px";
    tip.innerHTML = d.tip;
  }).on("mouseleave", () => { tip.style.display = "none"; });
}

function chartHBar(containerId, labels, values, colorFn) {
  const el = document.getElementById(containerId);
  if (!el || !values.length) return;
  const W = el.clientWidth || 400, rowH = 26, H = values.length*rowH+20;
  const padL = Math.min(90, W*0.2), padR = 55;
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const max = d3.max(values)||1;
  const x = d3.scaleLinear().domain([0,max]).range([padL, W-padR]);
  const y = d3.scaleBand().domain(labels.map(String)).range([0,H-10]).padding(0.25);
  const g = svg.append("g");

  const bars = g.selectAll("rect").data(values.map((v,i)=>({v,l:labels[i],i}))).join("rect")
    .attr("x", padL).attr("y", d=>y(String(d.l))).attr("height", y.bandwidth())
    .attr("width", 0).attr("fill", d=>colorFn(d.v,d.i)).attr("rx",3).attr("opacity",0.85);
  bars.transition().duration(600).attr("width", d=>Math.max(2,x(d.v)-padL));

  g.selectAll("text.v").data(values.map((v,i)=>({v,l:labels[i]}))).join("text")
    .attr("class","v").attr("x", d=>x(d.v)+5).attr("y", d=>y(String(d.l))+y.bandwidth()/2+4)
    .attr("font-size","10").attr("fill","#8b9cb5").attr("font-family","var(--mono)").text(d=>d.v);

  g.selectAll("text.l").data(values.map((v,i)=>({v,l:labels[i]}))).join("text")
    .attr("class","l").attr("x", padL-6).attr("y", d=>y(String(d.l))+y.bandwidth()/2+4)
    .attr("text-anchor","end").attr("font-size","10").attr("fill","#6b7f9e")
    .attr("font-family","var(--mono)").text(d=>String(d.l||"").slice(0,12));

  addTip(bars.append("title").text(d=>d.l+": "+d.v));
  /* simple tooltip via title already; add interactive */
  bars.on("mousemove", function(ev,d) {
    let tip = document.getElementById("d3tip");
    if (!tip) { tip = document.createElement("div"); tip.id="d3tip"; tip.className="d3-tip"; document.body.appendChild(tip); }
    tip.style.display="block"; tip.style.left=(ev.pageX+12)+"px"; tip.style.top=(ev.pageY-10)+"px";
    tip.innerHTML = '<div class="dt-l">'+esc(d.l)+'</div><div class="dt-v">'+d.v+'</div>';
  }).on("mouseleave", ()=>{const t=document.getElementById("d3tip"); if(t)t.style.display="none";});
}


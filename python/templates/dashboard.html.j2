function chartDonut(containerId, labels, values) {
  const el = document.getElementById(containerId);
  if (!el || !values.length) return;
  const W = el.clientWidth||400, H = 250;
  const r = Math.min(W,H)/2 - 20, ir = r*0.55;
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const total = d3.sum(values)||1;
  const g = svg.append("g").attr("transform",`translate(${W/2},${H/2})`);
  const pie = d3.pie().value(d=>d).sort(null);
  const arc = d3.arc().innerRadius(ir).outerRadius(r);
  const arcs = pie(values);

  const slices = g.selectAll("path").data(arcs).join("path")
    .attr("fill",(d,i)=>PAL[i%PAL.length])
    .attr("opacity",0.85)
    .attr("d",arc);
  slices.transition().duration(700).attrTween("d", function(d) {
    const i = d3.interpolate({startAngle:d.startAngle, endAngle:d.startAngle}, d);
    return t => arc(i(t));
  });

  /* center */
  g.append("text").attr("text-anchor","middle").attr("y",2)
    .attr("font-size","16").attr("font-weight","700").attr("fill","#f1f5f9")
    .attr("font-family","var(--mono)").text(total);
  g.append("text").attr("text-anchor","middle").attr("y",18)
    .attr("font-size","9").attr("fill","#64748b").text("total");

  /* labels */
  const lg = svg.append("g");
  labels.forEach((l,i)=>{
    const pct = Math.round(values[i]/total*100);
    lg.append("circle").attr("cx",10).attr("cy",H/2-labels.length*9+i*18+4)
      .attr("r",4).attr("fill",PAL[i%PAL.length]);
    lg.append("text").attr("x",20).attr("y",H/2-labels.length*9+i*18+8)
      .attr("font-size","10").attr("fill","#94a3b8").attr("font-family","var(--mono)")
      .text(String(l).slice(0,14)+" "+pct+"% ("+values[i]+")");
  });

  /* tooltip */
  slices.on("mousemove", function(ev,d) {
    let tip = document.getElementById("d3tip");
    if (!tip) { tip = document.createElement("div"); tip.id="d3tip"; tip.className="d3-tip"; document.body.appendChild(tip); }
    tip.style.display="block"; tip.style.left=(ev.pageX+12)+"px"; tip.style.top=(ev.pageY-10)+"px";
    const li = arcs.indexOf(d);
    tip.innerHTML = '<div class="dt-l">'+esc(labels[li]||"")+'</div><div class="dt-v">'+values[li]+' ('+Math.round(d.value/total*100)+'%)</div>';
  }).on("mouseleave", ()=>{const t=document.getElementById("d3tip"); if(t)t.style.display="none";})
    .on("mouseover", function(){d3.select(this).attr("opacity",1);})
    .on("mouseout", function(){d3.select(this).attr("opacity",0.85);});
}

function chartLine(containerId, labels, values, color) {
  const el = document.getElementById(containerId);
  if (!el || !values.length) return;
  const W = el.clientWidth||400, H = 250;
  const pad = {t:15,r:15,b:30,l:45};
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const max = (d3.max(values)||1)*1.15;
  const x = d3.scalePoint().domain(labels.map(String)).range([pad.l, W-pad.r]);
  const y = d3.scaleLinear().domain([0,max]).range([H-pad.b, pad.t]);
  const g = svg.append("g");

  /* grid */
  g.selectAll("line.g").data(y.ticks(5)).join("line").attr("class","g")
    .attr("x1",pad.l).attr("x2",W-pad.r).attr("y1",d=>y(d)).attr("y2",d=>y(d))
    .attr("stroke","currentColor").attr("opacity",0.06);

  /* area */
  const areaGen = d3.area().x((d,i)=>x(String(labels[i]))).y0(H-pad.b).y1(d=>y(d)).curve(d3.curveMonotoneX);
  g.append("path").datum(values).attr("fill",color).attr("opacity",0.12).attr("d",areaGen);

  /* line */
  const lineGen = d3.line().x((d,i)=>x(String(labels[i]))).y(d=>y(d)).curve(d3.curveMonotoneX);
  const path = g.append("path").datum(values).attr("fill","none")
    .attr("stroke",color).attr("stroke-width",2).attr("d",lineGen);
  const totalLen = (typeof path.node().getTotalLength === "function") ? path.node().getTotalLength() : 0;
  if (totalLen) {
    path.attr("stroke-dasharray", totalLen).attr("stroke-dashoffset", totalLen)
        .transition().duration(800).attr("stroke-dashoffset", 0);
  }

  /* dots */
  const dots = g.selectAll("circle.d").data(values.map((v,i)=>({v,l:labels[i],i}))).join("circle")
    .attr("class","d").attr("cx",d=>x(String(d.l))).attr("cy",d=>y(d.v)).attr("r",4)
    .attr("fill",color).attr("stroke","#06090e").attr("stroke-width",1.5);

  /* x labels */
  const step = Math.max(1, Math.ceil(labels.length/8));
  g.selectAll("text.xl").data(labels.filter((l,i)=>i%step===0)).join("text")
    .attr("class","xl").attr("x",d=>x(String(d))).attr("y",H-pad.b+14)
    .attr("text-anchor","middle").attr("font-size","9").attr("fill","#64748b")
    .attr("font-family","var(--mono)").text(d=>String(d).slice(0,6));

  /* y axis */
  g.selectAll("text.yl").data(y.ticks(5)).join("text").attr("class","yl")
    .attr("x",pad.l-7).attr("y",d=>y(d)+3).attr("text-anchor","end")
    .attr("font-size","9").attr("fill","#64748b").attr("font-family","var(--mono)")
    .text(d=>d.toFixed(1));

  /* threshold line for entropy */
  if (containerId==="chEntropy") {
    const ty = y(7.2);
    if (ty>0 && ty<H) {
      g.append("line").attr("x1",pad.l).attr("x2",W-pad.r).attr("y1",ty).attr("y2",ty)
        .attr("stroke","#f43f5e").attr("stroke-dasharray","4,4").attr("opacity",0.5);
      g.append("text").attr("x",W-pad.r).attr("y",ty-4).attr("text-anchor","end")
        .attr("font-size","9").attr("fill","#f43f5e").text("threshold 7.2");
    }
  }

  /* tooltip */
  dots.on("mousemove", function(ev,d) {
    let tip = document.getElementById("d3tip");
    if (!tip) { tip = document.createElement("div"); tip.id="d3tip"; tip.className="d3-tip"; document.body.appendChild(tip); }
    tip.style.display="block"; tip.style.left=(ev.pageX+12)+"px"; tip.style.top=(ev.pageY-10)+"px";
    tip.innerHTML = '<div class="dt-l">'+esc(String(d.l))+'</div><div class="dt-v">'+d.v+'</div>';
    d3.select(this).attr("r",6);
  }).on("mouseleave", function(){
    const t=document.getElementById("d3tip"); if(t)t.style.display="none";
    d3.select(this).attr("r",4);
  });
}

function chartGauge(containerId, score) {
  const el = document.getElementById(containerId);
  if (!el) return;
  const W = el.clientWidth||400, H = 140;
  const cx = W/2, cy = H-10, r = Math.min(cx-30, cy-10);
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const g = svg.append("g");
  const startA = -Math.PI, endA = 0;

  /* background arc */
  const bgArc = d3.arc().innerRadius(r-18).outerRadius(r).startAngle(startA).endAngle(endA);
  g.append("path").attr("d", bgArc).attr("fill","currentColor").attr("opacity",0.06);

  /* colored segments */
  const segs = [
    {label:"Clean", color:"#10b981", from:0, to:25},
    {label:"Suspicious", color:"#fbbf24", from:25, to:60},
    {label:"Malicious", color:"#f43f5e", from:60, to:100},
  ];
  segs.forEach(s => {
    const a1 = startA + (s.from/100)*(endA-startA);
    const a2 = startA + (s.to/100)*(endA-startA);
    const arc = d3.arc().innerRadius(r-18).outerRadius(r).startAngle(a1).endAngle(a2);
    g.append("path").attr("d", arc).attr("fill", s.color).attr("opacity", 0.35);
  });

  /* score arc */
  const scoreA = startA + (score/100)*(endA-startA);
  const scoreArc = d3.arc().innerRadius(r-18).outerRadius(r).startAngle(startA).endAngle(scoreA);
  const color = score>=60?"#f43f5e":score>=25?"#fbbf24":"#10b981";
  g.append("path").attr("d", scoreArc).attr("fill", color).attr("opacity",0.9)
    .transition().duration(1000).attrTween("opacity", ()=>d3.interpolate(0.5,0.9));

  /* needle */
  const needleAngle = startA + (score/100)*(endA-startA);
  const nx = cx + Math.cos(needleAngle)*(r-22), ny = cy + Math.sin(needleAngle)*(r-22);
  g.append("line").attr("x1",cx).attr("y1",cy).attr("x2",nx).attr("y2",ny)
    .attr("stroke","#f1f5f9").attr("stroke-width",2).attr("stroke-linecap","round");
  g.append("circle").attr("cx",cx).attr("cy",cy).attr("r",5).attr("fill","#f1f5f9");

  /* score text */
  g.append("text").attr("x",cx).attr("y",cy-30).attr("text-anchor","middle")
    .attr("font-size","28").attr("font-weight","800").attr("fill",color)
    .attr("font-family","var(--mono)").text(score);
  g.append("text").attr("x",cx).attr("y",cy-14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#64748b").attr("letter-spacing","1.5")
    .text("THREAT SCORE");

  /* labels */
  g.append("text").attr("x",cx-r).attr("y",cy+14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#10b981").text("0");
  g.append("text").attr("x",cx+r).attr("y",cy+14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#f43f5e").text("100");
}

/* ═══ ML section: probability gauge + SHAP contribution bars ═══ */
function chartProbGauge(containerId, prob, threshold) {
  const el = document.getElementById(containerId);
  if (!el) return;
  const W = el.clientWidth||400, H = 150;
  const cx = W/2, cy = H-16, r = Math.min(cx-34, cy-14), ir = r-18;
  const p = Math.max(0, Math.min(1, +prob||0));
  const thr = Math.max(0, Math.min(1, +threshold||0));
  /* d3.arc measures from 12 o'clock clockwise, so -PI/2..PI/2 is the top half;
     the needle uses the same half via math angles (PI..2PI sweeps left -> up -> right). */
  const arcAt = t => -Math.PI/2 + Math.max(0, Math.min(1, t))*Math.PI;
  const needleAt = t => Math.PI + Math.max(0, Math.min(1, t))*Math.PI;
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const g = svg.append("g");
  const band = (t0,t1,color,op) => g.append("path")
    .attr("d", d3.arc().innerRadius(ir).outerRadius(r).startAngle(arcAt(t0)).endAngle(arcAt(t1)))
    .attr("fill",color).attr("opacity",op);

  band(0, 1, "currentColor", 0.06);
  band(0, thr, "#10b981", 0.3);
  band(thr, 1, "#f43f5e", 0.3);
  band(0, p, p>=thr ? "#f43f5e" : "#10b981", 0.9);

  /* threshold tick */
  const ta = needleAt(thr);
  g.append("line")
    .attr("x1", cx+Math.cos(ta)*(ir-4)).attr("y1", cy+Math.sin(ta)*(ir-4))
    .attr("x2", cx+Math.cos(ta)*(r+5)).attr("y2", cy+Math.sin(ta)*(r+5))
    .attr("stroke","#fbbf24").attr("stroke-width",2).attr("stroke-linecap","round");

  /* needle */
  const na = needleAt(p);
  g.append("line").attr("x1",cx).attr("y1",cy)
    .attr("x2", cx+Math.cos(na)*(ir-6)).attr("y2", cy+Math.sin(na)*(ir-6))
    .attr("stroke","#f1f5f9").attr("stroke-width",2).attr("stroke-linecap","round");
  g.append("circle").attr("cx",cx).attr("cy",cy).attr("r",5).attr("fill","#f1f5f9");

  const color = p>=thr ? "#f43f5e" : "#10b981";
  g.append("text").attr("x",cx).attr("y",cy-34).attr("text-anchor","middle")
    .attr("font-size","26").attr("font-weight","800").attr("fill",color)
    .attr("font-family","var(--mono)").text(p.toFixed(4));
  g.append("text").attr("x",cx).attr("y",cy-17).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#64748b").attr("letter-spacing","1.5")
    .text("P(MALICIOUS)");
  g.append("text").attr("x",cx-r).attr("y",cy+14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#10b981").text("0");
  g.append("text").attr("x",cx+r).attr("y",cy+14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#f43f5e").text("1.0");
}

/* Signed SHAP bars: red towards malicious, green towards benign, zero line kept. */
function chartShapBars(containerId, labels, values, tips) {
  const el = document.getElementById(containerId);
  if (!el || !values.length) return;
  const W = el.clientWidth||400, rowH = 26, H = values.length*rowH+16;
  const padL = Math.min(220, Math.max(110, W*0.36)), padR = 62;
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const lo = Math.min(0, d3.min(values)), hi = Math.max(0, d3.max(values));
  const x = d3.scaleLinear().domain([lo===hi?0:lo, lo===hi?1:hi]).range([padL+6, W-padR]);
  /* index keys, not the labels: two features can share a name and scaleBand
     would silently collapse them into one row. */
  const keys = values.map((v,i)=>String(i));
  const y = d3.scaleBand().domain(keys).range([10, H-8]).padding(0.3);
  const data = values.map((v,i)=>({v, l:String(labels[i]||""), k:String(i),
                                   tip:String((tips&&tips[i])||labels[i]||"")}));
  const g = svg.append("g");

  g.append("line").attr("x1",x(0)).attr("x2",x(0)).attr("y1",6).attr("y2",H-6)
    .attr("stroke","currentColor").attr("opacity",0.25);

  const bars = g.selectAll("rect.s").data(data).join("rect").attr("class","s")
    .attr("y",d=>y(d.k)).attr("height",y.bandwidth())
    .attr("x",x(0)).attr("width",0).attr("rx",3)
    .attr("fill",d=>d.v>=0?"#f43f5e":"#10b981").attr("opacity",0.85);
  bars.transition().duration(600).delay((d,i)=>i*40)
    .attr("x",d=>Math.min(x(0),x(d.v)))
    .attr("width",d=>Math.max(2,Math.abs(x(d.v)-x(0))));

  g.selectAll("text.v").data(data).join("text").attr("class","v")
    .attr("y",d=>y(d.k)+y.bandwidth()/2+4)
    .attr("x",d=>d.v>=0?x(d.v)+5:x(d.v)-5)
    .attr("text-anchor",d=>d.v>=0?"start":"end")
    .attr("font-size","10").attr("fill","#94a3b8").attr("font-family","var(--mono)")
    .text(d=>d.v.toFixed(3));

  g.selectAll("text.l").data(data).join("text").attr("class","l")
    .attr("x",padL-8).attr("y",d=>y(d.k)+y.bandwidth()/2+4)
    .attr("text-anchor","end").attr("font-size","10").attr("fill","#64748b")
    .attr("font-family","var(--mono)").text(d=>d.l.slice(0,34));

  bars.on("mousemove", function(ev,d) {
    let tip = document.getElementById("d3tip");
    if (!tip) { tip = document.createElement("div"); tip.id="d3tip"; tip.className="d3-tip"; document.body.appendChild(tip); }
    tip.style.display="block"; tip.style.left=(ev.pageX+12)+"px"; tip.style.top=(ev.pageY-10)+"px";
    tip.innerHTML = '<div class="dt-l">'+esc(d.tip)+'</div><div class="dt-v">'+d.v.toFixed(4)+'</div>';
  }).on("mouseleave", ()=>{const t=document.getElementById("d3tip"); if(t)t.style.display="none";});
}

function drawML() {
  if (!HAS_D3) return;
  const ml = DATA.ml || {};
  const expl = ml.explanation || {};
  const rollup = expl.group_rollup || [];
  const tops = expl.top_features || [];
  /* Same palette as the Jinja card above: one band, one colour, everywhere. */
  const LEVEL_COLOR = {low:"#10b981", moderate:"#fbbf24", high:"#f43f5e",
                       critical:"#f43f5e", "n/a":"#64748b"};
  const stats = document.getElementById("mlStats");
  if (stats) {
    const cards = ml.ok ? [
      {v: ml.threat_level || "—", l: "threat level", c: LEVEL_COLOR[ml.threat_level]},
      {v: ml.verdict || "—", l: "verdict"},
      {v: (typeof ml.malicious_probability === "number") ? ml.malicious_probability.toFixed(4) : "—",
       l: "P(malicious)"},
      {v: (typeof ml.threshold_margin === "number")
            ? (ml.threshold_margin >= 0 ? "+" : "") + ml.threshold_margin.toFixed(4)
            : "—", l: "vs threshold"},
      {v: (ml.threshold === undefined || ml.threshold === null) ? "—" : ml.threshold, l: "threshold"},
      {v: ml.trees || 0, l: "trees"},
      {v: ml.features || 0, l: "features"},
      {v: rollup.length, l: "SHAP groups"},
      {v: tops.length, l: "top features"},
      {v: Math.round((ml.bytes||0)/1024) + " KB", l: "scored"},
    ] : [
      {v: ml.error ? "error" : "skipped", l: "ML status"},
      {v: "—", l: "P(malicious)"},
    ];
    stats.innerHTML = cards.map(c =>
      '<div class="stat-card"><div class="sv"' +
      (c.c ? ' style="color:' + c.c + '"' : "") + ">" + c.v +
      '</div><div class="sl">' + c.l + "</div></div>").join("");
  }
  if (!ml.ok) return;

  chartProbGauge("mlGauge", ml.malicious_probability || 0, ml.threshold || 0);
  if (rollup.length)
    chartShapBars("mlGroups", rollup.map(x=>x.group), rollup.map(x=>+x.shap_log_odds||0),
                  rollup.map(x=>x.group + (x.analyzer_implemented ? " (in analyzer)" : "")));
  if (tops.length)
    chartShapBars("mlFeatures",
                  tops.map(x=>(x.label || x.evidence || x.group || "")),
                  tops.map(x=>+x.shap_log_odds||0),
                  tops.map(x=>"#" + (x.feature_index ?? "?") + " " + (x.group||"") + ": " +
                              (x.label || x.evidence || "") + (x.direction ? " · " + x.direction : "")));
}

function drawAllCharts() {
  if (!HAS_D3) return;
  const ch = DATA.charts || {};
  chartGauge("chGauge", DATA.verdict.score);
  if (ch.mnemonics && ch.mnemonics.labels.length)
    chartHBar("chMnemonics", ch.mnemonics.labels, ch.mnemonics.values, (v,i)=>PAL[i%PAL.length]);
  if (ch.opcodes && ch.opcodes.labels.length)
    chartHBar("chOpcodes", ch.opcodes.labels, ch.opcodes.values, (v,i)=>PAL[(i+4)%PAL.length]);
  if (ch.section_entropy && ch.section_entropy.values.length)
    chartLine("chEntropy", ch.section_entropy.labels, ch.section_entropy.values, "#06b6d4");
  if (ch.functions && ch.functions.labels.length)
    chartHBar("chFunctions", ch.functions.labels, ch.functions.values, ()=> "#34d399");
  if (ch.ioc_counts && ch.ioc_counts.labels.length)
    chartDonut("chIoc", ch.ioc_counts.labels, ch.ioc_counts.values);
  if (ch.capability_scope && ch.capability_scope.labels.length)
    chartDonut("chScope", ch.capability_scope.labels, ch.capability_scope.values);
  if (ch.imports_per_dll && ch.imports_per_dll.labels.length)
    chartHBar("chImports", ch.imports_per_dll.labels, ch.imports_per_dll.values, (v,i)=>i%2===0?"#38bdf8":"#06b6d4");
  if (ch.section_size && ch.section_size.values.length)
    chartVBar("chSize", ch.section_size.labels, ch.section_size.values, ()=> "#8b5cf6");

  const cs = document.getElementById("chartStats");
  if (cs) {
    const items = [
      {i:"\u{1F3AF}",v:DATA.verdict.score,l:"Score"},
      {i:"\u{1F524}",v:(ch.mnemonics&&ch.mnemonics.labels.length)||0,l:"Mnemonics"},
      {i:"\u{1F511}",v:(ch.opcodes&&ch.opcodes.labels.length)||0,l:"Bytes"},
      {i:"\u{1F4E6}",v:(ch.section_entropy&&ch.section_entropy.values.length)||0,l:"Sections"},
      {i:"\u{1F310}",v:(ch.ioc_counts&&ch.ioc_counts.labels.length)||0,l:"IOC Types"},
      {i:"\u{1F6E1}",v:(ch.capability_scope&&ch.capability_scope.labels.length)||0,l:"Scopes"},
      {i:"\u{1F4C8}",v:(ch.imports_per_dll&&ch.imports_per_dll.labels.length)||0,l:"DLLs"},
      {i:"\u{2699}",v:(ch.functions&&ch.functions.labels.length)||0,l:"Functions"},
    ];
    cs.innerHTML = items.map(x=>`<div class="stat-card"><div class="si">${x.i}</div><div class="sv">${x.v}</div><div class="sl">${x.l}</div></div>`).join("");
  }
}

/* ═══ ATT&CK / STIX section ═══ */
const SX_COLORS = {"attack-pattern":"#f59e0b","x-mitre-tactic":"#8b5cf6","course-of-action":"#10b981",
  "indicator":"#06b6d4","malware":"#f43f5e","tool":"#ec4899","vulnerability":"#fbbf24",
  "identity":"#38bdf8","intrusion-set":"#a855f7","report":"#64748b"};
const SX_R = {"attack-pattern":9,"x-mitre-tactic":12,"course-of-action":7,"indicator":8,
  "malware":9,"vulnerability":8,"identity":7};
const SX_NAME = {"attack-pattern":"Technique","x-mitre-tactic":"Tactic","course-of-action":"Mitigation",
  "indicator":"Indicator","malware":"Malware","tool":"Tool","vulnerability":"Vulnerability",
  "identity":"Identity","intrusion-set":"Intrusion Set","report":"Report"};
const sxColor = t => SX_COLORS[t] || "#64748b";
const sxR = t => SX_R[t] || 6;
const sxName = t => SX_NAME[t] || String(t).replace(/-/g," ");
/* Reuse the shared detail drawer; map a STIX type to one of its colour keys. */
const sxDetailType = t => t === "indicator" ? "ioc"
  : t === "malware" ? "malicious"
  : t === "attack-pattern" ? "capability" : "analysis";

let sxBuilt = false, sxSvgSel = null, sxZoom = null, sxNodeSel = null;
const sxActive = new Set();

function sxTacticName(short) {
  const hit = ((DATA.stix || {}).tactics || []).find(t => t.short === short);
  return hit ? hit.name : String(short || "").replace(/-/g, " ");
}

/* The opening of a long ATT&CK string, for a hover title.  <title> is plain
   text and the full paragraph is an unreadable wall, so this cuts at a sentence
   boundary when there is one near the limit. */
function sxSnippet(text, limit) {
  const s = String(text || "").replace(/\s+/g, " ").trim();
  if (s.length <= limit) return s;
  const cut = s.slice(0, limit);
  const stop = Math.max(cut.lastIndexOf(". "), cut.lastIndexOf("; "));
  return stop > limit * 0.5 ? cut.slice(0, stop + 1) : cut.replace(/\s+\S*$/, "") + "…";
}

/* Tactic labels carry their technique count: a bare "Execution" says nothing
   about how much of the sample sits under it. */
function sxNodeText(d) {
  let t = d.label || "";
  if (d.type === "x-mitre-tactic" && d.techniques > 0) t += " (" + d.techniques + ")";
  return t.slice(0, 30);
}

function sxShow(id) {
  const S = DATA.stix, node = (S.graph.nodes || []).find(n => n.id === id) || {};
  const body = (S.graph.details || {})[id] || {};
  const edges = S.graph.edges || [], allNodes = S.graph.nodes || [];
  const titleOf = oid => { const n = allNodes.find(x => x.id === oid); return n ? (n.label || n.id) : oid; };
  const refs = body.external_references || [];
  const ext = refs.find(r => r && r.source_name === "mitre-attack" && r.external_id)
           || refs.find(r => r && r.external_id);

  const tags = [];
  if (ext) tags.push(ext.external_id);
  (node.tactics || []).forEach(t => tags.push(sxTacticName(t)));
  if (node.tactic) tags.push(sxTacticName(node.tactic));
  (body.x_mitre_platforms || []).forEach(p => tags.push(p));
  if (body["x-synthesized"]) tags.push("inferred from " + body["x-synthesized"]);

  const row = (k, v) => '<div class="dt-kv"><span class="k">' + esc(k) + '</span><span class="v">' + v + '</span></div>';
  const para = (text, dim) => '<div style="font-size:14px;line-height:1.62;white-space:pre-wrap;' +
    (dim ? "color:var(--dim)" : "") + '">' + esc(text) + '</div>';

  let html = "";
  if (body.description) html += sect("Description") + para(body.description);
  if (body.x_mitre_detection) html += sect("Detection") + para(body.x_mitre_detection, true);

  const facts = [];
  if (ext && ext.url) facts.push(row("ATT&CK", '<a href="' + esc(ext.url) +
    '" target="_blank" rel="noopener" style="color:var(--accent);word-break:break-all">' +
    esc(ext.url) + '</a>'));
  if (body.pattern) facts.push(row("Pattern", esc(body.pattern)));
  if (body.confidence != null) facts.push(row("Confidence", esc(body.confidence)));
  if (body.identity_class) facts.push(row("Class", esc(body.identity_class)));
  if (node.type === "x-mitre-tactic") {
    const n = node.techniques || 0;
    facts.push(row("Techniques", esc(n) + " in this bundle"));
  }
  if (node.sub) facts.push(row("Ref", esc(node.sub)));
  facts.push(row("Object ID", esc(id)));
  html += sect("Details") + facts.join("");

  if ((body.x_mitre_mitigations || []).length) {
    html += sect("Mitigations") + body.x_mitre_mitigations
      .map(m => '<div class="dt-kv"><span class="v" style="text-align:left">' + esc(m) + '</span></div>')
      .join("");
  }
  if (tags.length) html += sect("Tags") + '<div class="dt-chips">' +
    tags.map(t => '<span class="dt-chip">' + esc(t) + '</span>').join("") + '</div>';

  const rels = edges.filter(e => e.source === id || e.target === id);
  html += sect("Relationships (" + rels.length + ")");
  if (!rels.length) {
    html += '<div class="dt-empty">Nothing in this bundle links to or from this object.</div>';
  }
  rels.slice(0, 60).forEach(e => {
    const out = e.source === id, other = out ? e.target : e.source;
    html += '<div class="dt-kv"><span class="k">' + (out ? "→ " : "← ") +
      esc(e.label || "related-to") + '</span><span class="v" data-goto="' + esc(other) +
      '" style="cursor:pointer;color:var(--accent)">' + esc(titleOf(other)) + '</span></div>';
  });
  if (rels.length > 60) html += '<div class="dt-empty">… ' + (rels.length - 60) + ' more</div>';

  html += sect("Raw STIX object") +
    '<pre style="white-space:pre-wrap;word-break:break-word;font-family:var(--mono);' +
    'font-size:12px;margin:0;color:var(--dim)">' + esc(JSON.stringify(body, null, 2)) + '</pre>';

  showDetail(node.label || id, {html: html},
             {type: sxDetailType(node.type), sub: id, connections: rels.length});
  document.querySelectorAll("#detailBody [data-goto]").forEach(el => {
    el.onclick = () => { if (el.dataset.goto) sxShow(el.dataset.goto); };
  });
}

function drawStix() {
  const S = DATA.stix;
  if (!S || !S.available || sxBuilt) return;
  sxBuilt = true;

  const st = S.graph.stats || {};
  const cards = [
    {v: st.objects || 0, l: "STIX Objects"},
    {v: st.techniques || 0, l: "Techniques"},
    {v: st.tactics || 0, l: "Tactics"},
    {v: st.edges || 0, l: "Edges"},
  ];
  document.getElementById("stixStats").innerHTML = cards
    .map(c => '<div class="stat-card"><div class="sv">' + c.v + '</div><div class="sl">' + c.l + "</div></div>")
    .join("");

  /* --- coverage matrix: tactics in kill-chain order --- */
  const techs = (S.layer && S.layer.techniques) || [];
  const byTactic = new Map(), unassigned = [];
  techs.forEach(t => {
    if (!t.tactic) { unassigned.push(t); return; }
    if (!byTactic.has(t.tactic)) byTactic.set(t.tactic, []);
    byTactic.get(t.tactic).push(t);
  });

  const mx = document.getElementById("stixMatrix");
  if (!techs.length) {
    mx.innerHTML = '<div class="dt-empty">No ATT&amp;CK techniques in this section.</div>';
  } else {
    let html = "";
    (S.tactics || []).forEach(t => {
      const list = byTactic.get(t.short) || [];
      html += '<div class="sx-tac"><h4>' + esc(t.name) + "<b>" + list.length + "</b></h4>";
      list.forEach(x => {
        html += '<button class="sx-tech" data-tid="' + esc(x.techniqueID) + '">' +
                "<code>" + esc(x.techniqueID) + "</code>" + esc(x.comment || "") + "</button>";
      });
      html += "</div>";
    });
    if (unassigned.length) {
      html += '<div class="sx-tac"><h4>Unassigned<b>' + unassigned.length + "</b></h4>";
      unassigned.forEach(x => {
        html += '<button class="sx-tech" data-tid="' + esc(x.techniqueID) + '">' +
                "<code>" + esc(x.techniqueID) + "</code>" + esc(x.comment || "") + "</button>";
      });
      html += "</div>";
    }
    mx.innerHTML = html;
    mx.querySelectorAll(".sx-tech").forEach(b => {
      b.onclick = () => {
        const hit = (S.graph.nodes || []).find(n => n.technique_id === b.dataset.tid);
        if (hit) sxShow(hit.id);
      };
    });
  }

  /* --- notes --- */
  const notes = [];
  if (S.source) notes.push("Source: " + S.source + ".");
  if (S.synthesized) notes.push("No STIX bundle was supplied for this run — the techniques capa matched were turned into STIX attack-pattern objects.");
  if (S.layer_note) notes.push(S.layer_note + ".");
  if (st.synthetic_tactics) notes.push(st.synthetic_tactics + " tactic node(s) inferred from kill_chain_phases.");
  if (st.dropped_edges) notes.push(st.dropped_edges + " relationship(s) dropped (endpoint not in the bundle).");
  if (st.truncated_nodes) notes.push(st.truncated_nodes + " object(s) beyond the display cap are not drawn.");
  const D0 = DATA.d3fend;
  if (D0 && !D0.available && D0.reason) notes.push("D3FEND: " + D0.reason + ".");
  document.getElementById("stixNote").textContent = notes.join(" ");

  /* --- sub-tabs: coverage | tactics | graph | d3fend --- */
  const elTactics = document.getElementById("stixTactics");
  const elD3fend = document.getElementById("stixD3fend");
  const showView = view => {
    document.getElementById("stixCoverage").style.display = view === "coverage" ? "" : "none";
    if (elTactics) elTactics.style.display = view === "tactics" ? "" : "none";
    document.getElementById("stixGraph").style.display = view === "graph" ? "" : "none";
    if (elD3fend) elD3fend.style.display = view === "d3fend" ? "" : "none";
    document.querySelectorAll("#stix .sxtab").forEach(b => b.classList.toggle("on", b.dataset.sview === view));
    if (view === "graph") sxDrawGraph();
    if (view === "d3fend") drawD3fend();
  };
  document.querySelectorAll("#stix .sxtab").forEach(b => {
    b.onclick = () => showView(b.dataset.sview || "coverage");
  });
  tkInit();

  document.getElementById("sxNav").onclick = () => {
    if (!S.layer || !S.layer.techniques) { alert("No ATT&CK techniques to export."); return; }
    const blob = new Blob([JSON.stringify(S.layer, null, 2)], {type: "application/json"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = ((DATA.meta && DATA.meta.stem) || "layer") + "_navigator.json";
    a.click();
    URL.revokeObjectURL(a.href);
  };

  document.getElementById("sxFullNav").onclick = () => {
    if (!S.full_layer || !S.full_layer.techniques) {
      alert("Full ATT&CK matrix not available. " + (S.full_layer_note || "MITRE ATT&CK cache not loaded."));
      return;
    }
    const blob = new Blob([JSON.stringify(S.full_layer, null, 2)], {type: "application/json"});
    const a = document.createElement("a");
    a.href = URL.createObjectURL(blob);
    a.download = "mitre_attack_enterprise_full_matrix.json";
    a.click();
    URL.revokeObjectURL(a.href);
  };
}

/* D3FEND countermeasures, grouped by the ATT&CK tactics capa recovered:
   tactic -> technique -> D3FEND chips (D3-FA File Analysis *analyzes* File).
   Built once on first open; DATA.d3fend is derived entirely from capa plus
   the d3fend cache, so it exists even for a run with no STIX bundle. */
function drawD3fend() {
  const D = DATA.d3fend;
  const box = document.getElementById("d3fList");
  if (!D || !box || box.dataset.built) return;
  box.dataset.built = "1";

  const t = D.totals || {};
  document.getElementById("d3fStats").innerHTML = [
    {v: t.countermeasures || 0, l: "D3FEND Techniques"},
    {v: t.covered || 0, l: "Techniques Covered"},
    {v: (D.tactics || []).length, l: "ATT&CK Tactics"},
  ].map(c => '<div class="stat-card"><div class="sv">' + c.v + '</div><div class="sl">' + c.l + "</div></div>")
   .join("");

  const list = document.getElementById("d3fList");
  if (!(D.tactics || []).length) {
    list.innerHTML = '<div class="dt-empty">No D3FEND countermeasures to show.</div>';
  } else {
    let html = "";
    D.tactics.forEach(g => {
      html += '<div class="sx-tac" style="margin-bottom:8px"><h4>' + esc(g.name) +
              "<b>" + g.techniques.length + "</b></h4>";
      g.techniques.forEach(x => {
        html += '<div class="d3f-tech"><h5><code>' + esc(x.id) + "</code>" +
                esc(x.name) + (x.sub ? " <span>: " + esc(x.sub) + "</span>" : "") + "</h5>";
        if (!x.defenses.length) {
          html += '<div class="d3f-none">no D3FEND mapping for this technique</div>';
        } else {
          html += x.defenses.map(d => {
            const via = d.via ? ' (via ' + esc(d.via) + ")" : "";
            const rel = (d.rel && d.art)
              ? ' <span class="d3f-rel"><em>' + esc(d.rel) + "</em> " + esc(d.art) + "</span>"
              : "";
            return '<span class="d3f-chip" title="' + esc((d.cat || "") + via) +
                   '"><b>' + esc(d.id) + "</b> " + esc(d.name) +
                   (d.cat ? "<i>" + esc(d.cat) + "</i>" : "") + rel + "</span>";
          }).join("");
        }
        html += "</div>";
      });
      html += "</div>";
    });
    list.innerHTML = html;
  }

  const notes = [];
  if (D.source) notes.push("Source: " + D.source + ".");
  if (D.reason) notes.push(D.reason + ".");
  notes.push("Countermeasures are matched from the D3FEND ontology to the techniques capa matched on this sample.");
  (document.getElementById("d3fNote") || {}).textContent = notes.join(" ");
}

/* ═══════════════════════════════════════════════════════════════════
   Procedures & Tooling: for each observed tactic, the techniques and
   the tooling / groups / detection guidance ATT&CK attaches to them.
   The facet chips are a union filter - turning on several narrows to
   rows matching ANY of them - because an analyst chasing one question
   ("which of these have tooling?") should not have to undo the chip
   they picked a moment earlier.
   ═══════════════════════════════════════════════════════════════════ */
function tkInit() {
  const M = (DATA.cti || {}).attack_matrix || {};
  const list = document.getElementById("tkList");
  if (!list || !M.available) return;

  const state = { q: "", facets: new Set(), tactic: "" };

  /* One lowercase blob per procedure so a search term only has to match once. */
  const index = M.tactics.map(t => ({
    tac: t,
    procs: t.procedures.map(p => {
      const detText = (p.detections || [])
        .map(d => d.name + " " + d.analytics.map(a => a.description).join(" ")).join(" ");
      const hay = [p.id, p.name, p.url, (p.platforms || []).join(" "),
                   (p.tools || []).map(x => x.name + " " + x.id).join(" "),
                   (p.malware || []).map(x => x.name + " " + x.id).join(" "),
                   (p.groups || []).map(x => x.name + " " + x.id).join(" "),
                   (p.subtechniques || []).join(" "), detText].join(" ").toLowerCase();
      return { p, hay };
    })
  }));

  const chips = document.getElementById("tkTacticChips");
  chips.innerHTML = M.tactics.map(t =>
    '<span class="tk-chip" data-tac="' + esc(t.short) + '">' + esc(t.name) + "</span>").join("");

  const passesFacet = p => {
    const f = state.facets;
    if (!f.size) return true;
    return [...f].some(k => {
      switch (k) {
        case "tools":   return (p.tools || []).length > 0;
        case "malware": return (p.malware || []).length > 0;
        case "groups":  return (p.groups || []).length > 0;
        case "detect":  return (p.detections || []).length > 0;
        case "sub":     return !!p.is_subtechnique;
        case "notool":  return (p.tools || []).length > 0 || (p.malware || []).length > 0;
        default:        return true;
      }
    });
  };

  const vals = (items, cls, total) => {
    if (!items.length) return "";
    const more = total > items.length
      ? ' <span class="tk-more">+' + (total - items.length) + " more</span>" : "";
    return '<span class="tk-vals">' +
      items.map(x => '<span class="tk-val ' + cls + '" title="' + esc(x.id || "") + '">' + esc(x.name) +
                     (x.id ? ' <span class="tk-val id">' + esc(x.id) + "</span>" : "") + "</span>").join("") +
      more + "</span>";
  };

  const renderProc = p => {
    let h = '<div class="tk-proc"><div class="tk-prochead">' +
            '<span class="tk-pid">' + esc(p.id) + "</span>" +
            '<span class="tk-pname">' + esc(p.name) + "</span>";
    if (p.is_subtechnique) h += '<span class="tk-sub">sub-technique</span>';
    if (p.hits > 1) h += '<span class="tk-hits">' + p.hits + " capa hits</span>";
    h += "</div>";

    if ((p.tools || []).length)
      h += '<div class="tk-row"><span class="tk-lbl tools">tools</span>' +
           vals(p.tools, "tools", p.tools_total) + "</div>";
    if ((p.malware || []).length)
      h += '<div class="tk-row"><span class="tk-lbl malware">malware</span>' +
           vals(p.malware, "malware", p.malware_total) + "</div>";
    if ((p.groups || []).length)
      h += '<div class="tk-row"><span class="tk-lbl groups">groups</span>' +
           vals(p.groups, "groups", p.groups_total) + "</div>";

    /* "Has tooling" is the most-asked question, so say it outright when the
       answer is no rather than leaving the row silently short. */
    if (!(p.tools || []).length && !(p.malware || []).length)
      h += '<div class="tk-row"><span class="tk-lbl tools">tooling</span>' +
           '<span class="tk-none">no known tooling in ATT&amp;CK for this technique</span></div>';

    (p.detections || []).forEach(d => {
      (d.analytics || []).forEach(a => {
        h += '<div class="tk-row"><span class="tk-lbl detect">detect</span><span class="tk-det">' +
             (d.name ? '<span class="tk-detname">' + esc(d.name) + "</span>" : "") +
             esc(a.description) + "</span></div>";
      });
    });
    if ((p.detections_total || 0) > (p.detections || []).length)
      h += '<div class="tk-row"><span class="tk-lbl detect"></span><span class="tk-more">+' +
           (p.detections_total - p.detections.length) +
           " more detection strategy(ies) in exports/cti</span></div>";

    if ((p.subtechniques || []).length)
      h += '<div class="tk-row"><span class="tk-lbl">children</span><span class="tk-vals">' +
           p.subtechniques.map(s => '<span class="tk-val">' + esc(s) + "</span>").join("") + "</span></div>";
    if (p.mitigations)
      h += '<div class="tk-row"><span class="tk-lbl">mitigate</span><span class="tk-vals">' +
           '<span class="tk-val">' + p.mitigations + " mitigation(s)</span></span></div>";

    return h + "</div>";
  };

  const render = () => {
    let shownT = 0, shownP = 0, html = "";
    index.forEach(({ tac, procs }) => {
      if (state.tactic && tac.short !== state.tactic) return;
      const hits = procs.filter(x => passesFacet(x.p) &&
                                    (!state.q || x.hay.indexOf(state.q) !== -1));
      if (!hits.length) return;
      shownT++; shownP += hits.length;
      const nTools = hits.filter(x => (x.p.tools || []).length || (x.p.malware || []).length).length;
      html += '<div class="tk-tac' + (shownT === 1 ? " open" : "") + '">' +
              '<div class="tk-tachead"><span class="tk-caret">▶</span>' +
              '<span class="tk-tacname">' + esc(tac.name) + "</span>" +
              '<span class="tk-tacmeta">' + hits.length + " technique(s) · " +
              (nTools ? nTools + " with tooling" : "no tooling") + "</span></div>" +
              '<div class="tk-tacbody">' + hits.map(x => renderProc(x.p)).join("") + "</div></div>";
    });
    if (!html) html = '<div class="tk-empty">No procedure matches these filters.</div>';
    list.innerHTML = html;

    const t = M.totals || {};
    document.getElementById("tkCount").textContent =
      shownP + " of " + (t.procedures || 0) + " procedures · " + shownT + " tactic(s) · " +
      (t.tools || 0) + " tools · " + (t.detections || 0) + " with detection guidance";

    list.querySelectorAll(".tk-tachead").forEach(hd => {
      hd.onclick = () => hd.parentElement.classList.toggle("open");
    });
  };

  document.getElementById("tkSearch").oninput = e => { state.q = e.target.value.trim().toLowerCase(); render(); };
  document.querySelectorAll("[data-facet]").forEach(c => {
    c.onclick = () => {
      const k = c.dataset.facet;
      if (k === "all") state.facets.clear();
      else state.facets.has(k) ? state.facets.delete(k) : state.facets.add(k);
      document.querySelectorAll("[data-facet]").forEach(o =>
        o.classList.toggle("on", k === "all" ? state.facets.size === 0 : state.facets.has(o.dataset.facet)));
      render();
    };
  });
  chips.querySelectorAll(".tk-chip").forEach(c => {
    c.onclick = () => {
      const t = c.dataset.tac;
      state.tactic = (state.tactic === t) ? "" : t;
      chips.querySelectorAll(".tk-chip").forEach(o => o.classList.toggle("on", o.dataset.tac === state.tactic));
      render();
    };
  });
  document.getElementById("tkReset").onclick = () => {
    state.q = ""; state.facets.clear(); state.tactic = "";
    document.getElementById("tkSearch").value = "";
    document.querySelectorAll("[data-facet]").forEach(o => o.classList.toggle("on", o.dataset.facet === "all"));
    chips.querySelectorAll(".tk-chip").forEach(o => o.classList.remove("on"));
    render();
  };

  render();
}

function sxDrawGraph() {
  if (!HAS_D3) return;
  const S = DATA.stix;
  if (sxSvgSel || !S || !S.available) return;
  const el = document.getElementById("stixSvg");
  if (!el) return;

  const svg = d3.select(el);
  const W = el.clientWidth || 1000, H = 620;
  svg.attr("viewBox", "0 0 " + W + " " + H);

  const defs = svg.append("defs");
  defs.append("marker").attr("id","sxArrow").attr("viewBox","0 -5 10 10").attr("refX",17)
    .attr("refY",0).attr("markerWidth",5).attr("markerHeight",5).attr("orient","auto")
    .append("path").attr("d","M0,-5L10,0L0,5").attr("fill","#1c2b45");

  sxZoom = d3.zoom().scaleExtent([0.15,4]).on("zoom", ev => g.attr("transform", ev.transform));
  svg.call(sxZoom);
  const g = svg.append("g");

  const nodes = (S.graph.nodes || []).map(n => Object.assign({}, n));
  const links = (S.graph.edges || []).map(e => Object.assign({}, e));

  const link = g.append("g").selectAll("line").data(links).join("line")
    .attr("class", "sx-link").attr("marker-end", "url(#sxArrow)");

  /* The relationship type is the point of the edge: on the edge when the
     graph is small enough to read, in a tooltip always. */
  const sxTitleOf = oid => { const n = nodes.find(x => x.id === oid); return n ? (n.label || n.id) : oid; };
  link.append("title").text(e => (e.label || "related-to") + "\n" +
    sxTitleOf(e.source) + " → " + sxTitleOf(e.target));
  const showLinkLabels = links.length > 0 && links.length <= 40;
  const linkLabel = g.append("g").selectAll("text").data(showLinkLabels ? links : [])
    .join("text").attr("class", "sx-linklabel")
    .text(e => (e.label || "").replace(/-/g, " "));

  const node = g.append("g").selectAll("g").data(nodes).join("g").attr("class", "sx-node");
  node.append("circle").attr("r", d => sxR(d.type)).attr("fill", d => sxColor(d.type))
    .on("click", (ev, d) => sxShow(d.id));
  node.append("text").attr("x", d => sxR(d.type) + 4).attr("y", 3.5)
    .text(sxNodeText);
  /* Hover carries what the node is, not only what it is called: the technique
     ID, the tactic's technique count, its tactics, and the opening of the prose
     the detail panel gives in full. */
  node.append("title").text(d => {
    const body = (S.graph.details || {})[d.id] || {};
    const bits = [d.technique_id ? d.technique_id + " · " + (d.label || d.id)
                                 : (d.label || d.id)];
    if (d.type === "x-mitre-tactic") {
      const n = d.techniques || 0;
      bits.push(n + " technique" + (n === 1 ? "" : "s") + " in this bundle");
    }
    if ((d.tactics || []).length) bits.push("Tactics: " + d.tactics.map(sxTacticName).join(", "));
    if (body.description) bits.push("", sxSnippet(body.description, 320));
    return bits.join("\n");
  });

  node.call(d3.drag()
    .on("start", (ev, d) => { if (!ev.active) sim.alphaTarget(0.28).restart(); d.fx = d.x; d.fy = d.y; })
    .on("drag", (ev, d) => { d.fx = ev.x; d.fy = ev.y; })
    .on("end", (ev, d) => { if (!ev.active) sim.alphaTarget(0); d.fx = null; d.fy = null; }));

  const sim = d3.forceSimulation(nodes)
    .force("link", d3.forceLink(links).id(d => d.id).distance(112).strength(0.45))
    .force("charge", d3.forceManyBody().strength(-460))
    .force("center", d3.forceCenter(W/2, H/2))
    .force("collide", d3.forceCollide(d => sxR(d.type) + 26))
    .on("tick", () => {
      link.attr("x1", d => d.source.x).attr("y1", d => d.source.y)
          .attr("x2", d => d.target.x).attr("y2", d => d.target.y);
      linkLabel.attr("x", d => (d.source.x + d.target.x) / 2)
               .attr("y", d => (d.source.y + d.target.y) / 2 - 3);
      node.attr("transform", d => "translate(" + d.x + "," + d.y + ")");
    });

  /* type filters + legend */
  const types = Array.from(new Set(nodes.map(n => n.type))).sort();
  const wrap = document.getElementById("sxTypes");
  const leg = document.getElementById("stixLegend");
  types.forEach(t => {
    sxActive.add(t);
    const b = document.createElement("button");
    b.className = "fbtn active";
    b.textContent = sxName(t) + " (" + nodes.filter(n => n.type === t).length + ")";
    b.onclick = () => {
      if (sxActive.has(t)) { sxActive.delete(t); b.classList.remove("active"); }
      else { sxActive.add(t); b.classList.add("active"); }
      sxFilter();
    };
    wrap.appendChild(b);
    const li = document.createElement("div");
    li.className = "li";
    li.innerHTML = '<span class="ld" style="background:' + sxColor(t) + '"></span>' + esc(sxName(t));
    leg.appendChild(li);
  });

  document.getElementById("sxSearch").addEventListener("input", sxFilter);
  document.getElementById("sxFit").onclick = () =>
    svg.transition().duration(260).call(sxZoom.transform, d3.zoomIdentity);

  sxSvgSel = svg; sxNodeSel = node;
}

function sxFilter() {
  if (!sxNodeSel) return;
  const q = (document.getElementById("sxSearch").value || "").trim().toLowerCase();
  sxNodeSel.classed("dim", d => {
    if (!sxActive.has(d.type)) return true;
    if (!q) return false;
    return (d.label + " " + (d.technique_id || "") + " " + (d.sub || "")).toLowerCase().indexOf(q) === -1;
  }).classed("hit", d => {
    if (!q || !sxActive.has(d.type)) return false;
    return (d.label + " " + (d.technique_id || "") + " " + (d.sub || "")).toLowerCase().indexOf(q) !== -1;
  });
}

/* init charts when analytics first shown (already handled by nav onclick) */

/* ───────────────────────── added on top of the restored renderers ─────────
   The sections above are covered by the renderers restored with this redesign.
   Three pieces have no renderer because they were introduced with it: the CAR
   filter, the live IOC filter/copy wiring, and the copied-state styling hook. */

/* ---- CAR: filter the analytics list by technique, id, title or analytic type */
(function () {
  const q = document.getElementById("carSearch");
  const wrap = document.getElementById("carTableWrap");
  if (!q || !wrap) return;
  const rows = Array.from(wrap.querySelectorAll(".car-row"));
  const count = document.getElementById("carCount");
  q.oninput = () => {
    const s = q.value.trim().toLowerCase();
    let shown = 0;
    rows.forEach(r => {
      const on = !s || (r.dataset.key || "").indexOf(s) !== -1;
      r.style.display = on ? "" : "none";
      if (on) shown++;
    });
    if (count) count.textContent = s ? shown + " / " + rows.length : String(rows.length);
  };
})();

/* ---- IOCs: live filter across kinds, copy what survived it ----
   Family clues and string indicators render as .fam-row rather than .ioc-row,
   so both selectors have to be in the set or those rows ignore the filter
   while the kind chips still claim to cover them. */
(function () {
  const box = document.getElementById("iocSearch");
  if (!box) return;
  const rows = Array.from(document.querySelectorAll("#iocs .ioc-row, #iocs .fam-row[data-kind]"));
  const cards = Array.from(document.querySelectorAll("[data-ioc-card]"));
  const chips = Array.from(document.querySelectorAll(".ioc-kind-chip"));
  const stats = Array.from(document.querySelectorAll("#iocs .stat-card"));
  const grand = stats.length ? stats[0].querySelector(".sv") : null;
  let kind = "all";

  const apply = () => {
    const q = box.value.trim().toLowerCase();
    let shown = 0;
    const liveIn = new Map();
    rows.forEach(r => {
      const okKind = kind === "all" || r.dataset.kind === kind;
      const okText = !q || (r.dataset.key || "").indexOf(q) !== -1;
      const on = okKind && okText;
      r.style.display = on ? "" : "none";
      if (on) {
        shown++;
        const card = r.closest("[data-ioc-card]");
        if (card) liveIn.set(card.dataset.iocCard, (liveIn.get(card.dataset.iocCard) || 0) + 1);
      }
    });
    /* A card whose every row just went invisible leaves only a bare heading,
       which reads as "the filter did nothing" - so the card goes too. */
    cards.forEach(c => {
      const k = c.dataset.iocCard;
      c.style.display = liveIn.has(k) ? "" : "none";
    });
    if (grand) grand.textContent = String(shown);
    chips.forEach(c => {
      const k = c.dataset.kind;
      const on = k === kind;
      c.classList.toggle("active", on);
      c.classList.toggle("on", on);
    });
  };

  box.oninput = apply;
  chips.forEach(c => {
    c.onclick = () => { kind = c.dataset.kind || "all"; apply(); };
  });

  const reset = document.getElementById("iocReset");
  if (reset) reset.onclick = () => {
    box.value = ""; kind = "all"; apply();
    box.focus();
  };

  const copyAll = document.getElementById("iocCopyAll");
  if (copyAll) copyAll.onclick = () => {
    const vals = rows.filter(r => r.style.display !== "none")
      .map(r => (r.querySelector(".ioc-val") || r).textContent || "")
      .map(t => t.trim()).filter(Boolean);
    if (!vals.length) return;
    navigator.clipboard.writeText(vals.join("\n")).then(() => {
      copyAll.textContent = "Copied " + vals.length;
      setTimeout(() => { copyAll.textContent = "Copy Visible"; }, 1500);
    });
  };

  apply();
})();

/* ---- Tooling: what actually ran for this sample, and what it found.
   #toolStats was an empty div even before the redesign - nothing ever filled
   it - so it states the run's tool coverage rather than staying blank. */
(function () {
  const el = document.getElementById("toolStats");
  if (!el) return;
  const die = DATA.die || {};
  const yara = (DATA.extraction || {}).yara || {};
  const cm = (DATA.extraction || {}).cminer || {};
  const xxd = (DATA.extraction || {}).xxd || {};
  const r2 = (DATA.radare2 || {}).counts || {};
  const capa = (DATA.capa || {}).counts || {};
  const ml = DATA.ml || {};

  const ran = (cond, label, value, colour) =>
    ({ ok: !!cond, label: label, value: value, colour: colour });

  const cards = [
    ran(die.available, "Detect It Easy", die.available ? (die.packed ? "packed" : "not packed") : "not run",
        die.packed ? "var(--status-malicious)" : (die.available ? "var(--status-clean)" : null)),
    ran(yara.available && yara.attempted, "YARA",
        yara.available ? ((yara.rules_matched || 0) + " rule match(es)") : "not run",
        yara.rules_matched ? "var(--status-suspicious)" : (yara.available ? "var(--status-clean)" : null)),
    ran(cm.available && cm.applicable, "Cminer",
        cm.available ? ((cm.cave_count || 0) + " cave(s)") : "not run",
        cm.cave_count ? "var(--status-suspicious)" : (cm.available ? "var(--status-clean)" : null)),
    ran(xxd.output, "xxd", (xxd.output_full_bytes || 0) + " B", xxd.output ? "var(--status-clean)" : null),
    ran(Object.keys(r2).length, "radare2", (r2.functions || 0) + " functions", null),
    ran(Object.keys(capa).length, "capa", (capa.capabilities || 0) + " capabilities", null),
    ran(ml.ok, "EMBER2024", ml.ok ? (ml.verdict || "scored") : "not run",
        ml.ok ? (ml.threat_level === "low" ? "var(--status-clean)" : "var(--status-suspicious)") : null),
  ];

  el.innerHTML = cards.map(c =>
    '<div class="stat-card"' + (c.ok ? '' : ' style="opacity:.55"') + '>' +
    '<div class="sl">' + esc(c.label) + '</div>' +
    '<div class="sv"' + (c.colour ? ' style="color:' + c.colour + ';font-size:16px"' : ' style="font-size:16px"') +
    '>' + esc(c.value) + '</div></div>').join("");
})();
</script>

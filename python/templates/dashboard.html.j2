/* ═══ Assembly Viewer ═══ */
const asmEl = document.getElementById("asm");
const fnSel = document.getElementById("fnSel");
const ROW = 28;
let rows = [], filtered = [], curFn = null, asmCategory = "all";

/* Instruction categories drive the colour rail, the filter chips and the
   control-flow mini map. Kept deliberately coarse — analysts read the rail
   shape, not the individual hues. */
const ASM_CATS = ["ctrl","call","ret","data","arith","cmp","stack","simd","nop","misc"];
const T_CTRL  = {jmp:1,cjmp:1,ujmp:1,rjmp:1,rcjmp:1,swi:1,trap:1,ill:1,int:1};
const T_CALL  = {call:1,ucall:1,rcall:1,icall:1,acall:1};
const T_RET   = {ret:1,iret:1};
const T_DATA  = {mov:1,movzx:1,movsx:1,lea:1,xchg:1};
const T_ARITH = {add:1,sub:1,mul:1,imul:1,div:1,idiv:1,inc:1,dec:1,neg:1,not:1,and:1,
                 or:1,xor:1,shl:1,shr:1,sar:1,sal:1,rol:1,ror:1,adc:1,sbb:1};
const T_CMP   = {cmp:1,test:1};
const T_STACK = {push:1,pop:1,leave:1,enter:1};
const T_NOP   = {nop:1,fnop:1};
const ASM_END = {ret:1,jmp:1,ujmp:1,rjmp:1,trap:1,ill:1,swi:1};

function asmCat(type, mnem) {
  const t = String(type || "").toLowerCase(), m = String(mnem || "").toLowerCase();
  if (T_RET[t] || T_RET[m]) return "ret";
  if (T_CALL[t] || T_CALL[m]) return "call";
  if (T_CTRL[t] || T_CTRL[m]) return "ctrl";
  if (T_CMP[t] || T_CMP[m]) return "cmp";
  if (T_STACK[t] || T_STACK[m]) return "stack";
  if (T_NOP[t] || T_NOP[m]) return "nop";
  if (/^(mov[au]ps|movdqa|movdqu|lddqu|pxor|p(add|sub|and|or|xor|unpck|cmp|min|max))/i.test(m) ||
      /^v[a-z]{2,}/i.test(m)) return "simd";
  if (T_DATA[t] || T_DATA[m] || /^mov/i.test(m)) return "data";
  if (T_ARITH[t] || T_ARITH[m]) return "arith";
  return "misc";
}

function buildRows(fn) {
  const r = [];
  const ops = fn.ops || [];
  const base = fn.offset || 0, size = fn.size || 0;
  /* branch targets inside this function start a new basic block */
  const targets = {};
  for (const o of ops) {
    const t = o.target || 0;
    if (t && t > base && (!size || t < base + size)) targets[t] = 1;
  }
  r.push({head: true, text: (fn.name || "?") + "  @ " + HEX(base) + "  size=" + size +
                              "  instr=" + (fn.n_instr || ops.length) +
                              (fn.truncated ? "  [TRUNCATED]" : "")});
  let block = 0, term = true;
  for (const o of ops) {
    const off = o.offset || 0;
    if (term || targets[off]) {
      block++;
      r.push({blk: true, text: "block " + block + "  @ " + HEX(off)});
      term = false;
    }
    const disasm = o.disasm || "";
    const mnem = disasm.split(/\s+/)[0] || "";
    const type = String(o.type || "").toLowerCase();
    r.push({adr: HEX(off), bytes: o.bytes || "", disasm: disasm, mnem: mnem, type: type,
            cat: asmCat(type, mnem),
            len: (o.bytes || "").split(/\s+/).filter(Boolean).length,
            block: block, target: o.target, label: o.target_label, isImport: !!o.import});
    if (ASM_END[type] || ASM_END[mnem.toLowerCase()]) term = true;
  }
  return r;
}

function renderAsm() {
  const sc = asmEl.scrollTop;
  const first = Math.max(0, Math.floor(sc / ROW) - 2);
  const count = Math.ceil((asmEl.clientHeight || 420) / ROW) + 4;
  const slice = filtered.slice(first, first + count);
  const padTop = first * ROW;
  const padBot = Math.max(0, (filtered.length - first - slice.length) * ROW);
  let html = '<div style="height:' + padTop + 'px"></div>';
  for (const r of slice) {
    if (r.head) { html += '<div class="asmrow head">' + esc(r.text) + '</div>'; continue; }
    if (r.blk)  { html += '<div class="asmrow blk">' + esc(r.text) + '</div>'; continue; }
    let mn = esc(r.disasm);
    mn = mn.replace(/\b(0x[0-9a-fA-F]+)\b/g, '<span class="op-imm">$1</span>');
    const tclass = "t-" + (r.type || "misc");
    let tgt = "";
    if (r.label) tgt = ' <span class="tgt" data-a="' + r.target + '">' + esc(r.label) + '</span>';
    else if (r.target) tgt = ' <span class="tgt" data-a="' + r.target + '">' + HEX(r.target) + '</span>';
    const imp = r.isImport ? " imp-call" : "";
    const lenpct = Math.max(8, Math.min(100, (r.len || 1) * 14));
    html += '<div class="asmrow">' +
      '<span class="catbar c-' + r.cat + '" title="' + r.cat + '"></span>' +
      '<span class="adr">' + r.adr + '</span>' +
      '<span class="byt">' + esc(r.bytes) + '</span>' +
      '<span class="blkcol">B' + r.block + '</span>' +
      '<span class="mn ' + tclass + imp + '">' + mn + tgt + '</span>' +
      '<span class="lenbar" title="' + (r.len || 0) + ' bytes"><i style="width:' + lenpct + '%"></i></span>' +
      '</div>';
  }
  html += '<div style="height:' + padBot + 'px"></div>';
  asmEl.innerHTML = html;
  asmEl.querySelectorAll(".tgt").forEach(el => { el.onclick = () => gotoAddr(el.dataset.a); });
  asmMapViewport();
}

function gotoAddr(a) {
  const addr = parseInt(a, 10);
  if (!addr) return;
  for (const fn of (DATA.asm||[])) {
    const off = fn.offset||0, size = fn.size||0;
    if (addr >= off && (size===0 || addr < off+size)) {
      if (fnSel) fnSel.value = String(off);
      loadFn(fn);
      const idx = filtered.findIndex(r=>!r.head && parseInt(r.adr,16)>=addr);
      asmEl.scrollTop = Math.max(0,(idx<0?0:idx)*ROW-80);
      renderAsm();
      return;
    }
  }
}

function loadFn(fn) {
  rows = buildRows(fn);
  filtered = rows;
  document.getElementById("asmInfo").textContent = (fn.ops||[]).length+" instructions";
  renderAsm();
  renderAsmStats();
}

if (fnSel && DATA.asm && DATA.asm.length) {
  DATA.asm.forEach((fn,i) => {
    const o = document.createElement("option");
    o.value = String(fn.offset||i);
    o.textContent = (fn.name||"?")+" @ "+HEX(fn.offset||0)+" ("+(fn.ops||[]).length+")";
    fnSel.appendChild(o);
  });
  fnSel.onchange = () => {
    const fn = DATA.asm.find((f,i)=>String(f.offset||i)===fnSel.value);
    if (fn) loadFn(fn);
  };
  loadFn(DATA.asm[0]);
  asmEl.onscroll = renderAsm;
  const as = document.getElementById("asmSearch");
  if (as) as.oninput = applyAsmFilter;
  wireAssemblyControls();
  const copyBtn = document.getElementById("copyAsm");
  if (copyBtn) copyBtn.onclick = () => {
    const text = Array.from(document.querySelectorAll("#asm .asmrow")).map(r=>r.textContent).join("\n");
    navigator.clipboard.writeText(text).then(()=>{
      copyBtn.classList.add("copied"); copyBtn.textContent="\u2713 Copied";
      setTimeout(()=>{copyBtn.classList.remove("copied");copyBtn.textContent="Copy All";},1500);
    });
  };
}

/* Assembly filtering, statistics, and control-flow minimap. */
function asmVisibleRows() {
  return filtered;
}
function applyAsmFilter() {
  const q = (document.getElementById("asmSearch")?.value || "").toLowerCase();
  const cat = document.querySelector(".fbtn[data-cat].active")?.dataset.cat || "all";
  filtered = rows.filter(r => r.head || r.blk || ((!q || (r.disasm || "").toLowerCase().includes(q) || (r.label || "").toLowerCase().includes(q)) && (cat === "all" || r.cat === cat)));
  asmEl.scrollTop = 0;
  renderAsm();
  renderAsmStats();
}
function renderAsmStats() {
  const el = document.getElementById("asmStats"), mn = document.getElementById("asmMnemonics");
  if (el) {
    const ins = filtered.filter(r => !r.head && !r.blk), blocks = new Set(ins.map(r => r.block));
    const bytes = ins.reduce((n, r) => n + (r.len || 0), 0);
    const cats = {}; ins.forEach(r => cats[r.cat] = (cats[r.cat] || 0) + 1);
    const stack = Object.keys(cats).map(k => `<i title="${k}: ${cats[k]}" style="width:${(cats[k] * 100 / Math.max(1, ins.length)).toFixed(2)}%;background:var(--c-${k},#6b7f9e)"></i>`).join("");
    el.innerHTML = `<span><b>${ins.length}</b> visible instructions</span><span><b>${blocks.size}</b> basic blocks</span><span><b>${bytes}</b> bytes</span><span class="asm-stack">${stack}</span>`;
  }
  if (mn) {
    const counts = {}; filtered.filter(r => !r.head && !r.blk).forEach(r => counts[r.mnem] = (counts[r.mnem] || 0) + 1);
    const top = Object.entries(counts).sort((a,b) => b[1]-a[1]).slice(0,10);
    mn.innerHTML = top.map(([k,v]) => `<div><span class="b" style="width:${Math.max(8, v * 70 / Math.max(1, top[0][1]))}px"></span>${esc(k)} <b>${v}</b></div>`).join("");
  }
}
function asmMapViewport() {
  const map = document.getElementById("asmMap"), win = document.getElementById("asmWin");
  if (!map) return;
  map.querySelectorAll("i").forEach(x => x.remove());
  const ins = filtered.filter(r => !r.head && !r.blk), max = Math.max(1, ins.length), h = map.clientHeight || 1;
  ins.forEach((r, i) => { const bar = document.createElement("i"); bar.title = `${r.cat} · ${r.disasm}`; bar.style.top = (i * h / max) + "px"; bar.style.height = Math.max(2, h / max - 1) + "px"; bar.style.background = `var(--c-${r.cat},#35507f)`; map.appendChild(bar); });
  if (win) { const top = asmEl.scrollTop / Math.max(1, filtered.length * ROW - asmEl.clientHeight); win.style.top = (top * h) + "px"; win.style.height = Math.max(10, h / Math.max(1, filtered.length)) + "px"; }
}
function wireAssemblyControls() {
  const q = document.getElementById("asmSearch"); if (q) q.oninput = applyAsmFilter;
  document.querySelectorAll(".fbtn[data-cat]").forEach(b => b.onclick = () => { document.querySelectorAll(".fbtn[data-cat]").forEach(x => x.classList.remove("active")); b.classList.add("active"); applyAsmFilter(); });
  const addr = document.getElementById("asmAddr"); if (addr) addr.onkeydown = e => { if (e.key === "Enter") gotoAddr(addr.value.trim()); };
  const fs = document.getElementById("fnSearch"); if (fs) fs.oninput = () => { const needle = fs.value.toLowerCase(); Array.from(fnSel.options).forEach(o => o.hidden = needle && !o.textContent.toLowerCase().includes(needle)); };
  const map = document.getElementById("asmMap"); if (map) map.onclick = e => { const r = map.getBoundingClientRect(), frac = Math.max(0, Math.min(1, (e.clientY-r.top)/r.height)), idx = Math.floor(frac * filtered.length); asmEl.scrollTop = Math.max(0, idx * ROW - 80); renderAsm(); };
  renderAsmStats();
}

/* Deterministic ranked call graph: avoids the old 220-node force simulation. */
function renderRankedGraph(svgId, graph, maxNodes, compact) {
  const svgEl = document.getElementById(svgId); if (!svgEl) return;
  const W = svgEl.clientWidth || 900, H = svgEl.clientHeight || 520;
  const svg = d3.select(svgEl); svg.selectAll("g.graph-content").remove(); svg.attr("viewBox", `0 0 ${W} ${H}`);
  const all = (graph.nodes || []).map(n => ({...n})), byId = new Map(all.map(n => [n.id, n]));
  const allEdges = (graph.edges || []).filter(e => byId.has(e[0]) && byId.has(e[1]) && e[0] !== e[1]);
  const deg = new Map(), indegree = new Map(); for (const n of all) indegree.set(n.id, 0);
  for (const e of allEdges) { deg.set(e[0], (deg.get(e[0]) || 0) + 1); deg.set(e[1], (deg.get(e[1]) || 0) + 1); indegree.set(e[1], (indegree.get(e[1]) || 0) + 1); }
  const roots = all.filter(n => !indegree.get(n.id)).map(n => n.id);
  let keep = new Set(compact ? all.slice().sort((a,b) => (deg.get(b.id)||0)-(deg.get(a.id)||0)).slice(0,60).map(n=>n.id) : all.map(n=>n.id));
  roots.forEach(r => keep.add(r));
  const nodes = all.filter(n => keep.has(n.id)).slice(0,maxNodes), ids = new Set(nodes.map(n=>n.id));
  const edges = allEdges.filter(e => ids.has(e[0]) && ids.has(e[1]));
  const out = new Map(nodes.map(n=>[n.id,[]])), indeg = new Map(nodes.map(n=>[n.id,0]));
  edges.forEach(e=>{out.get(e[0]).push(e[1]); indeg.set(e[1],indeg.get(e[1])+1);});
  const rank = new Map(), queue = roots.filter(r=>ids.has(r)).map(id=>({id,d:0})); queue.forEach(x=>rank.set(x.id,0));
  for (let p=0;p<queue.length;p++){const x=queue[p];for(const y of out.get(x.id)){if(!rank.has(y)){rank.set(y,x.d+1);queue.push({id:y,d:x.d+1});}}}
  const reachableMax = Math.max(0, ...rank.values());
  nodes.forEach(n => { if (!rank.has(n.id)) rank.set(n.id, reachableMax + 1); });
  const groups = new Map(); nodes.forEach(n=>{const d=rank.get(n.id)||0;if(!groups.has(d))groups.set(d,[]);groups.get(d).push(n);});
  const pos=new Map(), maxRank=Math.max(1,...groups.keys()), colW=(W-84)/Math.min(maxRank,9);
  groups.forEach((items,d)=>items.forEach((n,i)=>{const h=items.length,y=h===1?H/2:30+i*(H-60)/Math.max(1,h-1);pos.set(n.id,{x:42+d*colW,y});}));
  const g=svg.append("g").attr("class","graph-content"), zoom=d3.zoom().scaleExtent([.25,3.5]).on("zoom",ev=>g.attr("transform",ev.transform)); svg.call(zoom);
  const line=g.append("g").selectAll("path").data(edges).join("path").attr("class","cg-line").attr("d",e=>{const a=pos.get(e[0]),b=pos.get(e[1]);if(!a||!b)return "";const q=Math.max(18,Math.abs(b.x-a.x)*.18);return `M${a.x},${a.y} C${a.x+q},${a.y} ${b.x-q},${b.y} ${b.x},${b.y}`;}).attr("marker-end","url(#arrow)");
  const node=g.append("g").selectAll("g").data(nodes).join("g").attr("class",d=>"cg-node"+(roots.includes(d.id)?" entry":"")).attr("transform",d=>{const p=pos.get(d.id);return `translate(${p.x},${p.y})`;});
  node.append("rect").attr("x",-7).attr("y",-13).attr("width",d=>Math.max(34,Math.min(190,String(d.label||d.id).length*5.7+16))).attr("height",26);
  node.append("text").attr("x",0).attr("y",4).text(d=>{const s=String(d.label||d.id);return s.length>30?s.slice(0,29)+"…":s;}); node.append("title").text(d=>`${d.label||d.id} · ${deg.get(d.id)||0} call edge(s)`);
  node.on("mouseenter",function(ev,d){const near=new Set([d.id]);edges.forEach(e=>{if(e[0]===d.id)near.add(e[1]);if(e[1]===d.id)near.add(e[0]);});node.classed("dim",n=>!near.has(n.id));line.classed("dim",e=>e[0]!==d.id&&e[1]!==d.id).classed("hot",e=>e[0]===d.id||e[1]===d.id);}).on("mouseleave",()=>{node.classed("dim",false);line.classed("dim",false).classed("hot",false);});
  const note=document.getElementById(svgId==="cfgsvg"?"cgNote":"");if(note)note.textContent=`${nodes.length} nodes · ${edges.length} edges · ranked by reachability from entry roots; hover to isolate callers/callees`;
}
function renderGraphs() {
  const compact = document.getElementById("cgCompact") && document.getElementById("cgCompact").classList.contains("active");
  renderRankedGraph("cfgsvg", DATA.graphs.callgraph, 220, compact); renderRankedGraph("secsvg", DATA.graphs.section, 180, true);
  const st=document.getElementById("cgStats");if(st)st.innerHTML=[["Functions",DATA.graphs.callgraph.nodes.length],["Call edges",DATA.graphs.callgraph.edges.length],["Section nodes",DATA.graphs.section.nodes.length]].map(x=>`<div class="stat-card"><div class="sv">${x[1]}</div><div class="sl">${x[0]}</div></div>`).join("");
  const search = document.getElementById("cgSearch");
  if (search && search.value.trim()) { const q=search.value.toLowerCase(); d3.select("#cfgsvg .cg-node").classed("hit",d=>String(d.label||d.id).toLowerCase().includes(q)).classed("dim",d=>!String(d.label||d.id).toLowerCase().includes(q)); }
}
document.getElementById("cgFit")?.addEventListener("click",()=>{const s=d3.select("#cfgsvg");s.transition().duration(250).call(d3.zoom().transform,d3.zoomIdentity);});
document.getElementById("cgResetFocus")?.addEventListener("click",()=>{const x=document.getElementById("cgSearch");if(x)x.value="";renderGraphs();});
["cgLayout","cgSearch","cgMinDeg","cgNoLeaf","cgNoOrphan","cgFit","cgResetFocus","cgCompact","cgAll"].forEach(id => { const el=document.getElementById(id); if (!el) return; el.oninput = el.onchange = () => { if (id === "cgCompact") { el.classList.toggle("active"); document.getElementById("cgAll").classList.remove("active"); } if (id === "cgAll") { document.getElementById("cgCompact").classList.remove("active"); } renderGraphs(); }; });
window.addEventListener("load", () => { renderGraphs(); });


function chartDonut(containerId, labels, values) {
  const el = document.getElementById(containerId);
  if (!el || !values.length) return;
  const W = el.clientWidth||400, H = 250;
  const r = Math.min(W,H)/2 - 20, ir = r*0.55;
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const total = d3.sum(values)||1;
  const g = svg.append("g").attr("transform",`translate(${W/2},${H/2})`);
  const pie = d3.pie().value(d=>d).sort(null);
  const arc = d3.arc().innerRadius(ir).outerRadius(r);
  const arcs = pie(values);

  const slices = g.selectAll("path").data(arcs).join("path")
    .attr("fill",(d,i)=>PAL[i%PAL.length])
    .attr("opacity",0.85)
    .attr("d",arc);
  slices.transition().duration(700).attrTween("d", function(d) {
    const i = d3.interpolate({startAngle:d.startAngle, endAngle:d.startAngle}, d);
    return t => arc(i(t));
  });

  /* center */
  g.append("text").attr("text-anchor","middle").attr("y",2)
    .attr("font-size","16").attr("font-weight","700").attr("fill","#e2eaf6")
    .attr("font-family","var(--mono)").text(total);
  g.append("text").attr("text-anchor","middle").attr("y",18)
    .attr("font-size","9").attr("fill","#6b7f9e").text("total");

  /* labels */
  const lg = svg.append("g");
  labels.forEach((l,i)=>{
    const pct = Math.round(values[i]/total*100);
    lg.append("circle").attr("cx",10).attr("cy",H/2-labels.length*9+i*18+4)
      .attr("r",4).attr("fill",PAL[i%PAL.length]);
    lg.append("text").attr("x",20).attr("y",H/2-labels.length*9+i*18+8)
      .attr("font-size","10").attr("fill","#8b9cb5").attr("font-family","var(--mono)")
      .text(String(l).slice(0,14)+" "+pct+"% ("+values[i]+")");
  });

  /* tooltip */
  slices.on("mousemove", function(ev,d) {
    let tip = document.getElementById("d3tip");
    if (!tip) { tip = document.createElement("div"); tip.id="d3tip"; tip.className="d3-tip"; document.body.appendChild(tip); }
    tip.style.display="block"; tip.style.left=(ev.pageX+12)+"px"; tip.style.top=(ev.pageY-10)+"px";
    const li = arcs.indexOf(d);
    tip.innerHTML = '<div class="dt-l">'+esc(labels[li]||"")+'</div><div class="dt-v">'+values[li]+' ('+Math.round(d.value/total*100)+'%)</div>';
  }).on("mouseleave", ()=>{const t=document.getElementById("d3tip"); if(t)t.style.display="none";})
    .on("mouseover", function(){d3.select(this).attr("opacity",1);})
    .on("mouseout", function(){d3.select(this).attr("opacity",0.85);});
}

function chartLine(containerId, labels, values, color) {
  const el = document.getElementById(containerId);
  if (!el || !values.length) return;
  const W = el.clientWidth||400, H = 250;
  const pad = {t:15,r:15,b:30,l:45};
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const max = (d3.max(values)||1)*1.15;
  const x = d3.scalePoint().domain(labels.map(String)).range([pad.l, W-pad.r]);
  const y = d3.scaleLinear().domain([0,max]).range([H-pad.b, pad.t]);
  const g = svg.append("g");

  /* grid */
  g.selectAll("line.g").data(y.ticks(5)).join("line").attr("class","g")
    .attr("x1",pad.l).attr("x2",W-pad.r).attr("y1",d=>y(d)).attr("y2",d=>y(d))
    .attr("stroke","currentColor").attr("opacity",0.06);

  /* area */
  const areaGen = d3.area().x((d,i)=>x(String(labels[i]))).y0(H-pad.b).y1(d=>y(d)).curve(d3.curveMonotoneX);
  g.append("path").datum(values).attr("fill",color).attr("opacity",0.12).attr("d",areaGen);

  /* line */
  const lineGen = d3.line().x((d,i)=>x(String(labels[i]))).y(d=>y(d)).curve(d3.curveMonotoneX);
  const path = g.append("path").datum(values).attr("fill","none")
    .attr("stroke",color).attr("stroke-width",2).attr("d",lineGen);
  const totalLen = (typeof path.node().getTotalLength === "function") ? path.node().getTotalLength() : 0;
  if (totalLen) {
    path.attr("stroke-dasharray", totalLen).attr("stroke-dashoffset", totalLen)
        .transition().duration(800).attr("stroke-dashoffset", 0);
  }

  /* dots */
  const dots = g.selectAll("circle.d").data(values.map((v,i)=>({v,l:labels[i],i}))).join("circle")
    .attr("class","d").attr("cx",d=>x(String(d.l))).attr("cy",d=>y(d.v)).attr("r",4)
    .attr("fill",color).attr("stroke","#0a0e16").attr("stroke-width",1.5);

  /* x labels */
  const step = Math.max(1, Math.ceil(labels.length/8));
  g.selectAll("text.xl").data(labels.filter((l,i)=>i%step===0)).join("text")
    .attr("class","xl").attr("x",d=>x(String(d))).attr("y",H-pad.b+14)
    .attr("text-anchor","middle").attr("font-size","9").attr("fill","#6b7f9e")
    .attr("font-family","var(--mono)").text(d=>String(d).slice(0,6));

  /* y axis */
  g.selectAll("text.yl").data(y.ticks(5)).join("text").attr("class","yl")
    .attr("x",pad.l-7).attr("y",d=>y(d)+3).attr("text-anchor","end")
    .attr("font-size","9").attr("fill","#6b7f9e").attr("font-family","var(--mono)")
    .text(d=>d.toFixed(1));

  /* threshold line for entropy */
  if (containerId==="chEntropy") {
    const ty = y(7.2);
    if (ty>0 && ty<H) {
      g.append("line").attr("x1",pad.l).attr("x2",W-pad.r).attr("y1",ty).attr("y2",ty)
        .attr("stroke","#ff4d5e").attr("stroke-dasharray","4,4").attr("opacity",0.5);
      g.append("text").attr("x",W-pad.r).attr("y",ty-4).attr("text-anchor","end")
        .attr("font-size","9").attr("fill","#ff4d5e").text("threshold 7.2");
    }
  }

  /* tooltip */
  dots.on("mousemove", function(ev,d) {
    let tip = document.getElementById("d3tip");
    if (!tip) { tip = document.createElement("div"); tip.id="d3tip"; tip.className="d3-tip"; document.body.appendChild(tip); }
    tip.style.display="block"; tip.style.left=(ev.pageX+12)+"px"; tip.style.top=(ev.pageY-10)+"px";
    tip.innerHTML = '<div class="dt-l">'+esc(String(d.l))+'</div><div class="dt-v">'+d.v+'</div>';
    d3.select(this).attr("r",6);
  }).on("mouseleave", function(){
    const t=document.getElementById("d3tip"); if(t)t.style.display="none";
    d3.select(this).attr("r",4);
  });
}

function chartGauge(containerId, score) {
  const el = document.getElementById(containerId);
  if (!el) return;
  const W = el.clientWidth||400, H = 140;
  const cx = W/2, cy = H-10, r = Math.min(cx-30, cy-10);
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const g = svg.append("g");
  const startA = -Math.PI, endA = 0;

  /* background arc */
  const bgArc = d3.arc().innerRadius(r-18).outerRadius(r).startAngle(startA).endAngle(endA);
  g.append("path").attr("d", bgArc).attr("fill","currentColor").attr("opacity",0.06);

  /* colored segments */
  const segs = [
    {label:"Clean", color:"#2ee6a8", from:0, to:25},
    {label:"Suspicious", color:"#ffd166", from:25, to:60},
    {label:"Malicious", color:"#ff4d5e", from:60, to:100},
  ];
  segs.forEach(s => {
    const a1 = startA + (s.from/100)*(endA-startA);
    const a2 = startA + (s.to/100)*(endA-startA);
    const arc = d3.arc().innerRadius(r-18).outerRadius(r).startAngle(a1).endAngle(a2);
    g.append("path").attr("d", arc).attr("fill", s.color).attr("opacity", 0.35);
  });

  /* score arc */
  const scoreA = startA + (score/100)*(endA-startA);
  const scoreArc = d3.arc().innerRadius(r-18).outerRadius(r).startAngle(startA).endAngle(scoreA);
  const color = score>=60?"#ff4d5e":score>=25?"#ffd166":"#2ee6a8";
  g.append("path").attr("d", scoreArc).attr("fill", color).attr("opacity",0.9)
    .transition().duration(1000).attrTween("opacity", ()=>d3.interpolate(0.5,0.9));

  /* needle */
  const needleAngle = startA + (score/100)*(endA-startA);
  const nx = cx + Math.cos(needleAngle)*(r-22), ny = cy + Math.sin(needleAngle)*(r-22);
  g.append("line").attr("x1",cx).attr("y1",cy).attr("x2",nx).attr("y2",ny)
    .attr("stroke","#e2eaf6").attr("stroke-width",2).attr("stroke-linecap","round");
  g.append("circle").attr("cx",cx).attr("cy",cy).attr("r",5).attr("fill","#e2eaf6");

  /* score text */
  g.append("text").attr("x",cx).attr("y",cy-30).attr("text-anchor","middle")
    .attr("font-size","28").attr("font-weight","800").attr("fill",color)
    .attr("font-family","var(--mono)").text(score);
  g.append("text").attr("x",cx).attr("y",cy-14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#6b7f9e").attr("letter-spacing","1.5")
    .text("THREAT SCORE");

  /* labels */
  g.append("text").attr("x",cx-r).attr("y",cy+14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#2ee6a8").text("0");
  g.append("text").attr("x",cx+r).attr("y",cy+14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#ff4d5e").text("100");
}

/* ═══ ML section: probability gauge + SHAP contribution bars ═══ */
function chartProbGauge(containerId, prob, threshold) {
  const el = document.getElementById(containerId);
  if (!el) return;
  const W = el.clientWidth||400, H = 150;
  const cx = W/2, cy = H-16, r = Math.min(cx-34, cy-14), ir = r-18;
  const p = Math.max(0, Math.min(1, +prob||0));
  const thr = Math.max(0, Math.min(1, +threshold||0));
  /* d3.arc measures from 12 o'clock clockwise, so -PI/2..PI/2 is the top half;
     the needle uses the same half via math angles (PI..2PI sweeps left -> up -> right). */
  const arcAt = t => -Math.PI/2 + Math.max(0, Math.min(1, t))*Math.PI;
  const needleAt = t => Math.PI + Math.max(0, Math.min(1, t))*Math.PI;
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const g = svg.append("g");
  const band = (t0,t1,color,op) => g.append("path")
    .attr("d", d3.arc().innerRadius(ir).outerRadius(r).startAngle(arcAt(t0)).endAngle(arcAt(t1)))
    .attr("fill",color).attr("opacity",op);

  band(0, 1, "currentColor", 0.06);
  band(0, thr, "#2ee6a8", 0.3);
  band(thr, 1, "#ff4d5e", 0.3);
  band(0, p, p>=thr ? "#ff4d5e" : "#2ee6a8", 0.9);

  /* threshold tick */
  const ta = needleAt(thr);
  g.append("line")
    .attr("x1", cx+Math.cos(ta)*(ir-4)).attr("y1", cy+Math.sin(ta)*(ir-4))
    .attr("x2", cx+Math.cos(ta)*(r+5)).attr("y2", cy+Math.sin(ta)*(r+5))
    .attr("stroke","#ffd166").attr("stroke-width",2).attr("stroke-linecap","round");

  /* needle */
  const na = needleAt(p);
  g.append("line").attr("x1",cx).attr("y1",cy)
    .attr("x2", cx+Math.cos(na)*(ir-6)).attr("y2", cy+Math.sin(na)*(ir-6))
    .attr("stroke","#e2eaf6").attr("stroke-width",2).attr("stroke-linecap","round");
  g.append("circle").attr("cx",cx).attr("cy",cy).attr("r",5).attr("fill","#e2eaf6");

  const color = p>=thr ? "#ff4d5e" : "#2ee6a8";
  g.append("text").attr("x",cx).attr("y",cy-34).attr("text-anchor","middle")
    .attr("font-size","26").attr("font-weight","800").attr("fill",color)
    .attr("font-family","var(--mono)").text(p.toFixed(4));
  g.append("text").attr("x",cx).attr("y",cy-17).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#6b7f9e").attr("letter-spacing","1.5")
    .text("P(MALICIOUS)");
  g.append("text").attr("x",cx-r).attr("y",cy+14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#2ee6a8").text("0");
  g.append("text").attr("x",cx+r).attr("y",cy+14).attr("text-anchor","middle")
    .attr("font-size","9").attr("fill","#ff4d5e").text("1.0");
}

/* Signed SHAP bars: red towards malicious, green towards benign, zero line kept. */
function chartShapBars(containerId, labels, values, tips) {
  const el = document.getElementById(containerId);
  if (!el || !values.length) return;
  const W = el.clientWidth||400, rowH = 26, H = values.length*rowH+16;
  const padL = Math.min(220, Math.max(110, W*0.36)), padR = 62;
  el.innerHTML = "";
  const svg = d3.select(el).append("svg").attr("width",W).attr("height",H);
  const lo = Math.min(0, d3.min(values)), hi = Math.max(0, d3.max(values));
  const x = d3.scaleLinear().domain([lo===hi?0:lo, lo===hi?1:hi]).range([padL+6, W-padR]);
  /* index keys, not the labels: two features can share a name and scaleBand
     would silently collapse them into one row. */
  const keys = values.map((v,i)=>String(i));
  const y = d3.scaleBand().domain(keys).range([10, H-8]).padding(0.3);
  const data = values.map((v,i)=>({v, l:String(labels[i]||""), k:String(i),
                                   tip:String((tips&&tips[i])||labels[i]||"")}));
  const g = svg.append("g");

  g.append("line").attr("x1",x(0)).attr("x2",x(0)).attr("y1",6).attr("y2",H-6)
    .attr("stroke","currentColor").attr("opacity",0.25);

  const bars = g.selectAll("rect.s").data(data).join("rect").attr("class","s")
    .attr("y",d=>y(d.k)).attr("height",y.bandwidth())
    .attr("x",x(0)).attr("width",0).attr("rx",3)
    .attr("fill",d=>d.v>=0?"#ff4d5e":"#2ee6a8").attr("opacity",0.85);
  bars.transition().duration(600).delay((d,i)=>i*40)
    .attr("x",d=>Math.min(x(0),x(d.v)))
    .attr("width",d=>Math.max(2,Math.abs(x(d.v)-x(0))));

  g.selectAll("text.v").data(data).join("text").attr("class","v")
    .attr("y",d=>y(d.k)+y.bandwidth()/2+4)
    .attr("x",d=>d.v>=0?x(d.v)+5:x(d.v)-5)
    .attr("text-anchor",d=>d.v>=0?"start":"end")
    .attr("font-size","10").attr("fill","#8b9cb5").attr("font-family","var(--mono)")
    .text(d=>d.v.toFixed(3));

  g.selectAll("text.l").data(data).join("text").attr("class","l")
    .attr("x",padL-8).attr("y",d=>y(d.k)+y.bandwidth()/2+4)
    .attr("text-anchor","end").attr("font-size","10").attr("fill","#6b7f9e")
    .attr("font-family","var(--mono)").text(d=>d.l.slice(0,34));

  bars.on("mousemove", function(ev,d) {
    let tip = document.getElementById("d3tip");
    if (!tip) { tip = document.createElement("div"); tip.id="d3tip"; tip.className="d3-tip"; document.body.appendChild(tip); }
    tip.style.display="block"; tip.style.left=(ev.pageX+12)+"px"; tip.style.top=(ev.pageY-10)+"px";
    tip.innerHTML = '<div class="dt-l">'+esc(d.tip)+'</div><div class="dt-v">'+d.v.toFixed(4)+'</div>';
  }).on("mouseleave", ()=>{const t=document.getElementById("d3tip"); if(t)t.style.display="none";});
}

function drawML() {
  const ml = DATA.ml || {};
  const expl = ml.explanation || {};
  const rollup = expl.group_rollup || [];
  const tops = expl.top_features || [];
  /* Same palette as the Jinja card above: one band, one colour, everywhere. */
  const LEVEL_COLOR = {low:"#2ee6a8", moderate:"#ffd166", high:"#ff4d5e",
                       critical:"#ff4d5e", "n/a":"#6b7f9e"};
  const stats = document.getElementById("mlStats");
  if (stats) {
    const cards = ml.ok ? [
      {v: ml.threat_level || "—", l: "threat level", c: LEVEL_COLOR[ml.threat_level]},
      {v: ml.verdict || "—", l: "verdict"},
      {v: (typeof ml.malicious_probability === "number") ? ml.malicious_probability.toFixed(4) : "—",
       l: "P(malicious)"},
      {v: (typeof ml.threshold_margin === "number")
            ? (ml.threshold_margin >= 0 ? "+" : "") + ml.threshold_margin.toFixed(4)
            : "—", l: "vs threshold"},
      {v: (ml.threshold === undefined || ml.threshold === null) ? "—" : ml.threshold, l: "threshold"},
      {v: ml.trees || 0, l: "trees"},
      {v: ml.features || 0, l: "features"},
      {v: rollup.length, l: "SHAP groups"},
      {v: tops.length, l: "top features"},
      {v: Math.round((ml.bytes||0)/1024) + " KB", l: "scored"},
    ] : [
      {v: ml.error ? "error" : "skipped", l: "ML status"},
      {v: "—", l: "P(malicious)"},
    ];
    stats.innerHTML = cards.map(c =>
      '<div class="stat-card"><div class="sv"' +
      (c.c ? ' style="color:' + c.c + '"' : "") + ">" + c.v +
      '</div><div class="sl">' + c.l + "</div></div>").join("");
  }
  if (!ml.ok) return;

  chartProbGauge("mlGauge", ml.malicious_probability || 0, ml.threshold || 0);
  if (rollup.length)
    chartShapBars("mlGroups", rollup.map(x=>x.group), rollup.map(x=>+x.shap_log_odds||0),
                  rollup.map(x=>x.group + (x.analyzer_implemented ? " (in analyzer)" : "")));
  if (tops.length)
    chartShapBars("mlFeatures",
                  tops.map(x=>(x.label || x.evidence || x.group || "")),
                  tops.map(x=>+x.shap_log_odds||0),
                  tops.map(x=>"#" + (x.feature_index ?? "?") + " " + (x.group||"") + ": " +
                              (x.label || x.evidence || "") + (x.direction ? " · " + x.direction : "")));
}


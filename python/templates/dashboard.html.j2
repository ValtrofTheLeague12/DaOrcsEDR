<script id="payload" type="application/json">{{ payload_json }}</script>
<script id="world" type="application/json">{{ world_json }}</script>
<script id="countries" type="application/json">{{ country_json }}</script>
<script>{{ d3_src }}</script>
<script>
"use strict";
const DATA = JSON.parse(document.getElementById("payload").textContent);
const AMP = String.fromCharCode(38);
const esc = s => String(s).replace(/[&<>"]/g, c => {
  if (c === AMP) return AMP + "amp;";
  if (c === "<") return AMP + "lt;";
  if (c === ">") return AMP + "gt;";
  return AMP + "quot;";
});
const HEX = n => (typeof n === "number") ? "0x" + n.toString(16) : n;
const TC = {sample:"#4d8dff",section:"#22d3ee",dll:"#a78bfa",capability:"#ffd166",ioc:"#2ee6a8",family:"#ff9f43",malicious:"#ff4d5e",function:"#34d399",analysis:"#818cf8"};
const TS = {sample:26,section:9,dll:11,capability:10,ioc:9,family:11,malicious:13,function:9,analysis:14};
const TL = {sample:"SAMPLE",section:"SECTION",dll:"DLL",capability:"CAPABILITY",ioc:"IOC",family:"FAMILY",malicious:"MALICIOUS",function:"FUNCTION",analysis:"ANALYSIS"};
const PAL = ["#4d8dff","#22d3ee","#a78bfa","#ffd166","#2ee6a8","#ff9f43","#ff4d5e","#f472b6","#818cf8","#34d399","#c084fc","#fb923c"];

/* ═══ Navigation ═══ */
document.querySelectorAll("nav button").forEach(b => {
  b.onclick = () => {
    document.querySelectorAll("nav button").forEach(x => x.classList.remove("on"));
    document.querySelectorAll("main section").forEach(x => x.classList.remove("on"));
    b.classList.add("on");
    const sec = document.getElementById(b.dataset.t);
    if (sec) sec.classList.add("on");
    if (b.dataset.t === "threat") {
      try { drawThreat(); } catch (err) { console.error("Threat view failed", err); }
    }
    if (b.dataset.t === "charts") {
      try { drawAllCharts(); } catch (err) { console.error("Charts failed", err); }
    }
    if (b.dataset.t === "graphs") {
      try { renderGraphs(); } catch (err) { console.error("Graphs failed", err); }
    }
    if (b.dataset.t === "hex") {
      try { renderHexdump(); } catch (err) { console.error("Hexdump failed", err); }
    }
    window.scrollTo({top:0,behavior:"smooth"});
  };
});

/* ═══ Theme ═══ */
const themeBtn = document.getElementById("themeBtn");
let curTheme = localStorage.getItem("dash-theme") || "dark";
document.documentElement.setAttribute("data-theme", curTheme);
themeBtn.textContent = curTheme === "dark" ? "☀" : "🌙";
themeBtn.onclick = () => {
  curTheme = curTheme === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", curTheme);
  localStorage.setItem("dash-theme", curTheme);
  themeBtn.textContent = curTheme === "dark" ? "☀" : "🌙";
  drawAllCharts(); drawThreat(); renderGraphs(); renderHexdump();
};
document.getElementById("topBtn").onclick = () => window.scrollTo({top:0,behavior:"smooth"});

/* ═══ Copy ═══ */
document.addEventListener("click", e => {
  const btn = e.target.closest("[data-copy]");
  if (!btn) return;
  let text = "";
  if (btn.dataset.copy === "sha256") text = document.getElementById("sha256Val").textContent;
  if (text) {
    navigator.clipboard.writeText(text).then(() => {
      btn.classList.add("copied"); btn.textContent = "\u2713 Copied";
      setTimeout(() => { btn.classList.remove("copied"); btn.textContent = "Copy"; }, 1500);
    });
  }
});

/* ═══ Overview stats ═══ */
(function() {
  const el = document.getElementById("ovStats");
  if (!el) return;
  const s = [
    {i:"\u{1F4BE}", v:DATA.fileinfo.size_human||"\u2014", l:"Size"},
    {i:"\u{1F3AF}", v:DATA.verdict.score, l:"Threat"},
    {i:"\u{1F4E6}", v:DATA.extraction.summary.num_sections||0, l:"Sections"},
    {i:"\u{1F524}", v:DATA.extraction.summary.num_strings||0, l:"Strings"},
    {i:"\u2699", v:DATA.extraction.summary.total_instructions||0, l:"Instructions"},
    {i:"\u{1F52D}", v:DATA.malapi.length, l:"MalAPI"},
    {i:"\u{1F310}", v:(DATA.ioc.domains||[]).length+(DATA.ioc.ips||[]).length, l:"IOCs"},
    {i:"\u{1F6E1}", v:DATA.capa.capabilities.length, l:"Caps"},
  ];
  el.innerHTML = s.map(x=>`<div class="stat-card"><div class="si">${x.i}</div><div class="sv">${x.v}</div><div class="sl">${x.l}</div></div>`).join("");
})();

/* ═══ Detail panel (VT-style info blocks) ═══ */
const detailEl = document.getElementById("detail");
const detailClose = document.getElementById("detailClose");
if (detailClose) detailClose.onclick = () => detailEl.classList.remove("open");
document.addEventListener("keydown", e => { if (e.key === "Escape") detailEl.classList.remove("open"); });

function kv(k, v) {
  if (v === undefined || v === null || v === "") return "";
  return '<div class="dt-kv"><span class="k">' + esc(k) + '</span><span class="v">' + esc(v) + '</span></div>';
}
function sect(name) { return '<div class="dt-sect">' + esc(name) + '</div>'; }
function hex(n) { return typeof n === "number" ? "0x" + n.toString(16) : String(n || ""); }

function renderResults(results) {
  if (!results || !results.length) return '<div class="dt-empty">No result data for this block.</div>';
  let html = "";
  for (const r of results) {
    const t = r.type || "";
    if (t === "hash") {
      html += sect("Hashes") + kv("SHA-256", r.value || "");
    } else if (t === "tlsh") {
      html += kv("TLSH", r.value || "");
    } else if (t === "fileinfo") {
      const e = r.entry || {};
      html += sect("File") + kv("Filename", e.filename) + kv("Size", e.size_human)
            + kv("Magic", e.file_magic) + kv("Format", e.format)
            + kv("Executable", e.is_executable ? "yes" : "no");
    } else if (t === "extraction_summary") {
      const e = r.entry || {};
      html += sect("Extraction") + kv("Format", e.format) + kv("Entry", e.entrypoint)
            + kv("Sections", e.num_sections) + kv("Strings", e.num_strings)
            + kv("Instructions", e.total_instructions) + kv("IAT entries", e.num_iat_entries)
            + kv("Machine", e.machine) + kv("Packed", e.is_packed ? "yes" : "no")
            + kv("Signed", e.is_signed ? "yes" : "no");
    } else if (t === "analysis") {
      const e = r.entry || {};
      html += sect("radare2 Analysis") + kv("Functions", e.functions)
            + kv("Files", e.files) + kv("Errors", e.errors);
    } else if (t === "files") {
      const list = Array.isArray(r.entry) ? r.entry : [];
      if (list.length) {
        html += sect("Analyzed Files");
        html += '<div class="dt-chips">' + list.map(f => '<span class="dt-chip">' + esc(f) + '</span>').join("") + '</div>';
      }
    } else if (t === "entrypoint") {
      html += kv("Entrypoint", r.value || "");
    } else if (t === "function") {
      const e = r.entry || {};
      html += sect("Function") + kv("Name", e.name) + kv("Offset", hex(e.offset))
            + kv("Size", (e.size || 0) + " B") + kv("Basic blocks", e.blocks)
            + kv("Pure", e.is_pure ? "yes" : "no");
    } else if (t === "section") {
      const e = r.entry || {};
      html += sect("Section") + kv("Name", e.name) + kv("VA", hex(e.virtual_address))
            + kv("Size", (e.size || 0) + " B")
            + kv("Entropy", (e.entropy != null ? Number(e.entropy).toFixed(3) : ""))
            + kv("χ²", e.chi2 != null ? Math.round(e.chi2) : "")
            + kv("SHA-256", e.sha256 ? e.sha256.slice(0, 32) + "…" : "");
      if (e.entropy > 7.2) html += '<div class="dt-attacks"><span>HIGH ENTROPY (packed/encrypted?)</span></div>';
    } else if (t === "import_list") {
      const imps = r.imports || [];
      html += sect("Imports (" + imps.length + ") in " + (r.dll || ""));
      html += '<div class="dt-chips">' + imps.map(i =>
        '<span class="dt-chip' + (i.flagged ? " flag" : "") + '">' + esc(i.name) +
        (i.delay ? " [delay]" : "") + (i.ordinal ? " [ord]" : "") + '</span>').join("") + '</div>';
    } else if (t === "capability") {
      const e = r.entry || {};
      html += sect("Capability") + kv("Namespace", e.namespace) + kv("Scope", e.scope)
            + kv("Matches", e.match_count);
      if (e.description) html += '<div class="dt-desc">' + esc(e.description) + '</div>';
      const att = (e.attack || []).map(a => a.id || a).filter(Boolean);
      const mbc = (e.mbc || []).map(m => m.id || m).filter(Boolean);
      if (att.length) html += sect("ATT&CK") + '<div class="dt-chips">' + att.map(a => '<span class="dt-chip">' + esc(a) + '</span>').join("") + '</div>';
      if (mbc.length) html += sect("MBC") + '<div class="dt-chips">' + mbc.map(m => '<span class="dt-chip">' + esc(m) + '</span>').join("") + '</div>';
      if ((e.addresses || []).length) html += kv("Addresses", e.addresses.length);
    } else if (t === "ioc") {
      html += sect("IOC") + kv("Kind", r.kind) + kv("Value", r.value);
    } else if (t === "family") {
      const e = r.entry || {};
      html += sect("Family Hint") + kv("Keyword", e.keyword)
            + kv("Classification", e.classification) + kv("Found in", e.in_string);
    } else if (t === "malapi") {
      const e = r.entry || {};
      const d = e.data || {};
      html += sect("MalAPI") + kv("Function", e.function) + kv("DLL", d.dll)
            + kv("Name", d.name);
      if ((d.attacks || []).length) {
        html += '<div class="dt-attacks">' + d.attacks.map(a => '<span>' + esc(a) + '</span>').join("") + '</div>';
      }
      if (d.description) html += '<div class="dt-desc">' + esc(d.description) + '</div>';
      if (d.source) html += sect("Source") + '<code>' + esc(d.source) + '</code>';
    } else if (t === "type" || t === "ioc_summary") {
      html += kv(r.label || "Info", r.value || "");
    } else {
      /* generic fallback — show known keys */
      const keys = Object.keys(r).filter(k => k !== "type");
      if (keys.length) {
        html += sect(t || "Result");
        for (const k of keys) html += kv(k, typeof r[k] === "object" ? JSON.stringify(r[k]) : r[k]);
      }
    }
  }
  return html;
}

function showDetail(title, body, meta) {

/* ═══ Hexdump section ═══ */
function renderHexdump() {
  const hd = document.getElementById("hexBody");
  if (!hd) return;
  const data = (DATA.hexdump && DATA.hexdump.bytes) ? DATA.hexdump.bytes : null;
  const base = (DATA.hexdump && DATA.hexdump.base != null) ? DATA.hexdump.base : 0;
  if (!data || !data.length) {
    hd.innerHTML = '<div class="dt-empty">No hexdump data available for this sample.</div>';
    return;
  }
  const rows = [];
  const perRow = 16;
  for (let i = 0; i < data.length; i += perRow) {
    const chunk = data.slice(i, i + perRow);
    const addr = base + i;
    const hex = chunk.map(b => b.toString(16).padStart(2, "0")).join(" ");
    const ascii = chunk.map(b => (b >= 0x20 && b <= 0x7e) ? String.fromCharCode(b) : ".").join("");
    rows.push({addr, hex, ascii});
  }
  const max = rows.length;
  let html = '<div class="hex-head"><span>Addr</span><span>Hex (16 bytes/row)</span><span>ASCII</span></div>';
  for (const r of rows) {
    html += '<div class="hexrow">' +
      '<span class="h-addr">' + HEX(r.addr) + '</span>' +
      '<span class="h-hex">' + r.hex + '</span>' +
      '<span class="h-ascii">' + r.ascii + '</span>' +
      '</div>';
  }
  hd.innerHTML = html;
  document.getElementById("hexInfo").textContent = max + " rows  ·  " + data.length.toLocaleString() + " bytes  ·  base " + HEX(base);
  const copyBtn = document.getElementById("copyHex");
  if (copyBtn) copyBtn.onclick = () => {
    const text = Array.from(document.querySelectorAll("#hexBody .hexrow")).map(r => r.textContent).join("\n");
    navigator.clipboard.writeText(text).then(() => {
      copyBtn.classList.add("copied");
      copyBtn.textContent = "\u2713 Copied";
      setTimeout(() => {
        copyBtn.classList.remove("copied");
        copyBtn.textContent = "Copy All";
      }, 1500);
    });
  };
}
(function () {
  const hexEl = document.getElementById("hexBody");
  if (!hexEl) return;
  window.addEventListener("load", () => { renderHexdump(); });
})();

/* ═══ External tooling: xxd dump (colourised zones + copy) ═══ */
function renderXxd() {
  const el = document.getElementById("xxdBody");
  if (!el) return;
  const raw = el.textContent || "";
  if (!raw.trim()) { el.textContent = "No xxd output available."; return; }

  // xxd rows look like: "00000000: 4d 5a ... ff 00  |MZ....|"
  // Colour three zones separately: offset (yellow), bytes (green), ASCII (fg).
  const frag = document.createDocumentFragment();
  const lines = raw.replace(/\n$/, "").split("\n");
  for (const line of lines) {
    const row = document.createElement("div");
    row.className = "hexrow";
    const colon = line.indexOf(":");
    if (colon === -1) {
      row.textContent = line;
    } else {
      const off = document.createElement("span");
      off.style.color = "var(--yellow)";
      off.textContent = line.slice(0, colon + 1);
      row.appendChild(off);

      const firstPipe = line.indexOf("|", colon + 1);
      const lastPipe = line.lastIndexOf("|");
      if (firstPipe === -1 || lastPipe === firstPipe) {
        const rest = document.createElement("span");
        rest.style.color = "var(--green)";
        rest.textContent = line.slice(colon + 1);
        row.appendChild(rest);
      } else {
        const bytes = document.createElement("span");
        bytes.style.color = "var(--green)";
        bytes.textContent = line.slice(colon + 1, firstPipe);
        row.appendChild(bytes);

        const bar1 = document.createElement("span");
        bar1.style.color = "var(--cyan)";
        bar1.textContent = "|";
        row.appendChild(bar1);

        const ascii = document.createElement("span");
        ascii.style.color = "var(--fg)";
        ascii.textContent = line.slice(firstPipe + 1, lastPipe);
        row.appendChild(ascii);

        const bar2 = document.createElement("span");
        bar2.style.color = "var(--cyan)";
        bar2.textContent = "|";
        row.appendChild(bar2);

        if (lastPipe + 1 < line.length) {
          const tail = document.createElement("span");
          tail.style.color = "var(--dim)";
          tail.textContent = line.slice(lastPipe + 1);
          row.appendChild(tail);
        }
      }
    }
    frag.appendChild(row);
  }
  el.textContent = "";
  el.appendChild(frag);

  const btn = document.getElementById("copyXxd");
  if (btn && !btn.dataset.wired) {
    btn.dataset.wired = "1";
    btn.addEventListener("click", () => {
      navigator.clipboard && navigator.clipboard.writeText(raw);
      btn.textContent = "✓ Copied";
      setTimeout(() => { btn.classList.remove("copied"); btn.textContent = "Copy Preview"; }, 1500);
    });
  }
}
(function () {
  if (!document.getElementById("xxdBody")) return;
  window.addEventListener("load", () => { try { renderXxd(); } catch (e) { console.error("xxd render failed", e); } });
})();

/* ═══════════════════════════════════════════════════════════════════════════
   IOC threat map — real geography, fully offline
   ───────────────────────────────────────────────────────────────────────────
   Bubble = a country the CTI providers (or, as a clearly labelled fallback, the
   ccTLD) placed at least one IOC in. Country outlines come from the vendored
   world-atlas TopoJSON, so nothing is fetched at view time (file:// safe).
   ═══════════════════════════════════════════════════════════════════════════ */
const VCOLOR = {malicious:"#ff4d5e",suspicious:"#ff9f43",unknown:"#22d3ee",
                benign:"#2ee6a8",informational:"#4d8dff"};
const VRANK = {malicious:3,suspicious:2,unknown:1,benign:0,informational:0};
const KIND_SHORT = {ip:"ip",domain:"dom",url:"url",email:"mail"};
function vColor(v) { return VCOLOR[v] || VCOLOR.unknown; }
function vRank(v) { return VRANK[v] == null ? 1 : VRANK[v]; }

let threatView = "geo", geoKind = "all", geoZoom = null;
let _worldFC = null, _ctry = null, _ctryRev = {};
let geoState = {rows: [], items: [], arcs: [], pos: {}};

/* Vendored table: alpha-2 -> {n: name, c3: iso numeric, ll: [lon, lat]}. */
function loadAssets() {
  if (!_ctry) {
    try { _ctry = JSON.parse(document.getElementById("countries").textContent || "{}"); }
    catch (e) { _ctry = {}; }
    _ctry.codes = _ctry.codes || {};
    for (const cc in _ctry.codes) {
      const c3 = String(parseInt(_ctry.codes[cc].c3, 10));
      if (c3 && c3 !== "NaN") _ctryRev[c3] = cc;
    }
  }
  return _ctry;
}
function ccName(cc) { loadAssets(); const c = _ctry.codes[cc]; return c && c.n ? c.n : cc; }
function ccLatLon(cc) { loadAssets(); const c = _ctry.codes[cc]; return (c && c.ll) ? c.ll : null; }
function ccOfFeature(f) {
  if (f == null || f.id == null) return "";
  return _ctryRev[String(parseInt(f.id, 10))] || "";
}

/* Minimal TopoJSON -> GeoJSON decoder (only what world-atlas emits:
   MultiPolygon/Polygon with quantized, delta-encoded arcs). */
function decodeTopo(topo) {
  const objs = topo && topo.objects ? topo.objects : {};
  const obj = objs.countries || objs.land || objs.landm;
  if (!obj || !obj.geometries) return {type: "FeatureCollection", features: []};
  const tr = topo.transform || {};
  const sc = tr.scale || [1, 1], tl = tr.translate || [0, 0];
  const arcs = (topo.arcs || []).map(a => {
    let x = 0, y = 0;
    return a.map(p => {
      x += p[0]; y += p[1];
      return [x * sc[0] + tl[0], y * sc[1] + tl[1]];
    });
  });
  const getArc = i => (i < 0 ? arcs[~i].slice().reverse() : arcs[i]);
  const ring = idxs => {
    const out = [];
    for (const i of idxs) {
      const a = getArc(i);
      for (let k = out.length ? 1 : 0; k < a.length; k++) out.push(a[k]);
    }
    return out;
  };
  const geom = g => {
    if (!g || !g.arcs) return null;
    if (g.type === "Polygon") return {type: "Polygon", coordinates: g.arcs.map(ring)};
    if (g.type === "MultiPolygon") return {type: "MultiPolygon", coordinates: g.arcs.map(p => p.map(ring))};
    return null;
  };
  const features = [];
  for (const g of obj.geometries) {
    const geometry = geom(g);
    if (geometry) features.push({type: "Feature", id: g.id,
                                 properties: g.properties || {}, geometry: geometry});
  }
  return {type: "FeatureCollection", features: features};
}

/* Aggregate the payload's IOC records per country honouring the kind filter. */
function geoBuild() {
  const all = ((DATA.geo || {}).items) || [];
  const items = all.filter(it => geoKind === "all" || it.kind === geoKind);
  const byCc = {};
  for (const it of items) {
    const g = byCc[it.cc] || (byCc[it.cc] = {cc: it.cc, n: 0, worst: "unknown",
                                             kinds: {}, items: [], asns: []});
    g.n++;
    g.items.push(it);
    g.kinds[it.kind] = (g.kinds[it.kind] || 0) + 1;
    if (vRank(it.verdict) > vRank(g.worst)) g.worst = it.verdict;
    const asn = (it.asn || "") + " " + (it.asn_name || "");
    if (it.asn && g.asns.indexOf(asn.trim()) < 0) g.asns.push(asn.trim());
  }
  const rows = Object.keys(byCc).map(k => byCc[k])
    .sort((a, b) => b.n - a.n || (a.cc < b.cc ? -1 : 1));

  const byAsn = {}, seen = {}, arcs = [];
  for (const it of items) {
    if (!it.asn) continue;
    (byAsn[it.asn] = byAsn[it.asn] || {})[it.cc] = 1;
  }
  for (const asn in byAsn) {
    const ccs = Object.keys(byAsn[asn]).sort();
    for (let i = 0; i < ccs.length; i++)
      for (let j = i + 1; j < ccs.length; j++) {
        const key = ccs[i] + "|" + ccs[j];
        if (seen[key]) { if (seen[key].asns.indexOf(asn) < 0) seen[key].asns.push(asn); continue; }
        seen[key] = {a: ccs[i], b: ccs[j], asns: [asn]};
        arcs.push(seen[key]);
      }
  }
  geoState = {rows: rows, items: items, arcs: arcs, pos: {}};
  return geoState;
}

/* ═══ Threat Map: info graph (VT-style D3 force) ═══ */
let threatFilter = "all";



/* View switch: geo map (default) or the info-block graph. */
function drawThreat() {
  const geoBox = document.getElementById("viewGeo");
  const infoBox = document.getElementById("viewInfo");
  if (geoBox) geoBox.style.display = threatView === "geo" ? "block" : "none";
  if (infoBox) infoBox.style.display = threatView === "info" ? "block" : "none";
  if (threatView === "geo") drawGeo(); else drawInfoGraph();
}

/* Map view tabs + IOC-kind filter chips + reset. */
document.querySelectorAll(".mtab").forEach(btn => {

<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Threat Dashboard — {{ payload.meta.stem }}</title>
<style>
:root{
  --bg:#0a0e16;--bg2:#0e1420;--panel:#111a2a;--panel2:#162036;
  --line:#1c2a44;--line2:#284066;
  --fg:#e2eaf6;--dim:#6b7f9e;--accent:#4d8dff;--cyan:#22d3ee;
  --red:#ff4d5e;--orange:#ff9f43;--yellow:#ffd166;--green:#2ee6a8;
  --purple:#a78bfa;--pink:#f472b6;
  --mono:'Ubuntu Mono','JetBrains Mono',Consolas,monospace;
  --ui:'Ubuntu Mono','JetBrains Mono',Consolas,monospace;
  --base:17px;
  --c-ctrl:#ff9f43;--c-call:#22d3ee;--c-ret:#ff4d5e;--c-data:#7aa2ff;--c-arith:#34d399;--c-cmp:#f472b6;--c-stack:#a78bfa;--c-simd:#c084fc;--c-nop:#4b5b74;--c-misc:#8b9cb5;
  --r:10px;--rs:7px;
  --shadow:0 8px 32px rgba(0,0,0,.45);
  --tr:all .2s cubic-bezier(.4,0,.2,1);
  --glow-1:rgba(77,141,255,.16);--glow-2:rgba(34,211,238,.11);--glow-3:rgba(167,139,250,.09);
  --grid-line:rgba(140,175,230,.05);
  --panel-sheen:rgba(255,255,255,.045);
  --header-blur:14px;
}
[data-theme=light]{
  --bg:#eef1f6;--bg2:#f8fafc;--panel:#fff;--panel2:#f1f5f9;
  --line:#d8e1ee;--line2:#b8c8de;
  --fg:#1e293b;--dim:#64748b;--accent:#2563eb;--cyan:#0891b2;
  --red:#dc2626;--orange:#d97706;--yellow:#ca8a04;--green:#059669;
  --purple:#7c3aed;--pink:#db2777;
  --shadow:0 8px 32px rgba(0,0,0,.1);
  --glow-1:rgba(37,99,235,.09);--glow-2:rgba(8,145,178,.07);--glow-3:rgba(124,58,237,.06);
  --grid-line:rgba(30,55,95,.035);
  --panel-sheen:rgba(255,255,255,.6);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:
    radial-gradient(ellipse 900px 560px at 8% -8%, var(--glow-1), transparent 60%),
    radial-gradient(ellipse 680px 480px at 92% 4%, var(--glow-2), transparent 58%),
    radial-gradient(ellipse 760px 620px at 50% 112%, var(--glow-3), transparent 62%),
    linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0/46px 46px,
    linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0/46px 46px,
    var(--bg);
  background-attachment:fixed,fixed,fixed,fixed,fixed,fixed;
  color:var(--fg);font:17px/1.6 'Ubuntu Mono','JetBrains Mono',Consolas,monospace;min-height:100vh}
a{color:var(--accent);text-decoration:none}
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--line2);border-radius:3px}

header{display:flex;align-items:center;gap:14px;padding:14px 24px;background:linear-gradient(180deg,rgba(14,20,32,.94),rgba(14,20,32,.86));backdrop-filter:blur(var(--header-blur));-webkit-backdrop-filter:blur(var(--header-blur));border-bottom:1px solid var(--line);position:sticky;top:0;z-index:50;flex-wrap:wrap;box-shadow:0 1px 0 rgba(255,255,255,.03) inset,0 14px 28px -20px rgba(0,0,0,.65)}
[data-theme=light] header{background:linear-gradient(180deg,rgba(248,250,252,.94),rgba(248,250,252,.86))}
header::after{content:'';position:absolute;left:0;right:0;bottom:-1px;height:1px;background:linear-gradient(90deg,transparent,rgba(34,211,238,.45),transparent);pointer-events:none}
header h1{font-size:17px;font-weight:700;background:linear-gradient(135deg,var(--fg),var(--cyan));-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
.sha{font-family:var(--mono);font-size:13px;color:var(--cyan);background:rgba(34,211,238,.07);padding:3px 9px;border-radius:5px;border:1px solid rgba(34,211,238,.15);max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.badge{padding:4px 13px;border-radius:20px;font-size:13px;font-weight:700;text-transform:uppercase;letter-spacing:.7px}
.badge.clean{background:rgba(46,230,168,.1);color:var(--green);border:1px solid rgba(46,230,168,.3);box-shadow:0 0 14px -4px rgba(46,230,168,.35)}
.badge.suspicious{background:rgba(255,209,102,.1);color:var(--yellow);border:1px solid rgba(255,209,102,.3);box-shadow:0 0 14px -4px rgba(255,209,102,.35)}
.badge.malicious{background:rgba(255,77,94,.1);color:var(--red);border:1px solid rgba(255,77,94,.3);box-shadow:0 0 14px -4px rgba(255,77,94,.4)}
.score{margin-left:auto;font-family:var(--mono);font-size:32px;font-weight:800;color:var(--fg);text-shadow:0 0 18px rgba(77,141,255,.35)}
.score small{display:block;font-size:11px;color:var(--dim);letter-spacing:2px;font-weight:400}
.hbtn{background:none;border:1px solid var(--line);color:var(--dim);width:34px;height:34px;border-radius:var(--rs);cursor:pointer;font-size:18px;display:flex;align-items:center;justify-content:center;transition:var(--tr);flex-shrink:0}
.hbtn:hover{border-color:var(--accent);color:var(--accent);background:rgba(77,141,255,.08)}

nav{display:flex;gap:2px;padding:0 24px;background:linear-gradient(180deg,rgba(14,20,32,.9),rgba(14,20,32,.82));backdrop-filter:blur(var(--header-blur));-webkit-backdrop-filter:blur(var(--header-blur));border-bottom:1px solid var(--line);position:sticky;top:57px;z-index:40;overflow-x:auto;scrollbar-width:none}
[data-theme=light] nav{background:linear-gradient(180deg,rgba(248,250,252,.9),rgba(248,250,252,.82))}
nav::-webkit-scrollbar{display:none}
nav button{background:none;border:none;color:var(--dim);padding:11px 16px;cursor:pointer;font-size:16px;font-weight:500;border-bottom:2px solid transparent;white-space:nowrap;font-family:inherit;transition:var(--tr);position:relative}
nav button:hover{color:var(--fg);background:rgba(77,141,255,.04)}
nav button.on{color:var(--cyan);border-bottom-color:var(--cyan);background:rgba(34,211,238,.06)}

main{padding:24px;max-width:1500px;margin:0 auto}
section{display:none;animation:fadeIn .3s ease}
section.on{display:block}
@keyframes fadeIn{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}

.grid{display:grid;gap:16px}
.g2{grid-template-columns:repeat(auto-fit,minmax(320px,1fr))}

.card{background:linear-gradient(165deg,var(--panel) 0%,var(--panel2) 150%);border:1px solid var(--line);border-radius:var(--r);padding:18px 20px;transition:var(--tr);position:relative;overflow:hidden}
.card::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 18% -15%,var(--panel-sheen),transparent 55%);pointer-events:none}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--accent),var(--cyan));opacity:0;transition:var(--tr);z-index:1}
.card:hover{border-color:var(--line2);box-shadow:var(--shadow),0 0 0 1px rgba(77,141,255,.06)}
.card:hover::before{opacity:1}
.card h3{margin:0 0 14px;font-size:13px;text-transform:uppercase;letter-spacing:1.2px;color:var(--dim);font-weight:600;display:flex;align-items:center;gap:8px}
.card h3::before{content:'';width:3px;height:13px;background:var(--accent);border-radius:2px;flex-shrink:0}

.kv{display:flex;justify-content:space-between;gap:12px;padding:7px 0;border-bottom:1px solid var(--line);align-items:center;transition:var(--tr)}
.kv:hover{background:rgba(77,141,255,.03)}
.kv:last-child{border-bottom:none}
.kv span:first-child{color:var(--dim);font-size:16px}
.kv span:last-child{font-family:var(--mono);text-align:right;word-break:break-all;font-size:16px;font-weight:500}

table{width:100%;border-collapse:collapse;font-size:16px}
th,td{text-align:left;padding:7px 11px;border-bottom:1px solid var(--line)}
th{color:var(--dim);font-weight:600;text-transform:uppercase;font-size:12px;letter-spacing:.7px;background:rgba(77,141,255,.02);position:sticky;top:0}
tr:hover td{background:rgba(77,141,255,.04)}
.mono{font-family:var(--mono)}
.chip{display:inline-block;padding:3px 9px;border-radius:11px;background:rgba(77,141,255,.1);color:#8ab4ff;font-size:13px;margin:2px 3px 2px 0;font-family:var(--mono);transition:var(--tr);cursor:pointer;border:1px solid transparent}
.chip:hover{background:rgba(77,141,255,.18);border-color:rgba(77,141,255,.3)}
.chip.red{background:rgba(255,77,94,.1);color:#ff9aa4;border-color:rgba(255,77,94,.2)}
.chip.yellow{background:rgba(255,209,102,.1);color:#ffe39a;border-color:rgba(255,209,102,.2)}
.chip.green{background:rgba(46,230,168,.08);color:#8df0cd;border-color:rgba(46,230,168,.2)}
.chip.purple{background:rgba(167,139,250,.1);color:#c4b5fd;border-color:rgba(167,139,250,.2)}
.chip.orange{background:rgba(255,159,67,.1);color:#ffd29a;border-color:rgba(255,159,67,.2)}

.bar{height:7px;background:var(--line);border-radius:4px;overflow:hidden;min-width:55px}
.bar>i{display:block;height:100%;background:linear-gradient(90deg,var(--accent),var(--cyan));border-radius:4px;transition:width .5s ease}
.bar.hot>i{background:linear-gradient(90deg,var(--orange),var(--red))}

.stats-row{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:22px}
.stat-card{background:linear-gradient(165deg,var(--panel) 0%,var(--panel2) 150%);border:1px solid var(--line);border-radius:var(--r);padding:16px 18px;text-align:center;transition:var(--tr);position:relative;overflow:hidden}
.stat-card::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 20% -20%,var(--panel-sheen),transparent 55%);pointer-events:none}
.stat-card:hover{border-color:var(--line2);box-shadow:var(--shadow);transform:translateY(-2px)}
.stat-card .sv{font-size:32px;font-weight:800;font-family:var(--mono);color:var(--fg)}
.stat-card .sl{font-size:12px;text-transform:uppercase;letter-spacing:1px;color:var(--dim);margin-top:3px}
.stat-card .si{font-size:22px;margin-bottom:4px;opacity:.7}

.search{width:100%;padding:9px 13px;background:var(--bg);border:1px solid var(--line);border-radius:var(--rs);color:var(--fg);font-family:var(--mono);font-size:16px;transition:var(--tr);outline:none}
.search:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(77,141,255,.12)}
.search::placeholder{color:var(--dim)}
.note{color:var(--dim);font-size:16px;line-height:1.65;margin:10px 0 0;max-width:70ch}
.note code{font-family:var(--mono);background:var(--panel2);border:1px solid var(--line);border-radius:4px;padding:1px 5px;font-size:15px}

.tree{max-height:70vh;overflow:auto}
.tree details{border-bottom:1px solid var(--line);transition:var(--tr)}
.tree details:hover{border-bottom-color:var(--line2)}
.tree summary{cursor:pointer;padding:9px 5px;font-family:var(--mono);color:#a8c4e8;font-size:16px;display:flex;align-items:center;gap:7px;transition:var(--tr);list-style:none}
.tree summary::-webkit-details-marker{display:none}
.tree summary::before{content:'▶';font-size:11px;transition:transform .2s;flex-shrink:0;color:var(--dim)}
.tree details[open] summary::before{transform:rotate(90deg)}
.tree summary:hover{color:var(--cyan);background:rgba(34,211,238,.03)}
.tree .imp{padding:2px 0 2px 28px;font-family:var(--mono);font-size:15px;color:#7a8fa8;transition:var(--tr)}
.tree .imp.flag{color:var(--red);font-weight:600;background:rgba(255,77,94,.04);padding:2px 6px;border-radius:4px;margin:1px 0}

.asmbar{display:flex;gap:10px;align-items:center;margin-bottom:12px;flex-wrap:wrap}
.asmbar select,.asmbar input{padding:8px 11px;background:var(--bg);border:1px solid var(--line);border-radius:var(--rs);color:var(--fg);font-family:var(--mono);font-size:16px;transition:var(--tr);outline:none}
.asmbar select:focus,.asmbar input:focus{border-color:var(--accent)}
.asmbar select{min-width:200px}
#asm{height:64vh;overflow:auto;background:var(--bg);border:1px solid var(--line);border-radius:var(--r);font-family:var(--mono);font-size:16px;line-height:26px}
.asmrow{display:grid;grid-template-columns:5px 104px 132px 30px minmax(0,1fr) 48px;gap:10px;align-items:center;min-height:28px;height:28px;padding:0 13px;white-space:pre;transition:var(--tr);box-sizing:border-box}
.asmrow:hover{background:rgba(77,141,255,.06);padding-left:17px;padding-right:17px}
.asmrow.head{display:block;height:28px;line-height:28px;background:rgba(34,211,238,.05);color:var(--cyan);border-top:1px solid var(--line);border-bottom:1px solid var(--line);font-weight:600;padding:0 13px}
.adr{color:#4f6380}
.byt{color:#37517a}
.mn{color:#dce7f5}
.t-call{color:var(--cyan)}
.t-jmp,.t-cjmp,.t-ujmp{color:var(--orange)}
.t-ret{color:var(--red)}
.t-mov,.t-lea{color:#7aa2ff}
.op-imm{color:var(--yellow)}
.tgt{color:var(--purple);cursor:pointer;text-decoration:underline dotted}
.tgt:hover{color:#fff}
.imp-call{color:var(--red);font-weight:600}

.warn{padding:11px 15px;border-radius:var(--rs);background:rgba(255,159,67,.06);border:1px solid rgba(255,159,67,.25);color:#ffcf9a;margin-bottom:14px;font-size:16px;display:flex;align-items:center;gap:9px}
.warn::before{content:'⚠';flex-shrink:0}

svg.graph{width:100%;background:radial-gradient(ellipse at 50% 40%,rgba(77,141,255,.05),transparent 70%),var(--bg);border:1px solid var(--line);border-radius:var(--r);cursor:grab;transition:var(--tr)}
svg.graph:hover{border-color:var(--line2)}
svg.graph:active{cursor:grabbing}

#detail{position:fixed;right:0;top:0;bottom:0;width:min(440px,100vw);background:rgba(14,20,32,.98);backdrop-filter:blur(14px);border-left:1px solid var(--line);display:flex;flex-direction:column;z-index:120;box-shadow:-12px 0 40px rgba(0,0,0,.5);transform:translateX(105%);transition:transform .28s cubic-bezier(.4,0,.2,1);visibility:hidden}
#detail.open{transform:none;visibility:visible}
#detailHead{display:flex;align-items:flex-start;gap:10px;padding:16px 18px 12px;border-bottom:1px solid var(--line);flex-shrink:0}
#detailHead .dt-badge{font-size:12px;font-weight:700;letter-spacing:.8px;text-transform:uppercase;padding:3px 9px;border-radius:12px;border:1px solid;white-space:nowrap;margin-top:2px}
#detailHead .dt-title{flex:1;font-size:18px;font-weight:700;color:var(--fg);word-break:break-all;line-height:1.35}
#detailHead .dt-sub{display:block;font-size:13px;color:var(--dim);font-weight:400;margin-top:3px;font-family:var(--mono)}
#detailHead .dt-x{background:none;border:1px solid var(--line);color:var(--dim);width:28px;height:28px;border-radius:6px;cursor:pointer;font-size:18px;flex-shrink:0;transition:var(--tr)}
#detailHead .dt-x:hover{border-color:var(--red);color:var(--red)}
#detailBody{flex:1;overflow-y:auto;padding:14px 18px 24px;font-size:12.5px;line-height:1.55}
#detailBody .dt-sect{font-size:12px;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;color:var(--dim);margin:16px 0 8px;display:flex;align-items:center;gap:8px}
#detailBody .dt-sect:first-child{margin-top:0}
#detailBody .dt-sect::after{content:"";flex:1;height:1px;background:var(--line)}
#detailBody .dt-kv{display:flex;justify-content:space-between;gap:12px;padding:5px 0;border-bottom:1px solid rgba(28,42,68,.5);font-size:15px}
#detailBody .dt-kv:last-child{border-bottom:none}
#detailBody .dt-kv .k{color:var(--dim);flex-shrink:0}
#detailBody .dt-kv .v{color:var(--fg);font-family:var(--mono);text-align:right;word-break:break-all}
#detailBody .dt-chip{display:inline-block;padding:3px 8px;margin:3px 4px 0 0;border-radius:6px;background:var(--panel2);border:1px solid var(--line);font-size:13px;font-family:var(--mono);color:var(--fg)}
#detailBody .dt-chip.flag{border-color:rgba(255,77,94,.45);color:var(--red);background:rgba(255,77,94,.08)}
#detailBody .dt-empty{color:var(--dim);font-style:italic;padding:8px 0}
#detailBody .dt-list{margin:0;padding:0;list-style:none}
#detailBody .dt-list li{padding:6px 0;border-bottom:1px solid rgba(28,42,68,.5);font-size:15px}
#detailBody .dt-list li:last-child{border-bottom:none}
#detailBody .dt-list .li-main{font-family:var(--mono);color:var(--cyan);font-size:15px}
#detailBody .dt-list .li-sub{color:var(--dim);font-size:13px;margin-top:2px}
#detailBody .dt-desc{color:var(--fg);background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:10px 12px;font-size:15px;line-height:1.55;margin-top:6px}
#detailBody .dt-attacks{display:flex;flex-wrap:wrap;gap:5px;margin-top:6px}
#detailBody .dt-attacks span{background:rgba(255,77,94,.1);border:1px solid rgba(255,77,94,.3);color:var(--red);padding:2px 8px;border-radius:10px;font-size:12px;font-weight:600}
#detailBody code{font-family:var(--mono);font-size:13px;background:var(--panel2);padding:1px 5px;border-radius:4px;color:var(--cyan);word-break:break-all}

.legend{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:6px 14px;margin-top:12px;font-size:11.5px;color:var(--dim)}
.legend .li{display:flex;align-items:center;gap:6px}
.legend .ld{width:8px;height:8px;border-radius:50%;flex-shrink:0}

/* ═══ ATT&CK / STIX section ═══ */
.sx-matrix{display:grid;gap:9px;grid-auto-flow:column;grid-auto-columns:minmax(178px,1fr);overflow-x:auto;padding-bottom:6px}
/* ═══ ATT&CK tactics: procedures, tooling, detection guidance ═══ */
.tk-wrap{display:grid;gap:10px}
.tk-filters{display:flex;flex-wrap:wrap;gap:7px;align-items:center;background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:9px 11px}
.tk-filters input[type=search]{flex:1;min-width:190px}
.tk-chips{display:flex;flex-wrap:wrap;gap:5px}
.tk-chip{padding:4px 10px;border-radius:13px;font-size:11.5px;cursor:pointer;user-select:none;
  background:var(--panel);border:1px solid var(--line);color:var(--dim);font-weight:600;transition:var(--tr)}
.tk-chip:hover{border-color:var(--accent);color:var(--fg)}
.tk-chip.on{background:rgba(46,230,168,.13);border-color:rgba(46,230,168,.5);color:#2ee6a8}
.tk-chip.tk-tools.on{background:rgba(46,230,168,.13);border-color:rgba(46,230,168,.5);color:#2ee6a8}
.tk-chip.tk-malware.on{background:rgba(255,77,94,.13);border-color:rgba(255,77,94,.5);color:var(--red)}
.tk-chip.tk-groups.on{background:rgba(255,209,102,.14);border-color:rgba(255,209,102,.5);color:#ffd166}
.tk-chip.tk-detect.on{background:rgba(122,162,247,.15);border-color:rgba(122,162,247,.5);color:#7aa2f7}
.tk-reset{margin-left:auto;padding:4px 10px;border-radius:7px;font-size:11.5px;cursor:pointer;
  background:transparent;border:1px solid var(--line);color:var(--dim)}
.tk-reset:hover{border-color:var(--red);color:var(--red)}
.tk-count{font-size:11.5px;color:var(--dim);white-space:nowrap}
.tk-tac{border:1px solid var(--line);border-radius:9px;background:var(--panel2);overflow:hidden}
.tk-tachead{display:flex;align-items:center;gap:9px;padding:8px 11px;cursor:pointer;background:var(--panel)}
.tk-tachead:hover{border-color:var(--accent)}
.tk-tacname{font-size:12.5px;font-weight:700;color:var(--cyan);text-transform:uppercase;letter-spacing:.5px}
.tk-tacmeta{font-size:11.5px;color:var(--dim);margin-left:auto;white-space:nowrap}
.tk-caret{color:var(--dim);font-size:11px;transition:var(--tr)}
.tk-tac.open .tk-caret{transform:rotate(90deg)}
.tk-tacbody{display:none;padding:9px 11px 11px;gap:7px;flex-direction:column}
.tk-tac.open .tk-tacbody{display:flex}
.tk-proc{border:1px solid var(--line);border-radius:8px;background:var(--panel);padding:9px 11px}
.tk-prochead{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap}
.tk-pid{font-family:var(--mono);font-size:12.5px;font-weight:700;color:#ff9f43}
.tk-pname{font-size:13px;font-weight:600}
.tk-sub{font-size:10px;background:rgba(167,139,250,.14);border:1px solid rgba(167,139,250,.4);color:#a78bfa;padding:1px 6px;border-radius:9px}
.tk-hits{font-size:10.5px;background:rgba(255,209,102,.14);border:1px solid rgba(255,209,102,.4);color:#ffd166;padding:1px 6px;border-radius:9px;white-space:nowrap}
.tk-row{display:flex;gap:7px;align-items:baseline;font-size:12px;margin-top:5px;line-height:1.5}
.tk-lbl{flex:0 0 60px;font-size:10.5px;text-transform:uppercase;letter-spacing:.4px;color:var(--dim);font-weight:700}
.tk-lbl.tools{color:#2ee6a8}
.tk-lbl.malware{color:var(--red)}
.tk-lbl.groups{color:#ffd166}
.tk-lbl.detect{color:#7aa2f7}
.tk-vals{display:flex;flex-wrap:wrap;gap:4px}
.tk-val{font-size:11.5px;padding:1px 7px;border-radius:5px;background:var(--panel2);border:1px solid var(--line)}
.tk-val.tools{color:#2ee6a8;border-color:rgba(46,230,168,.35)}
.tk-val.malware{color:var(--red);border-color:rgba(255,77,94,.35)}
.tk-val.groups{color:#ffd166;border-color:rgba(255,209,102,.35)}
.tk-val.id{font-family:var(--mono);font-size:10.5px;color:var(--dim)}
.tk-more{font-size:11px;color:var(--dim);font-style:italic}
.tk-det{font-size:11.5px;color:var(--fg);line-height:1.55;background:rgba(122,162,247,.06);border-left:2px solid rgba(122,162,247,.45);padding:5px 9px;border-radius:0 6px 6px 0}
.tk-detname{font-size:11px;color:#7aa2f7;font-weight:600;display:block;margin-bottom:2px}
.tk-none{font-size:11.5px;color:var(--dim);font-style:italic}
.tk-empty{padding:26px;text-align:center;color:var(--dim);font-size:13px}
@media (max-width:820px){.tk-lbl{flex-basis:100%}.tk-reset{margin-left:0}}
.sx-tac{background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:9px}
.sx-tac h4{font-size:11.5px;text-transform:uppercase;letter-spacing:.55px;color:var(--dim);margin-bottom:7px;display:flex;justify-content:space-between;gap:6px}
.sx-tac h4 b{color:var(--accent)}
.sx-tech{display:block;width:100%;text-align:left;margin-bottom:4px;padding:5px 7px;font-size:12px;cursor:pointer;
  background:rgba(255,159,67,.1);border:1px solid rgba(255,159,67,.32);border-radius:6px;color:var(--fg);font-family:var(--mono);transition:var(--tr)}
.sx-tech:hover{background:rgba(255,159,67,.2);border-color:var(--orange)}
.sx-tech code{color:var(--orange);font-weight:700;margin-right:4px}
.sx-tech.dim{opacity:.4}
.sx-graph{background:var(--panel2);border:1px solid var(--line);border-radius:9px;overflow:hidden}
.sx-graph svg{display:block;width:100%;height:620px;cursor:grab}
.sx-graph svg:active{cursor:grabbing}
.sx-node circle{stroke:var(--bg);stroke-width:1.5px;cursor:pointer}
.sx-node text{font-size:10.5px;fill:var(--fg);pointer-events:none}
.sx-node.dim{opacity:.15}
.sx-node.hit circle{stroke:var(--yellow);stroke-width:2.5px}
.sx-link{stroke:var(--line2);stroke-width:1.1px;fill:none}
.sx-linklabel{font-size:9.5px;fill:var(--dim);text-anchor:middle;pointer-events:none;
  font-family:var(--mono);text-shadow:0 0 4px var(--panel2),0 0 4px var(--panel2),0 0 4px var(--panel2)}
.sx-toolbar{display:flex;gap:7px;flex-wrap:wrap;align-items:center;margin-bottom:10px}
/* Own tab class, not .mtab: the map-view handler binds every .mtab on the page
   to drawThreat(), which would fire for these too. */
.sxtab{background:var(--panel);border:1px solid var(--line);color:var(--dim);padding:7px 15px;border-radius:8px;cursor:pointer;font-size:15px;font-family:var(--mono);transition:var(--tr)}
.sxtab:hover{color:var(--fg);border-color:var(--line2)}
.sxtab.on{background:rgba(34,211,238,.09);border-color:var(--cyan);color:var(--cyan)}
.sx-toolbar input{font-family:var(--mono);font-size:13px;background:var(--panel);color:var(--fg);
  border:1px solid var(--line2);border-radius:6px;padding:6px 10px;min-width:200px}
.sx-toolbar input:focus{outline:none;border-color:var(--accent)}
.sx-note{color:var(--dim);font-size:11.5px;margin-top:9px;line-height:1.6}
/* D3FEND: one block per ATT&CK technique, chips for the countermeasures. */
.d3f-tech{background:var(--panel);border:1px solid var(--line);border-radius:7px;padding:7px 8px;margin-bottom:6px}
.d3f-tech h5{font-size:12.5px;font-family:var(--mono);color:var(--fg);margin-bottom:5px;font-weight:600}
.d3f-tech h5 code{color:var(--orange);font-weight:700;margin-right:5px}
.d3f-tech h5 span{color:var(--dim);font-weight:400}
.d3f-chip{display:inline-flex;align-items:baseline;gap:5px;background:rgba(34,211,238,.08);
  border:1px solid rgba(34,211,238,.3);border-radius:12px;padding:3px 9px;margin:0 5px 5px 0;
  font-size:11.5px;color:var(--fg);cursor:default}
.d3f-chip b{color:var(--cyan);font-family:var(--mono);font-weight:700}
.d3f-chip i{font-style:normal;color:var(--dim);font-size:10.5px}
.d3f-chip .d3f-rel{color:var(--dim);font-size:10.5px}
.d3f-chip .d3f-rel em{font-style:normal;color:var(--green)}
.d3f-none{font-size:11.5px;color:var(--dim);font-style:italic}

.copy-btn{background:none;border:1px solid var(--line);color:var(--dim);padding:3px 8px;border-radius:5px;cursor:pointer;font-size:13px;font-family:var(--mono);transition:var(--tr);margin-left:8px}
.copy-btn:hover{border-color:var(--accent);color:var(--accent);background:rgba(77,141,255,.06)}
.copy-btn.copied{border-color:var(--green);color:var(--green)}

.pi{font-size:15px;color:var(--dim);padding:0 0 14px;display:flex;align-items:center;gap:8px}
.pi span{color:var(--accent);font-weight:600}

.threat-controls{display:flex;gap:7px;align-items:center;flex-wrap:wrap;margin-bottom:14px}
.fbtn{background:var(--panel);border:1px solid var(--line);color:var(--dim);padding:5px 13px;border-radius:14px;cursor:pointer;font-size:13px;font-family:var(--mono);transition:var(--tr)}
.fbtn:hover{border-color:var(--accent);color:var(--fg)}
.fbtn.active{background:rgba(77,141,255,.12);border-color:var(--accent);color:var(--cyan)}

.chart-row{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}
.chart-row.single{grid-template-columns:1fr}
.chart-box{background:linear-gradient(165deg,var(--panel) 0%,var(--panel2) 150%);border:1px solid var(--line);border-radius:var(--r);padding:18px 20px;transition:var(--tr);position:relative;overflow:hidden}
.chart-box::after{content:'';position:absolute;inset:0;background:radial-gradient(circle at 15% -20%,var(--panel-sheen),transparent 55%);pointer-events:none;z-index:0}
.chart-box>*{position:relative;z-index:1}
.chart-box:hover{border-color:var(--line2)}
.chart-box h3{margin-bottom:14px}
.chart-box svg{display:block;overflow:visible}
.d3-tip{position:absolute;background:rgba(14,20,32,.95);border:1px solid var(--line2);border-radius:6px;padding:7px 11px;font-size:13px;font-family:var(--mono);color:var(--fg);pointer-events:none;z-index:60;box-shadow:var(--shadow);display:none;line-height:1.6;max-width:220px;backdrop-filter:blur(6px)}
.d3-tip .dt-l{color:var(--dim);font-size:11px;text-transform:uppercase;letter-spacing:.5px}
.d3-tip .dt-v{color:var(--cyan);font-weight:700;font-size:16px}

.gnode{cursor:pointer;transition:var(--tr)}
.gnode:hover circle{stroke:#fff;stroke-width:2}
.gedge{stroke:#2c3f5e;stroke-width:1;opacity:.5;transition:var(--tr)}
.gedge.highlighted{stroke:var(--cyan);stroke-width:2;opacity:1}
.gedge.dimmed{opacity:.08}
.gnode.dimmed{opacity:.15}
.gnode.highlighted circle{stroke:#fff;stroke-width:2.5}

/* ── threat map: info graph ────────────────────────────────────────── */
#viewInfo{display:none;background:linear-gradient(180deg,rgba(17,26,42,.96),rgba(10,14,22,.96));border:1px solid var(--line);border-radius:var(--r);padding:14px;box-shadow:var(--shadow)}
#viewInfo .threat-controls{padding:10px 12px;background:rgba(10,14,22,.72);border:1px solid var(--line);border-radius:8px}
#viewInfo .card{background:var(--panel);border-color:var(--line2);box-shadow:0 10px 28px rgba(0,0,0,.2)}
#threatSvg{display:block;width:100%;min-height:640px;background:radial-gradient(ellipse at 50% 45%,#172640 0%,#0a0e16 78%);border:1px solid var(--line2);border-radius:8px;overflow:visible}
#threat .gedge{stroke:#42638f;stroke-width:1.4;opacity:.48;fill:none}
#threat .gedge.highlighted{stroke:var(--cyan);stroke-width:2.4;opacity:1}
#threat .gedge.dimmed{opacity:.06}
#threat .gnode{cursor:pointer;transition:opacity .15s}
#threat .gnode circle.core{stroke:rgba(255,255,255,.8);stroke-width:1.5}
#threat .gnode:hover circle.core{stroke:#fff;stroke-width:3}
#threat .gnode.highlighted circle.core{stroke:#fff;stroke-width:3}
#threat .gnode.dimmed{opacity:.12}
#threat .gnode text{font-family:var(--mono);paint-order:stroke;stroke:#0a0e16;stroke-width:3px;stroke-linejoin:round}
#threat .gnode .result-badge{fill:#0a0e16;stroke-width:1}
#threat .gnode .result-count{font-family:var(--mono);font-size:10px;font-weight:700;text-anchor:middle}
#threat .gnode .node-label{font-size:12px;font-weight:600;fill:#b8cbe5}
#threat .gnode .node-sub{font-size:10px;fill:#7188a8}
#threat .info-node rect.info-box{fill:#162238;stroke:#42638f;stroke-width:1.2;rx:7}
#threat .info-node:hover rect.info-box{fill:#203453;stroke:var(--cyan);stroke-width:2}
#threat .info-node .node-label{font-size:12px;font-weight:600;fill:#dbe8f8}
#threat .info-node .node-sub{font-size:10px;fill:#7f99ba}
#threat .info-node .core{stroke:#dbe8f8;stroke-width:1}
#threat .graph-empty{fill:var(--dim);font-family:var(--mono);font-size:17px;text-anchor:middle}
#viewInfo .legend{padding:12px 4px 2px}
#viewInfo .graph-note{margin:8px 4px 0;color:var(--dim);font-size:11.5px;font-family:var(--mono)}

.map-tabs{display:flex;gap:6px;margin:0 0 14px}
.mtab{background:var(--panel);border:1px solid var(--line);color:var(--dim);padding:7px 15px;border-radius:8px;cursor:pointer;font-size:15px;font-family:var(--mono);transition:var(--tr)}
.mtab:hover{color:var(--fg);border-color:var(--line2)}
.mtab.on{background:rgba(34,211,238,.09);border-color:var(--cyan);color:var(--cyan)}
.geo-wrap{display:grid;grid-template-columns:minmax(0,1fr) 310px;gap:16px;align-items:start}
.geo-side{display:flex;flex-direction:column;gap:14px;min-width:0}
.geo-panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--r);padding:12px 14px;overflow:auto;max-height:270px}
.geo-panel h4{margin:0 0 10px;font-size:10.5px;text-transform:uppercase;letter-spacing:1px;color:var(--dim);font-weight:600}
.geo-row{display:flex;align-items:center;gap:8px;padding:5px 0;border-bottom:1px solid rgba(28,42,68,.5);font-size:11.5px;cursor:pointer;font-family:var(--mono)}
.geo-row:last-child{border-bottom:none}
.geo-row:hover{background:rgba(77,141,255,.05)}
.geo-row .cc{font-weight:700;color:var(--cyan);width:24px;flex-shrink:0}
.geo-row .nm{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--fg)}
.geo-row .ct{color:var(--dim);font-variant-numeric:tabular-nums}
.geo-row .dot{width:7px;height:7px;border-radius:50%;flex-shrink:0}
.geo-row .kv2{color:var(--dim);font-size:10.5px}
svg.geo{background:radial-gradient(ellipse at 50% 42%,#111d31 0%,var(--bg) 72%)}
[data-theme=light] svg.geo{background:radial-gradient(ellipse at 50% 42%,#e3edf9 0%,var(--bg) 72%)}
.geo-sphere{fill:transparent;stroke:var(--line2);stroke-width:.8}
.geo-grat{fill:none;stroke:var(--line2);stroke-width:.35;opacity:.4}
.geo-country{fill:rgba(38,58,92,.9);stroke:var(--line2);stroke-width:.5;cursor:pointer;transition:fill .15s}
[data-theme=light] .geo-country{fill:#d9e3f0}
.geo-country:hover{fill:rgba(77,141,255,.45)}
.geo-country.has-ioc{fill:rgba(58,84,126,.98)}
.geo-country.sel{fill:rgba(34,211,238,.38);stroke:var(--cyan);stroke-width:1}
.geo-bub{cursor:pointer;transition:opacity .15s}
.geo-bub circle.core{stroke:rgba(255,255,255,.6);stroke-width:1}
.geo-bub text{font-family:var(--mono);font-size:11px;font-weight:700;fill:#e6eefb;text-anchor:middle;pointer-events:none}
[data-theme=light] .geo-bub text{fill:#0f172a}
.geo-bub .ring{fill:none;stroke-width:1.2;opacity:.55}
.geo-bub .pulse{fill:none;stroke-width:1.4;transform-box:fill-box;transform-origin:center;animation:geoPulse 2.6s ease-out infinite}
@keyframes geoPulse{0%{transform:scale(.55);opacity:.75}100%{transform:scale(2.4);opacity:0}}
.geo-bub.dim{opacity:.16}
.geo-arc{fill:none;stroke:var(--orange);stroke-width:1;stroke-dasharray:4 3;opacity:.5}
.geo-arc.hot{stroke:var(--red);stroke-width:1.8;opacity:.95}
.geo-cclbl{font-family:var(--mono);font-size:9.5px;font-weight:700;fill:var(--cyan);text-anchor:middle;pointer-events:none}
.geo-empty{color:var(--dim);font-size:15px;padding:4px 0}
.geo-hint{font-size:11.5px;color:var(--dim);margin-top:10px}
/* ── call graph controls ────────────────────────────────────────── */
.cg-ctl{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.cg-ctl select,.cg-ctl input[type=text]{padding:7px 10px;background:var(--bg);border:1px solid var(--line);border-radius:var(--rs);color:var(--fg);font-family:var(--mono);font-size:15px;outline:none}
.cg-ctl select:focus,.cg-ctl input:focus{border-color:var(--accent)}
.cg-ctl label{display:flex;align-items:center;gap:6px;font-size:11.5px;color:var(--dim);font-family:var(--mono);cursor:pointer}
.cg-ctl input[type=range]{width:110px;accent-color:var(--accent)}
.cg-node{cursor:pointer}
.cg-node rect{fill:#1b2536;stroke:#35507f;stroke-width:1;rx:5;transition:fill .15s,stroke .15s}
[data-theme=light] .cg-node rect{fill:#e8eef7;stroke:#9db4d0}
.cg-node text{font-family:var(--mono);font-size:12px;fill:#c8d8ee;pointer-events:none}
[data-theme=light] .cg-node text{fill:#16283f}
.cg-node.entry rect{stroke:var(--green);stroke-width:1.7}
.cg-node.hot rect{stroke:var(--orange)}
.cg-node.focus rect{fill:rgba(77,141,255,.3);stroke:var(--cyan);stroke-width:1.9}
.cg-node.hit rect{stroke:var(--yellow);stroke-width:2}
.cg-node.dim{opacity:.14}
.cg-line{fill:none;stroke:#2c3f5e;stroke-width:1;opacity:.5}
.cg-line.dim{opacity:.05}
.cg-line.hot{stroke:var(--cyan);stroke-width:1.8;opacity:1}
.cg-depth{font-family:var(--mono);font-size:11px;fill:var(--dim);text-anchor:middle}
.cg-note{font-size:13px;color:var(--dim);margin-top:8px;font-family:var(--mono)}
.cg-ctl .sep{width:1px;height:20px;background:var(--line);margin:0 2px}

/* ── assembly viewer ───────────────────────────────────────────── */
.asmbar .fwrap{display:flex;gap:8px;align-items:center}
.asmbar input[type=text]{width:auto}
.asmbar .fsrch{width:190px}
.asm-flex{display:flex;gap:10px;align-items:stretch}
.asm-flex #asm{flex:1;min-width:0}
.asm-mapwrap{position:relative;width:30px;flex:0 0 30px;height:64vh;background:var(--panel);border:1px solid var(--line);border-radius:6px;overflow:hidden;cursor:pointer}
.asm-mapwrap i{position:absolute;left:0;right:0;opacity:.9}
.asm-win{position:absolute;left:0;right:0;border:1px solid var(--cyan);background:rgba(34,211,238,.14);pointer-events:none;box-shadow:0 0 0 1px rgba(34,211,238,.25)}
.asm-stats{display:flex;gap:14px;flex-wrap:wrap;align-items:center;margin:0 0 10px;font-size:11.5px;color:var(--dim);font-family:var(--mono)}
.asm-stack{display:flex;height:9px;border-radius:5px;overflow:hidden;background:var(--line);min-width:200px;flex:1}
.asm-stack i{display:block;height:100%}
.asm-legend{display:flex;gap:11px;flex-wrap:wrap;font-size:10.5px;color:var(--dim);font-family:var(--mono)}
.asm-legend span{display:flex;align-items:center;gap:5px}
.asm-legend b{width:8px;height:8px;border-radius:2px;display:block}
.asm-mn{display:flex;gap:12px;flex-wrap:wrap;margin:0 0 10px;font-family:var(--mono);font-size:13px;color:var(--dim);align-items:center}
.asm-mn div{display:flex;align-items:center;gap:6px}
.asm-mn .b{height:6px;background:linear-gradient(90deg,var(--accent),var(--cyan));border-radius:3px}
.asmrow.blk{display:block;height:28px;line-height:28px;background:rgba(167,139,250,.07);border-left:2px solid var(--purple);color:var(--purple);font-size:13px;padding:0 13px}
.catbar{display:block;width:3px;border-radius:2px;align-self:stretch;margin:1px 0;opacity:.85}
.blkcol{color:#5d6f8c;font-size:12px;text-align:right}
.lenbar{position:relative;height:6px;background:var(--line);border-radius:3px;align-self:center}
.lenbar i{display:block;height:100%;border-radius:3px;background:linear-gradient(90deg,var(--accent),var(--cyan))}
.c-ctrl{background:var(--c-ctrl)}
.c-call{background:var(--c-call)}
.c-ret{background:var(--c-ret)}
.c-data{background:var(--c-data)}
.c-arith{background:var(--c-arith)}
.c-cmp{background:var(--c-cmp)}
.c-stack{background:var(--c-stack)}
.c-simd{background:var(--c-simd)}
.c-nop{background:var(--c-nop)}
.c-misc{background:var(--c-misc)}
.t-cmp,.t-test{color:var(--pink)}
.t-arith,.t-add,.t-sub,.t-xor,.t-and,.t-or,.t-inc,.t-dec{color:#6ee7b7}
.t-stack,.t-push,.t-pop,.t-leave,.t-enter{color:#c4b5fd}
.t-simd{color:#d8b4fe}
.t-nop{color:#5b6b83}
.t-trap,.t-int{color:var(--red);font-weight:600}

/* ── assembly viewer: controls ─────────────────────────────────── */
.asm-lbl{font-size:11.5px;color:var(--dim);font-family:var(--mono);letter-spacing:.04em;text-transform:uppercase}
.asm-cats,.asm-blknav{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.asm-cats .fbtn,.asm-blknav .fbtn{padding:4px 11px;font-size:12px;border-radius:12px}
.asm-empty{padding:26px 18px;text-align:center;color:var(--dim);font-family:var(--mono);font-size:13px}
.asm-empty b{color:var(--fg)}
.asm-empty code{color:var(--yellow)}
.tree-empty{padding:12px 4px;color:var(--dim);font-family:var(--mono);font-size:12px}

/* ── assembly viewer: instruction rows ─────────────────────────── */
/* The mnemonic carries the weight; operands are tinted by role so a glance
   down the operand column reads as immediates / registers / symbols. */
.mn{overflow:hidden;text-overflow:ellipsis}
.op-mn{font-weight:600}
.op-reg{color:#8fb3e0}
.op-imm{color:var(--yellow)}
.op-num{color:#f0b46b}
.op-sym{color:var(--green)}
.op-sz{color:#7d8fa8}
.op-brk{color:#5d6f8c}
.mn mark{background:rgba(255,209,102,.28);color:#fff2cc;border-radius:2px;padding:0 1px}
.asmrow.hit{background:rgba(255,209,102,.07)}
.asmrow.dim{opacity:.34}
.asmrow .adr{white-space:nowrap}
/* Sticky block banners: within a scrolling function the current basic block
   stays labelled without stealing a whole row from the listing. */
.asmrow.blk{position:sticky;top:0;z-index:2;backdrop-filter:blur(4px);
  border-top:1px solid rgba(167,139,250,.18);border-bottom:1px solid rgba(167,139,250,.12)}
.asmrow.blk b{color:#cbb6ff;font-weight:600}
.asmrow.blk em{color:var(--dim);font-style:normal;font-size:12px}

@media(max-width:768px){



  header{padding:10px 14px;gap:8px}
  header h1{font-size:17px}
  .sha{display:none}
  .score{font-size:24px}
  main{padding:14px}
  .g2,.chart-row{grid-template-columns:1fr}
  .stats-row{grid-template-columns:repeat(2,1fr)}

  .geo-wrap{grid-template-columns:1fr}
  .geo-side{flex-direction:column}
  .asmbar{flex-direction:column;align-items:stretch}
  .asmbar select,.asmbar input{width:100%}
  .asmbar .fwrap{flex-wrap:wrap}
  .asm-flex{flex-direction:column}
  .asm-mapwrap{width:100%;flex:0 0 26px;height:26px}
  .asmrow{grid-template-columns:4px 78px 96px 22px minmax(0,1fr);font-size:13px;gap:6px}
  .asmrow .lenbar{display:none}
  nav button{padding:9px 13px;font-size:15px}
}
</style>
</head>
<body>
<header>
  <h1>{{ payload.fileinfo.filename or payload.meta.stem }}</h1>
  <span class="badge {{ payload.verdict.label }}">{{ payload.verdict.label }}</span>
  <span class="sha" id="shaEl" title="{{ payload.hash.sha256 or '' }}">{{ payload.hash.sha256 or '' }}</span>
  <div class="score">{{ payload.verdict.score }}<small>THREAT SCORE</small></div>
  <button class="hbtn" id="themeBtn" title="Toggle theme">🌓</button>
  <button class="hbtn" id="topBtn" title="Scroll to top">⬆</button>
</header>

<nav>
  <button class="on" data-t="overview">Overview</button>
  <button data-t="threat">Threat Map</button>
  <button data-t="stix">ATT&amp;CK / STIX</button>
  <button data-t="sections">Sections</button>
  <button data-t="imports">Imports</button>
  <button data-t="exports">Exports</button>
  <button data-t="capabilities">Capabilities</button>
  <button data-t="iocs">IOCs</button>
  <button data-t="assembly">Assembly</button>
  <button data-t="graphs">Call Graph / CFG</button>
  <button data-t="charts">Analytics</button>
  <button data-t="ml">ML Score</button>
  <button data-t="tooling">Tooling</button>
</nav>

<main>
<section id="overview" class="on">
  <div class="pi">Section <span>Overview</span> / {{ payload.meta.stem }}</div>
  <div class="stats-row" id="ovStats"></div>
  <div class="grid g2">
    <div class="card">
      <h3>File</h3>
      <div class="kv"><span>Name</span><span>{{ payload.fileinfo.filename or '—' }}</span></div>
      <div class="kv"><span>Size</span><span>{{ payload.fileinfo.size_human or '—' }}</span></div>
      <div class="kv"><span>Magic</span><span>{{ payload.fileinfo.file_magic or '—' }}</span></div>
      <div class="kv"><span>Format</span><span>{{ payload.fileinfo.format or payload.extraction.summary.format or '—' }}</span></div>
      <div class="kv"><span>Executable</span><span>{{ 'yes' if payload.fileinfo.is_executable else 'no' }}</span></div>
      <div class="kv"><span>SHA-256</span><span><span id="sha256Val">{{ payload.hash.sha256 or '—' }}</span><button class="copy-btn" data-copy="sha256">Copy</button></span></div>
      <div class="kv"><span>TLSH</span><span>{{ payload.hash.tlsh or '—' }}</span></div>
    </div>
    <div class="card">
      <h3>Analysis</h3>
      <div class="kv"><span>Sections</span><span>{{ payload.extraction.summary.num_sections or 0 }}</span></div>
      <div class="kv"><span>Strings</span><span>{{ payload.extraction.summary.num_strings or 0 }}</span></div>
      <div class="kv"><span>Instructions</span><span>{{ payload.extraction.summary.total_instructions or 0 }}</span></div>
      <div class="kv"><span>Functions (r2)</span><span>{{ payload.radare2.counts.functions or 0 }}</span></div>
      <div class="kv"><span>Capa capabilities</span><span>{{ payload.capa.counts.capabilities or 0 }}</span></div>
      <div class="kv"><span>Packed</span><span>{{ 'yes' if payload.verdict.packed else 'no' }}</span></div>
      <div class="kv"><span>MalAPI hits</span><span>{{ payload.malapi|length }}</span></div>
    </div>
    <div class="card">
      <h3>Mitigations / Signature</h3>
      {% set g = payload.extraction.guards %}
      {% if g.format == 'PE' %}
      <div class="kv"><span>ASLR</span><span>{{ 'yes' if g.aslr else 'no' }}</span></div>
      <div class="kv"><span>DEP/NX</span><span>{{ 'yes' if (g.dep or g.nx) else 'no' }}</span></div>
      <div class="kv"><span>CFG</span><span>{{ 'yes' if g.guard_cf else 'no' }}</span></div>
      <div class="kv"><span>CET</span><span>{{ 'yes' if g.cet_compat else 'no' }}</span></div>
      {% elif g.format == 'ELF' %}
      <div class="kv"><span>SHSTK</span><span>{{ 'yes' if g.shstk else 'no' }}</span></div>
      <div class="kv"><span>IBT</span><span>{{ 'yes' if g.ibt else 'no' }}</span></div>
      {% else %}
      <div class="kv"><span>Guards</span><span>n/a</span></div>
      {% endif %}
      <div class="kv"><span>Signed</span><span>{{ 'yes' if payload.extraction.signature.is_signed else 'no' }}</span></div>
      <div class="kv"><span>Stripped</span><span>{{ 'yes' if payload.extraction.debug.stripped else 'no' }}</span></div>
    </div>
    <div class="card">
      <h3>Top Opcodes</h3>
      <table>
        <tr><th>opcode</th><th>count</th><th>share</th></tr>
        {% for o in (payload.extraction.opcodes.top_10 or []) %}
        <tr><td class="mono">{{ o.opcode }}</td><td class="mono">{{ o.count }}</td>
            <td><div class="bar"><i style="width:{{ '%.1f'|format((o.percent or 0) * 4) }}%"></i></div></td></tr>
        {% endfor %}
      </table>
    </div>
  </div>
</section>

<section id="ml">
  <div class="pi">Section <span>ML Score</span> / EMBER2024</div>
  <div class="stats-row" id="mlStats"></div>
  {% set ml = payload.ml or {} %}
  {% if not ml or not ml.ok %}
  <div class="card">
    <h3>Model Verdict</h3>
    {% if ml and ml.error %}
    <div class="kv"><span>Status</span><span>{{ ml.error }}{% if ml.detail %} — {{ ml.detail }}{% endif %}</span></div>
    {% else %}
    <div class="dt-empty">ML scoring was skipped for this sample (no scoring service, or ML_SKIP set). The static analysis above is unaffected.</div>
    {% endif %}
    {% if ml and ml.verdict_note %}
    <div class="kv"><span>Note</span><span>{{ ml.verdict_note }}</span></div>
    {% endif %}
  </div>
  {% else %}
  <div class="grid2">
    <div class="card">
      <h3>Model Verdict</h3>
      {% set lvl = (ml.threat_level or '') %}
      {% set lvl_colors = {'low':'#2ee6a8','moderate':'#ffd166','high':'#ff4d5e','critical':'#ff4d5e','n/a':'#6b7f9e'} %}
      <div class="kv"><span>Threat level</span><span class="mono" style="color:{{ lvl_colors.get(lvl, '#6b7f9e') }}">{{ lvl or '—' }}</span></div>
      <div class="kv"><span>Verdict</span><span>{{ ml.verdict or '—' }}</span></div>
      <div class="kv"><span>P(malicious)</span><span class="mono">{{ '%.6f'|format(ml.malicious_probability or 0) }}</span></div>
      {% if ml.threshold_margin is defined and ml.threshold_margin is not none %}
      <div class="kv"><span>vs threshold</span><span class="mono">{{ '%+.4f'|format(ml.threshold_margin) }} (p − t)</span></div>
      {% endif %}
      <div class="kv"><span>Threshold</span><span class="mono">{{ ml.threshold }}</span></div>
      <div class="kv"><span>PE input</span><span>{{ 'yes' if ml.is_pe else 'no' }}</span></div>
      <div class="kv"><span>Uncalibrated</span><span>yes — banded verdict only, not a confidence</span></div>
      {% if ml.verdict_note %}
      <div class="kv"><span>Note</span><span>{{ ml.verdict_note }}</span></div>
      {% endif %}
    </div>
    <div class="card">
      <h3>Model</h3>
      <div class="kv"><span>File</span><span class="mono">{{ ml.model or '—' }}</span></div>
      <div class="kv"><span>SHA-256</span><span class="mono">{{ (ml.model_sha256 or '')[:16] }}…</span></div>
      <div class="kv"><span>Trees</span><span>{{ ml.trees or 0 }}</span></div>
      <div class="kv"><span>Features</span><span>{{ ml.features or 0 }}</span></div>
      <div class="kv"><span>Source</span><span>{{ ml.feature_source or '—' }}</span></div>
      <div class="kv"><span>Bytes scored</span><span>{{ ml.bytes or 0 }}</span></div>
    </div>
  </div>

  <div class="chart-row">
    <div class="chart-box">
      <h3>P(malicious) vs threshold</h3>
      <div id="mlGauge"></div>
      <div class="dt-desc">Threshold {{ ml.threshold }} · verdict {{ ml.verdict or '—' }} · threat
        {{ lvl or '—' }} — the probability is uncalibrated, so the level is a band around
        the threshold, not a confidence.</div>
    </div>
    <div class="chart-box">
      <h3>SHAP by group (log-odds)</h3>
      <div id="mlGroups"></div>
      <div class="dt-desc">Red pushes towards malicious, green towards benign; the bar is the summed SHAP of the group.</div>
    </div>
  </div>
  <div class="chart-row single">
    <div class="chart-box">
      <h3>Top Features (SHAP log-odds)</h3>
      <div id="mlFeatures"></div>
      <div class="dt-desc">Each feature's own contribution to the log-odds, in feature-index order.</div>
    </div>
  </div>

  {% set expl = ml.explanation or {} %}
  {% if expl and expl.group_rollup %}
  <div class="card">
    <h3>Group Attribution (SHAP log-odds)</h3>
    <table>
      <tr><th>group</th><th>shap</th><th>in analyzer</th></tr>
      {% for g in expl.group_rollup %}
      <tr><td class="mono">{{ g.group }}</td><td class="mono">{{ '%.4f'|format(g.shap_log_odds or 0) }}</td>
          <td>{{ 'yes' if g.analyzer_implemented else 'no' }}</td></tr>
      {% endfor %}
    </table>
    <div class="dt-desc">Base {{ '%.4f'|format(expl.base_log_odds or 0) }} + ΣSHAP {{ '%.4f'|format(expl.sum_shap or 0) }} = prediction {{ '%.4f'|format(expl.prediction_log_odds or 0) }} (consistency error {{ expl.consistency_error or 0 }}).</div>
  </div>
  {% endif %}
  {% if expl and expl.top_features %}
  <div class="card">
    <h3>Top Features (SHAP)</h3>
    <table>
      <tr><th>#</th><th>group</th><th>label / evidence</th><th>direction</th><th>shap</th></tr>
      {% for f in expl.top_features %}
      <tr><td class="mono">{{ f.feature_index }}</td><td class="mono">{{ f.group }}</td>
          <td class="mono">{{ f.label or f.evidence or '—' }}</td>
          <td>{{ f.direction or '—' }}</td>
          <td class="mono">{{ '%.4f'|format(f.shap_log_odds or 0) }}</td></tr>
      {% endfor %}
    </table>
  </div>
  {% endif %}
  {% endif %}
</section>

<section id="tooling">
  <div class="pi">Section <span>External Tooling</span></div>
  <div class="stats-row" id="toolStats"></div>

  <div class="grid2">
    {% set yara = payload.extraction.yara or {} %}
    <div class="card">
      <h3>YARA</h3>
      {% if not yara or not yara.attempted %}
      <div class="dt-empty">YARA was not run for this sample.</div>
      {% elif not yara.available %}
      <div class="dt-empty">YARA unavailable &mdash; WSL or the scanner could not be started.</div>
      {% else %}
      <div class="kv"><span>Status</span>
        <span style="color:{{ 'var(--green)' if yara.rules_matched else 'var(--dim)' }}">
          {{ ('%d match(es)'|format(yara.rules_matched or 0)) if yara.rules_matched else 'no matches' }}
        </span></div>
      <div class="kv"><span>Rules loaded</span>
        <span class="mono">{{ yara.rule_files_loaded or 0 }} / {{ yara.rule_files_found or 0 }}</span></div>
      <div class="kv"><span>Rule files failed</span>
        <span class="mono" style="color:{{ 'var(--red)' if yara.rule_files_failed else 'var(--dim)' }}">
          {{ yara.rule_files_failed or 0 }}</span></div>
      <div class="kv"><span>Workers</span><span class="mono">{{ yara.worker_threads or 0 }}</span></div>
      <div class="kv"><span>Scan</span>
        <span class="mono">exit {{ yara.exit_code if yara.exit_code is not none else '-' }} &middot;
        {{ '%.3f'|format(yara.seconds or 0) }}s</span></div>
      {% if yara.rules_directory %}
      <div class="kv"><span>Rules dir</span><span class="mono">{{ yara.rules_directory }}</span></div>
      {% endif %}
      {% if yara.matches %}
      <table>
        <tr><th>rule</th><th>strings</th><th>offsets</th></tr>
        {% for m in yara.matches %}
        <tr>
          <td class="mono" style="color:var(--orange)">{{ m.identifier }}</td>
          <td class="mono" style="color:var(--cyan)">
            {% for s in (m.strings or []) %}{{ s.identifier }}{% if not loop.last %}, {% endif %}{% endfor %}
          </td>
          <td class="mono" style="color:var(--dim)">
            {% for s in (m.strings or []) %}{% for o in (s.offsets or []) %}{{ o }}{% if not loop.last %}, {% endif %}{% endfor %}{% if not loop.last %}; {% endif %}{% endfor %}
          </td>
        </tr>
        {% endfor %}
      </table>
      {% else %}
      <div class="dt-empty">No YARA rules matched this sample.</div>
      {% endif %}
      {% endif %}
    </div>

    {% set cm = payload.extraction.cminer or {} %}
    <div class="card">
      <h3>Cminer <span style="font-weight:400;color:var(--dim);font-size:.8rem">code caves</span></h3>
      {% if not cm or not cm.attempted %}
      <div class="dt-empty">Cminer was not run for this sample.</div>
      {% elif not cm.applicable %}
      <div class="dt-empty">Cminer only analyzes PE files &mdash; skipped.</div>
      {% elif not cm.available %}
      <div class="dt-empty">Cminer unavailable &mdash; WSL or the Cminer binary could not be used.</div>
      {% else %}
      <div class="kv"><span>Caves</span>
        <span class="mono" style="color:{{ 'var(--orange)' if cm.cave_count else 'var(--dim)' }}">
          {{ cm.cave_count or 0 }}</span></div>
      <div class="kv"><span>Total cave bytes</span><span class="mono">{{ cm.total_cave_bytes or 0 }}</span></div>
      <div class="kv"><span>Largest cave</span><span class="mono">{{ cm.largest_cave_bytes or 0 }}</span></div>
      <div class="kv"><span>Min cave size</span><span class="mono">{{ cm.minimum_cave_size or 0 }}</span></div>
      <div class="kv"><span>Scan</span>
        <span class="mono">exit {{ cm.exit_code if cm.exit_code is not none else '-' }} &middot;
        {{ '%.3f'|format(cm.seconds or 0) }}s</span></div>
      {% if cm.caves %}
      <table>
        <tr><th>section</th><th>size</th><th>start</th><th>end</th><th>file off</th></tr>
        {% for c in cm.caves %}
        <tr>
          <td class="mono" style="color:var(--cyan)">{{ c.section }}</td>
          <td class="mono" style="color:{{ 'var(--orange)' if c.size == cm.largest_cave_bytes else 'var(--fg)' }}">{{ c.size }}</td>
          <td class="mono" style="color:var(--dim)">0x{{ '%x'|format(c.start_address) }}</td>
          <td class="mono" style="color:var(--dim)">0x{{ '%x'|format(c.end_address) }}</td>
          <td class="mono" style="color:var(--purple)">0x{{ '%x'|format(c.file_offset) }}</td>
        </tr>
        {% endfor %}
      </table>
      {% else %}
      <div class="dt-empty">No code caves at or above the minimum size.</div>
      {% endif %}
      {% endif %}
    </div>
  </div>

  {% set xxd = payload.extraction.xxd or {} %}
  {% if xxd and xxd.output %}
  <div class="card">
    <h3>xxd <span style="font-weight:400;color:var(--dim);font-size:.8rem">WSL hex dump</span></h3>
    <div class="hex-toolbar">
      <span class="mono" style="color:var(--dim)">
        {{ xxd.output_full_bytes or 0 }} bytes total
        {%- if xxd.truncated %} &middot; showing a bounded preview{% endif %}
        {%- if xxd.exit_code is not none %} &middot; exit {{ xxd.exit_code }}{% endif %}
      </span>
      <button class="copy-btn" id="copyXxd" style="margin-left:auto">Copy Preview</button>
    </div>
    {# The dump must live in the element's TEXT, not an attribute: it contains
       newlines and can contain '<' (byte 0x3c), which would terminate the
       attribute or start a bogus tag. |e forces escaping even though this
       template runs with autoescape disabled. #}
    <pre id="xxdBody" class="hexview">{{ xxd.output | e }}</pre>
  </div>
  {% endif %}
</section>

<section id="threat">
  <div class="pi">Section <span>Threat Map</span></div>
  <div class="stats-row" id="threatStats"></div>

  <div class="map-tabs">
    <button class="mtab on" data-view="geo">Geo Map · IOCs</button>
    <button class="mtab" data-view="info">Info Graph</button>
  </div>

  <div id="viewGeo">
    <div class="threat-controls">
      <button class="fbtn kbtn active" data-kind="all">All IOCs</button>
      <button class="fbtn kbtn" data-kind="ip">IPs</button>
      <button class="fbtn kbtn" data-kind="domain">Domains</button>
      <button class="fbtn kbtn" data-kind="url">URLs</button>
      <button class="fbtn kbtn" data-kind="email">E-mails</button>
      <span style="flex:1"></span>
      <button class="fbtn" id="geoReset">Reset view</button>
    </div>
    <div class="geo-wrap">
      <div class="card" style="padding:0;overflow:hidden">
        <svg class="geo" id="geoSvg" style="height:600px"></svg>
      </div>
      <div class="geo-side">
        <div class="geo-panel">
          <h4>Countries ({{ payload.geo.countries|length }})</h4>
          <div id="geoCountries"></div>
        </div>
        <div class="geo-panel">
          <h4>Unmapped · no geolocation ({{ payload.geo.stats.unmapped }})</h4>
          <div id="geoUnmapped"></div>
        </div>
      </div>
    </div>
    <div class="legend">
      <div class="li"><span class="ld" style="background:#ff4d5e"></span>Malicious</div>
      <div class="li"><span class="ld" style="background:#ff9f43"></span>Suspicious</div>
      <div class="li"><span class="ld" style="background:#22d3ee"></span>Unknown verdict</div>
      <div class="li"><span class="ld" style="background:#2ee6a8"></span>Benign</div>
      <div class="li"><span class="ld" style="background:#a78bfa"></span>Reported by CTI providers</div>
      <div class="li"><span class="ld" style="background:#6b7f9e"></span>Country inferred from TLD</div>
    </div>
    <p class="geo-hint">Bubble size = IOCs in that country · dashed arcs link countries sharing an
      ASN. Click a country or a row to list its IOCs, ASN and provider findings. Drag to pan ·
      scroll to zoom.</p>
  </div>

  <div id="viewInfo" style="display:none">
    <div class="threat-controls">
      <button class="fbtn active" data-filter="all">All</button>
      <button class="fbtn" data-filter="section">Sections</button>
      <button class="fbtn" data-filter="dll">DLLs</button>
      <button class="fbtn" data-filter="function">Functions</button>
      <button class="fbtn" data-filter="analysis">Analysis</button>
      <button class="fbtn" data-filter="capability">Capabilities</button>
      <button class="fbtn" data-filter="ioc">IOCs</button>
      <button class="fbtn" data-filter="family">Families</button>
      <button class="fbtn" data-filter="malicious">Malicious</button>
    </div>
    <div class="card" style="padding:0;overflow:hidden">
      <svg class="graph" id="threatSvg" style="height:640px"></svg>
    </div>
    <div class="legend">
      <div class="li"><span class="ld" style="background:#4d8dff"></span>Sample</div>
      <div class="li"><span class="ld" style="background:#818cf8"></span>Analysis</div>
      <div class="li"><span class="ld" style="background:#34d399"></span>Function</div>
      <div class="li"><span class="ld" style="background:#22d3ee"></span>Section</div>
      <div class="li"><span class="ld" style="background:#a78bfa"></span>DLL</div>
      <div class="li"><span class="ld" style="background:#ffd166"></span>Capability</div>
      <div class="li"><span class="ld" style="background:#2ee6a8"></span>IOC</div>
      <div class="li"><span class="ld" style="background:#ff9f43"></span>Family</div>
      <div class="li"><span class="ld" style="background:#ff4d5e"></span>Malicious</div>
    </div>
    <p style="margin-top:10px;font-size:11.5px;color:var(--dim)">Click any node to open its info block. Badge shows number of results. Drag to rearrange · scroll to zoom.</p>
  </div>
</section>

<section id="stix">
  <div class="pi">Section <span>ATT&amp;CK / STIX</span></div>

  {% if not payload.stix.available %}
  <div class="card">
    <p style="color:var(--dim)">No ATT&amp;CK techniques to show — {{ payload.stix.reason or 'no STIX bundle for this run' }}.</p>
  </div>
  {% else %}
  <div class="stats-row" id="stixStats"></div>

  {% set am = (payload.cti or {}).get('attack_matrix') or {} %}
  <div class="map-tabs">
    <button class="sxtab on" data-sview="coverage">ATT&amp;CK Coverage</button>
    <button class="sxtab" data-sview="tactics">Procedures &amp; Tooling</button>
    <button class="sxtab" data-sview="graph">STIX Object Graph</button>
    {% if payload.d3fend and payload.d3fend.available %}
    <button class="sxtab" data-sview="d3fend">D3FEND Defenses</button>
    {% endif %}
  </div>

  <div id="stixTactics" style="display:none">
    {% if am.available %}
    <div class="card">
      <div class="pi" style="margin-bottom:8px">Tactics <span>procedures observed, with the tooling ATT&amp;CK knows implements them</span></div>
      <div class="tk-wrap">
        <div class="tk-filters">
          <input type="search" id="tkSearch" placeholder="Search technique, tool, malware, group or detection text…">
          <span class="tk-chips" id="tkTacticChips"></span>
          <span class="tk-count" id="tkCount"></span>
          <button class="tk-reset" id="tkReset">Reset</button>
        </div>
        <div class="tk-chips">
          <span class="tk-chip on" data-facet="all">All data</span>
          <span class="tk-chip tk-tools" data-facet="tools">Tools only</span>
          <span class="tk-chip tk-malware" data-facet="malware">Malware only</span>
          <span class="tk-chip tk-groups" data-facet="groups">Groups only</span>
          <span class="tk-chip tk-detect" data-facet="detect">Detection guidance only</span>
          <span class="tk-chip" data-facet="sub">Sub-techniques only</span>
          <span class="tk-chip" data-facet="notool">Has tooling</span>
        </div>
        <div id="tkList"></div>
      </div>
    </div>
    {% else %}
    <div class="card">
      <div class="dt-empty">No ATT&amp;CK procedure records for this run —
        {{ am.reason or 'the CTI report carries no tactic view and no ATT&amp;CK-cache fallback was available' }}.</div>
    </div>
    {% endif %}
  </div>

  <div id="stixCoverage">
    <div class="card"><div class="sx-matrix" id="stixMatrix"></div></div>
  </div>

  <div id="stixGraph" style="display:none">
    <div class="sx-toolbar">
      <input id="sxSearch" placeholder="Filter nodes by name or technique ID…">
      <span id="sxTypes" style="display:flex;gap:6px;flex-wrap:wrap"></span>
      <span style="flex:1"></span>
      <button class="fbtn" id="sxFit">Reset view</button>
      <button class="fbtn" id="sxNav">⬇ Navigator layer (sample)</button>
      <button class="fbtn" id="sxFullNav">⬇ Full ATT&CK Matrix</button>
    </div>
    <div class="sx-graph"><svg id="stixSvg"></svg></div>
    <div class="legend" id="stixLegend"></div>
    <p class="sx-note" id="stixNote"></p>
  </div>

  {% if payload.d3fend and payload.d3fend.available %}
  <div id="stixD3fend" style="display:none">
    <div class="card">
      <div class="pi" style="margin-bottom:8px">D3FEND <span>defensive techniques for the tactics capa recovered</span></div>
      <div class="stats-row" id="d3fStats"></div>
      <div id="d3fList"></div>
      <p class="sx-note" id="d3fNote"></p>
    </div>
  </div>
  {% endif %}
  {% endif %}
</section>

<section id="sections">
  <div class="pi">Section <span>Sections</span></div>
  <div class="card">
    <h3>Binary Sections ({{ (payload.extraction.sections.details or [])|length }})</h3>
    <table>
      <tr><th>name</th><th>virtual address</th><th>size</th><th>entropy</th><th>chi2</th></tr>
      {% for s in (payload.extraction.sections.details or []) %}
      <tr>
        <td class="mono">{{ s.name }}</td>
        <td class="mono">0x{{ '%x'|format(s.virtual_address or 0) }}</td>
        <td class="mono">{{ s.size or 0 }}</td>
        <td><div class="bar {{ 'hot' if (s.entropy or 0) > 7.2 else '' }}"><i style="width:{{ '%.1f'|format((s.entropy or 0) * 10) }}%"></i></div></td>
        <td class="mono">{{ '%.0f'|format(s.chi2 or 0) }}</td>
      </tr>
      {% endfor %}
    </table>
  </div>
</section>

<section id="imports">
  <div class="pi">Section <span>Imports</span></div>
  {% if payload.malapi %}
  <div class="card" style="margin-bottom:16px">
    <h3>MalAPI Flagged Imports ({{ payload.malapi|length }})</h3>
    {% for m in payload.malapi %}<span class="chip red mono">{{ m.function }}</span>{% endfor %}
  </div>
  {% endif %}
  <div class="card">
    <h3>Imports by DLL ({{ payload.imports.dlls|length }} DLLs)</h3>
    <input class="search" id="impSearch" placeholder="Filter imports…">
    <div class="tree" id="impTree">
      {% for dll, imps in payload.imports.dlls.items() %}
      <details>
        <summary>{{ dll }} <span class="chip">{{ imps|length }}</span></summary>
        {% for i in imps %}
        <div class="imp {{ 'flag' if i.name in (payload.malapi|map(attribute='function')|list) else '' }}"
             data-n="{{ i.name }}">{{ i.name }}{{ ' [delay]' if i.is_delay else '' }}{{ ' [ordinal]' if i.is_ordinal else '' }}</div>
        {% endfor %}
      </details>
      {% endfor %}
    </div>
  </div>
</section>

{# ------------------------------------------------------------------ #}
{# PE Export Address Table. Absent for most EXEs (a static executable
   has no exports), so the whole section degrades to a clear notice. #}
{# ------------------------------------------------------------------ #}
{% set eat = payload.extraction.export_table %}
<section id="exports">
  <div class="pi">Section <span>Exports</span></div>
  {% if not eat or not eat.present %}
  <div class="card">
    <h3>No Export Address Table</h3>
    <div class="kv"><span>Status</span><span>not present</span></div>
    <p class="note">This binary exposes no exports. That is expected for a plain
    executable &mdash; a populated EAT is typically a sign of a DLL, driver or
    plugin. The <code>.data</code> directory entry is absent or empty.</p>
  </div>
  {% else %}
  <div class="stats-row">
    <div class="stat-card"><div class="sv">{{ eat.entries_total or 0 }}</div><div class="sl">Exports</div></div>
    <div class="stat-card"><div class="sv">{{ eat.named_count or 0 }}</div><div class="sl">Named</div></div>
    <div class="stat-card"><div class="sv">{{ eat.forwarded_count or 0 }}</div><div class="sl">Forwarded</div></div>
    <div class="stat-card"><div class="sv">{{ eat.external_count or 0 }}</div><div class="sl">External</div></div>
    <div class="stat-card"><div class="sv">{{ eat.ordinal_base or 0 }}</div><div class="sl">Ordinal base</div></div>
  </div>

  <div class="card" style="margin-bottom:16px">
    <h3>Directory</h3>
    <div class="kv"><span>Name</span><span class="mono">{{ eat.name or '—' }}</span></div>
    <div class="kv"><span>Timestamp</span><span class="mono">{{ '0x%08x'|format(eat.timestamp or 0) }}</span></div>
    <div class="kv"><span>Version</span><span class="mono">{{ eat.major_version or 0 }}.{{ eat.minor_version or 0 }}</span></div>
    <div class="kv"><span>Ordinal base</span><span class="mono">{{ eat.ordinal_base or 0 }}</span></div>
    <div class="kv"><span>Address table RVA</span><span class="mono">{{ '0x%08x'|format(eat.address_table_rva or 0) }} &middot; {{ eat.address_table_count or 0 }} entries</span></div>
    <div class="kv"><span>Name table RVA</span><span class="mono">{{ '0x%08x'|format(eat.name_table_rva or 0) }} &middot; {{ eat.name_table_count or 0 }} entries</span></div>
    <div class="kv"><span>Ordinal table RVA</span><span class="mono">{{ '0x%08x'|format(eat.ordinal_table_rva or 0) }}</span></div>
  </div>

  <div class="card">
    <h3>Exported Symbols
      {% if eat.entries_truncated %}
        <span class="chip orange">showing first {{ eat.entries|length }} of {{ eat.entries_total }}</span>
      {% else %}
        <span class="chip">{{ eat.entries|length }}</span>
      {% endif %}
    </h3>
    <input class="search" id="eatSearch" placeholder="Filter exports…">
    <div class="tree" id="eatTree">
      {% for e in eat.entries %}
      <div class="imp" data-n="{{ e.name }}">
        <span class="mono" style="color:var(--dim)">{{ e.ordinal }}</span>
        <span class="mono">{{ e.name or '(ordinal only)' }}</span>
        <span class="mono" style="color:var(--dim)">RVA {{ '0x%08x'|format(e.rva or 0) }}</span>
        {% if e.is_forwarded %}
          <span class="chip orange">fwd</span>
          <span class="mono">{{ e.forwarder_library or '' }}{{ '.' if e.forwarder_library and e.forwarder_function }}{{ e.forwarder_function or '' }}</span>
        {% endif %}
        {% if e.is_extern %}<span class="chip red">external</span>{% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
  {% endif %}
</section>

<section id="capabilities">
  <div class="pi">Section <span>Capabilities</span></div>
  <div class="stats-row">
    <div class="stat-card"><div class="sv">{{ payload.capa.capabilities|length }}</div><div class="sl">Capabilities</div></div>
    <div class="stat-card"><div class="sv">{{ payload.capa.attack_ids|length }}</div><div class="sl">ATT&CK IDs</div></div>
    <div class="stat-card"><div class="sv">{{ payload.capa.mbc_ids|length }}</div><div class="sl">MBC IDs</div></div>
  </div>
  <div class="card" style="margin-bottom:16px">
    <h3>ATT&CK &amp; MBC Mappings</h3>
    <div style="display:flex;flex-wrap:wrap;gap:5px">
      {% for a in payload.capa.attack_ids %}<span class="chip purple">{{ a }}</span>{% endfor %}
      {% for m in payload.capa.mbc_ids %}<span class="chip orange">{{ m }}</span>{% endfor %}
    </div>
  </div>
  <div class="card">
    <h3>Capabilities ({{ payload.capa.capabilities|length }})</h3>
    <table>
      <tr><th>namespace</th><th>capability</th><th>scope</th><th>matches</th></tr>
      {% for c in payload.capa.capabilities %}
      <tr><td class="mono">{{ c.namespace }}</td><td>{{ c.name }}</td><td class="mono">{{ c.scope }}</td><td class="mono">{{ c.match_count }}</td></tr>
      {% endfor %}
    </table>
  </div>
</section>

<section id="iocs">
  <div class="pi">Section <span>IOCs</span></div>
  <div class="stats-row">
    {% for label, items in [('Domains', payload.ioc.domains or []), ('IPs', payload.ioc.ips or []), ('URLs', payload.ioc.urls or []), ('Emails', payload.ioc.emails or []), ('Hashes', payload.ioc.hashes or [])] %}
    <div class="stat-card"><div class="sv" style="font-size:27px">{{ items|length }}</div><div class="sl">{{ label }}</div></div>
    {% endfor %}
  </div>
  <div class="grid g2">
    {% for title, items, cls in [
        ('Domains', payload.ioc.domains or [], 'red'),
        ('IPs', payload.ioc.ips or [], 'yellow'),
        ('URLs', payload.ioc.urls or [], ''),
        ('Emails', payload.ioc.emails or [], 'green'),
        ('Hashes', payload.ioc.hashes or [], '')] %}
    <div class="card">
      <h3>{{ title }} ({{ items|length }})</h3>
      {% for it in items %}
        {% set v = it.value if it is mapping else it %}
        {% set t = (' [' ~ it.type ~ ']') if it is mapping and it.type else '' %}
        <span class="chip {{ cls }} mono">{{ v }}{{ t }}</span>
      {% endfor %}
    </div>
    {% endfor %}
    <div class="card">
      <h3>Family Hints ({{ (payload.ioc.family_hits or [])|length }})</h3>
      {% for f in (payload.ioc.family_hits or []) %}
        <span class="chip red">{{ f.keyword }} → {{ f.classification }}</span>
      {% endfor %}
    </div>
    <div class="card">
      <h3>Encoded Strings ({{ (payload.ioc.encoded_flags or [])|length }} flagged)</h3>
      {% for f in (payload.ioc.encoded_flags or []) %}
        <span class="chip red mono" title="{{ f.decoded|e }}">{{ f.recipe }}: {{ f.original[:110]|e }}</span>
        <span class="chip yellow mono">{{ f.decoded[:200]|e }}</span>
        {% for ind in f.indicators %}<span class="chip">{{ ind|e }}</span>{% endfor %}
        {% for u in f.urls %}<span class="chip green mono">{{ u|e }}</span>{% endfor %}
      {% else %}
        <span class="chip">none flagged</span>
      {% endfor %}
    </div>
  </div>
</section>

<section id="assembly">
  <div class="pi">Section <span>Assembly</span></div>
  {% if payload.asm_truncated %}

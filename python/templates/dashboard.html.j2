<script id="countries" type="application/json">{{ country_json }}</script>
<script>{{ d3_src }}</script>
<script>
"use strict";
const DATA = JSON.parse(document.getElementById("payload").textContent);
const HAS_D3 = typeof d3 !== "undefined";
if (!HAS_D3) console.warn("d3.min.js was not inlined - maps, graphs and charts are skipped.");
const AMP = String.fromCharCode(38);
const esc = s => String(s).replace(/[&<>"]/g, c => {
  if (c === AMP) return AMP + "amp;";
  if (c === "<") return AMP + "lt;";
  if (c === ">") return AMP + "gt;";
  return AMP + "quot;";
});
const HEX = n => (typeof n === "number") ? "0x" + n.toString(16) : n;
const TC = {sample:"#38bdf8",section:"#06b6d4",dll:"#8b5cf6",capability:"#fbbf24",ioc:"#10b981",family:"#f59e0b",malicious:"#f43f5e",function:"#34d399",analysis:"#6366f1"};
const TS = {sample:26,section:9,dll:11,capability:10,ioc:9,family:11,malicious:13,function:9,analysis:14};
const TL = {sample:"SAMPLE",section:"SECTION",dll:"DLL",capability:"CAPABILITY",ioc:"IOC",family:"FAMILY",malicious:"MALICIOUS",function:"FUNCTION",analysis:"ANALYSIS"};
const PAL = ["#38bdf8","#06b6d4","#8b5cf6","#fbbf24","#10b981","#f59e0b","#f43f5e","#ec4899","#6366f1","#34d399","#a855f7","#fb923c"];

/* ═══ Navigation ═══ */
document.querySelectorAll("nav button").forEach(b => {
  b.onclick = () => {
    document.querySelectorAll("nav button").forEach(x => x.classList.remove("on"));
    document.querySelectorAll("main section").forEach(x => x.classList.remove("on"));
    b.classList.add("on");
    const sec = document.getElementById(b.dataset.t);
    if (sec) sec.classList.add("on");
    if (b.dataset.t === "threat") {
      try { drawThreat(); } catch (err) { console.error("Threat view failed", err); }
    }
    if (b.dataset.t === "stix") {
      try { drawStix(); } catch (err) { console.error("STIX view failed", err); }
    }
    if (b.dataset.t === "charts") {
      try { drawAllCharts(); } catch (err) { console.error("Charts failed", err); }
    }
    if (b.dataset.t === "graphs") {
      try { renderGraphs(); } catch (err) { console.error("Graphs failed", err); }
    }
    if (b.dataset.t === "ml") {
      try { drawML(); } catch (err) { console.error("ML view failed", err); }
    }
    if (b.dataset.t === "d3fend") {
      try { drawD3fend(); } catch (err) { console.error("D3FEND view failed", err); }
    }
    window.scrollTo({top:0,behavior:"smooth"});
  };
});

/* ═══ Theme ═══ */
const themeBtn = document.getElementById("themeBtn");
let store = null;
try { store = window.localStorage; } catch (err) { store = null; }
let curTheme = (store && store.getItem("dash-theme")) || "dark";
document.documentElement.setAttribute("data-theme", curTheme);
themeBtn.textContent = curTheme === "dark" ? "☀" : "🌙";
themeBtn.onclick = () => {
  curTheme = curTheme === "dark" ? "light" : "dark";
  document.documentElement.setAttribute("data-theme", curTheme);
  try { if (store) store.setItem("dash-theme", curTheme); } catch (err) { /* not persisted */ }
  themeBtn.textContent = curTheme === "dark" ? "☀" : "🌙";
  if (HAS_D3) { drawAllCharts(); drawThreat(); renderGraphs(); drawML(); }
};
document.getElementById("topBtn").onclick = () => window.scrollTo({top:0,behavior:"smooth"});

/* ═══ Copy ═══ */
document.addEventListener("click", e => {
  const btn = e.target.closest("[data-copy], [data-copy-val]");
  if (!btn) return;
  let text = "";
  if (btn.dataset.copyVal !== undefined) text = btn.dataset.copyVal;
  else if (btn.dataset.copy === "sha256") text = document.getElementById("sha256Val").textContent;
  if (text) {
    navigator.clipboard.writeText(text).then(() => {
      btn.classList.add("copied"); btn.textContent = "\u2713 Copied";
      setTimeout(() => { btn.classList.remove("copied"); btn.textContent = "Copy"; }, 1500);
    });
  }
});

/* ═══ Overview stats ═══ */
(function() {
  const el = document.getElementById("ovStats");
  if (!el) return;
  const s = [
    {i:"\u{1F4BE}", v:DATA.fileinfo.size_human||"\u2014", l:"Size"},
    {i:"\u{1F3AF}", v:DATA.verdict.score, l:"Threat"},
    {i:"\u{1F4E6}", v:DATA.extraction.summary.num_sections||0, l:"Sections"},
    {i:"\u{1F524}", v:DATA.extraction.summary.num_strings||0, l:"Strings"},
    {i:"\u2699", v:DATA.extraction.summary.total_instructions||0, l:"Instructions"},
    {i:"\u{1F52D}", v:DATA.malapi.length, l:"MalAPI"},
    {i:"\u{1F310}", v:(DATA.ioc.domains||[]).length+(DATA.ioc.ips||[]).length, l:"IOCs"},
    {i:"\u{1F6E1}", v:DATA.capa.capabilities.length, l:"Caps"},
  ];
  el.innerHTML = s.map(x=>`<div class="stat-card"><div class="si">${x.i}</div><div class="sv">${x.v}</div><div class="sl">${x.l}</div></div>`).join("");
})();

/* ═══ Detail panel (VT-style info blocks) ═══ */
const detailEl = document.getElementById("detail");
const detailClose = document.getElementById("detailClose");
if (detailClose) detailClose.onclick = () => detailEl.classList.remove("open");
document.addEventListener("keydown", e => { if (e.key === "Escape") detailEl.classList.remove("open"); });

function kv(k, v) {
  if (v === undefined || v === null || v === "") return "";
  return '<div class="dt-kv"><span class="k">' + esc(k) + '</span><span class="v">' + esc(v) + '</span></div>';
}
function sect(name) { return '<div class="dt-sect">' + esc(name) + '</div>'; }
function hex(n) { return typeof n === "number" ? "0x" + n.toString(16) : String(n || ""); }

function renderResults(results) {
  if (!results || !results.length) return '<div class="dt-empty">No result data for this block.</div>';
  let html = "";
  for (const r of results) {
    const t = r.type || "";
    if (t === "hash") {
      html += sect("Hashes") + kv("SHA-256", r.value || "");
    } else if (t === "tlsh") {
      html += kv("TLSH", r.value || "");
    } else if (t === "fileinfo") {
      const e = r.entry || {};
      html += sect("File") + kv("Filename", e.filename) + kv("Size", e.size_human)
            + kv("Magic", e.file_magic) + kv("Format", e.format)
            + kv("Executable", e.is_executable ? "yes" : "no");
    } else if (t === "extraction_summary") {
      const e = r.entry || {};
      html += sect("Extraction") + kv("Format", e.format) + kv("Entry", e.entrypoint)
            + kv("Sections", e.num_sections) + kv("Strings", e.num_strings)
            + kv("Instructions", e.total_instructions) + kv("IAT entries", e.num_iat_entries)
            + kv("Machine", e.machine) + kv("Packed", e.is_packed ? "yes" : "no")
            + kv("Signed", e.is_signed ? "yes" : "no");
    } else if (t === "analysis") {
      const e = r.entry || {};
      html += sect("radare2 Analysis") + kv("Functions", e.functions)
            + kv("Files", e.files) + kv("Errors", e.errors);
    } else if (t === "files") {
      const list = Array.isArray(r.entry) ? r.entry : [];
      if (list.length) {
        html += sect("Analyzed Files");
        html += '<div class="dt-chips">' + list.map(f => '<span class="dt-chip">' + esc(f) + '</span>').join("") + '</div>';
      }
    } else if (t === "entrypoint") {
      html += kv("Entrypoint", r.value || "");
    } else if (t === "function") {
      const e = r.entry || {};
      html += sect("Function") + kv("Name", e.name) + kv("Offset", hex(e.offset))
            + kv("Size", (e.size || 0) + " B") + kv("Basic blocks", e.blocks)
            + kv("Pure", e.is_pure ? "yes" : "no");
    } else if (t === "section") {
      const e = r.entry || {};
      html += sect("Section") + kv("Name", e.name) + kv("VA", hex(e.virtual_address))
            + kv("Size", (e.size || 0) + " B")
            + kv("Entropy", (e.entropy != null ? Number(e.entropy).toFixed(3) : ""))
            + kv("χ²", e.chi2 != null ? Math.round(e.chi2) : "")
            + kv("SHA-256", e.sha256 ? e.sha256.slice(0, 32) + "…" : "");
      if (e.entropy > 7.2) html += '<div class="dt-attacks"><span>HIGH ENTROPY (packed/encrypted?)</span></div>';
    } else if (t === "import_list") {
      const imps = r.imports || [];
      html += sect("Imports (" + imps.length + ") in " + (r.dll || ""));
      html += '<div class="dt-chips">' + imps.map(i =>
        '<span class="dt-chip' + (i.flagged ? " flag" : "") + '">' + esc(i.name) +
        (i.delay ? " [delay]" : "") + (i.ordinal ? " [ord]" : "") + '</span>').join("") + '</div>';
    } else if (t === "capability") {
      const e = r.entry || {};
      html += sect("Capability") + kv("Namespace", e.namespace) + kv("Scope", e.scope)
            + kv("Matches", e.match_count);
      if (e.description) html += '<div class="dt-desc">' + esc(e.description) + '</div>';
      const att = (e.attack || []).map(a => a.id || a).filter(Boolean);
      const mbc = (e.mbc || []).map(m => m.id || m).filter(Boolean);
      if (att.length) html += sect("ATT&CK") + '<div class="dt-chips">' + att.map(a => '<span class="dt-chip">' + esc(a) + '</span>').join("") + '</div>';
      if (mbc.length) html += sect("MBC") + '<div class="dt-chips">' + mbc.map(m => '<span class="dt-chip">' + esc(m) + '</span>').join("") + '</div>';
      if ((e.addresses || []).length) html += kv("Addresses", e.addresses.length);
    } else if (t === "ioc") {
      html += sect("IOC") + kv("Kind", r.kind) + kv("Value", r.value);
    } else if (t === "family") {
      const e = r.entry || {};
      html += sect("Family Hint") + kv("Keyword", e.keyword)
            + kv("Classification", e.classification) + kv("Found in", e.in_string);
    } else if (t === "malapi") {
      const e = r.entry || {};
      const d = e.data || {};
      html += sect("MalAPI") + kv("Function", e.function) + kv("DLL", d.dll)
            + kv("Name", d.name);
      if ((d.attacks || []).length) {
        html += '<div class="dt-attacks">' + d.attacks.map(a => '<span>' + esc(a) + '</span>').join("") + '</div>';
      }
      if (d.description) html += '<div class="dt-desc">' + esc(d.description) + '</div>';
      if (d.source) html += sect("Source") + '<code>' + esc(d.source) + '</code>';
    } else if (t === "type" || t === "ioc_summary") {
      html += kv(r.label || "Info", r.value || "");
    } else {
      /* generic fallback — show known keys */
      const keys = Object.keys(r).filter(k => k !== "type");
      if (keys.length) {
        html += sect(t || "Result");
        for (const k of keys) html += kv(k, typeof r[k] === "object" ? JSON.stringify(r[k]) : r[k]);
      }
    }
  }
  return html;
}

function showDetail(title, body, meta) {
  document.getElementById("detailTitle").textContent = title || "";
  const badge = document.getElementById("detailBadge");
  const sub = document.getElementById("detailSub");
  const type = (meta && meta.type) || "info";
  const color = TC[type] || "#38bdf8";
  badge.textContent = TL[type] || type.toUpperCase();
  badge.style.background = color + "1a";
  badge.style.color = color;
  badge.style.borderColor = color + "66";
  sub.textContent = (meta && meta.sub) || "";

  let html = "";
  if (meta && meta.connections != null)
    html += sect("Connections") + kv("Edges", meta.connections) + kv("Node ID", meta.id || "");
  if (typeof body === "string") {
    html += sect("Details") + '<pre style="white-space:pre-wrap;font-family:var(--mono);font-size:13px;margin:0">' + esc(body) + '</pre>';
  } else if (body && typeof body === "object" && typeof body.html === "string") {
    /* The caller built the whole panel (a STIX object, say) and only wants
       the drawer's chrome around it. */
    html += body.html;
  } else if (Array.isArray(body)) {
    html += renderResults(body);
  } else if (body && typeof body === "object") {
    html += renderResults(body.results || []);
    if (body.fields) html += sect("Fields") + Object.entries(body.fields).map(([k, v]) => kv(k, v)).join("");
  } else if (body != null) {
    html += sect("Details") + esc(String(body));
  } else {
    html += '<div class="dt-empty">No result data for this block.</div>';
  }
  document.getElementById("detailBody").innerHTML = html;
  detailEl.classList.add("open");
}

/* ═══ External tooling: xxd dump (colourised zones + copy) ═══ */
function renderXxd() {
  const el = document.getElementById("xxdBody");
  if (!el) return;
  const raw = el.textContent || "";
  if (!raw.trim()) { el.textContent = "No xxd output available."; return; }

  // xxd rows look like: "00000000: 4d 5a ... ff 00  |MZ....|"
  // Colour three zones separately: offset (yellow), bytes (green), ASCII (fg).
  const frag = document.createDocumentFragment();
  const lines = raw.replace(/\n$/, "").split("\n");
  for (const line of lines) {
    const row = document.createElement("div");
    row.className = "hexrow";
    const colon = line.indexOf(":");
    if (colon === -1) {
      row.textContent = line;
    } else {
      const off = document.createElement("span");
      off.style.color = "var(--yellow)";
      off.textContent = line.slice(0, colon + 1);
      row.appendChild(off);

      const firstPipe = line.indexOf("|", colon + 1);
      const lastPipe = line.lastIndexOf("|");
      if (firstPipe === -1 || lastPipe === firstPipe) {
        const rest = document.createElement("span");
        rest.style.color = "var(--green)";
        rest.textContent = line.slice(colon + 1);
        row.appendChild(rest);
      } else {
        const bytes = document.createElement("span");
        bytes.style.color = "var(--green)";
        bytes.textContent = line.slice(colon + 1, firstPipe);
        row.appendChild(bytes);

        const bar1 = document.createElement("span");
        bar1.style.color = "var(--cyan)";
        bar1.textContent = "|";
        row.appendChild(bar1);

        const ascii = document.createElement("span");
        ascii.style.color = "var(--fg)";
        ascii.textContent = line.slice(firstPipe + 1, lastPipe);
        row.appendChild(ascii);

        const bar2 = document.createElement("span");
        bar2.style.color = "var(--cyan)";
        bar2.textContent = "|";
        row.appendChild(bar2);

        if (lastPipe + 1 < line.length) {
          const tail = document.createElement("span");
          tail.style.color = "var(--dim)";
          tail.textContent = line.slice(lastPipe + 1);
          row.appendChild(tail);
        }
      }
    }
    frag.appendChild(row);
  }
  el.textContent = "";
  el.appendChild(frag);

  const btn = document.getElementById("copyXxd");
  if (btn && !btn.dataset.wired) {
    btn.dataset.wired = "1";
    btn.addEventListener("click", () => {
      navigator.clipboard && navigator.clipboard.writeText(raw);
      btn.textContent = "✓ Copied";
      setTimeout(() => { btn.classList.remove("copied"); btn.textContent = "Copy Preview"; }, 1500);
    });
  }
}
(function () {
  if (!document.getElementById("xxdBody")) return;
  window.addEventListener("load", () => { try { renderXxd(); } catch (e) { console.error("xxd render failed", e); } });
})();

/* ═══════════════════════════════════════════════════════════════════════════
   IOC threat map — real geography, fully offline
   ───────────────────────────────────────────────────────────────────────────
   Bubble = a country the CTI providers (or, as a clearly labelled fallback, the
   ccTLD) placed at least one IOC in. Country outlines come from the vendored
   world-atlas TopoJSON, so nothing is fetched at view time (file:// safe).
   ═══════════════════════════════════════════════════════════════════════════ */
const VCOLOR = {malicious:"#f43f5e",suspicious:"#f59e0b",unknown:"#06b6d4",
                benign:"#10b981",informational:"#38bdf8"};
const VRANK = {malicious:3,suspicious:2,unknown:1,benign:0,informational:0};
const KIND_SHORT = {ip:"ip",domain:"dom",url:"url",email:"mail"};
function vColor(v) { return VCOLOR[v] || VCOLOR.unknown; }
function vRank(v) { return VRANK[v] == null ? 1 : VRANK[v]; }

let threatView = "geo", geoKind = "all", geoZoom = null;
let _worldFC = null, _ctry = null, _ctryRev = {};
let geoState = {rows: [], items: [], arcs: [], pos: {}};

/* Vendored table: alpha-2 -> {n: name, c3: iso numeric, ll: [lon, lat]}. */
function loadAssets() {
  if (!_ctry) {
    try { _ctry = JSON.parse(document.getElementById("countries").textContent || "{}"); }
    catch (e) { _ctry = {}; }
    _ctry.codes = _ctry.codes || {};
    for (const cc in _ctry.codes) {
      const c3 = String(parseInt(_ctry.codes[cc].c3, 10));
      if (c3 && c3 !== "NaN") _ctryRev[c3] = cc;
    }
  }
  return _ctry;
}
function ccName(cc) { loadAssets(); const c = _ctry.codes[cc]; return c && c.n ? c.n : cc; }
function ccLatLon(cc) { loadAssets(); const c = _ctry.codes[cc]; return (c && c.ll) ? c.ll : null; }
function ccOfFeature(f) {
  if (f == null || f.id == null) return "";
  return _ctryRev[String(parseInt(f.id, 10))] || "";
}

/* Minimal TopoJSON -> GeoJSON decoder (only what world-atlas emits:
   MultiPolygon/Polygon with quantized, delta-encoded arcs). */
function decodeTopo(topo) {
  const objs = topo && topo.objects ? topo.objects : {};
  const obj = objs.countries || objs.land || objs.landm;
  if (!obj || !obj.geometries) return {type: "FeatureCollection", features: []};
  const tr = topo.transform || {};
  const sc = tr.scale || [1, 1], tl = tr.translate || [0, 0];
  const arcs = (topo.arcs || []).map(a => {
    let x = 0, y = 0;
    return a.map(p => {
      x += p[0]; y += p[1];
      return [x * sc[0] + tl[0], y * sc[1] + tl[1]];
    });
  });
  const getArc = i => (i < 0 ? arcs[~i].slice().reverse() : arcs[i]);
  const ring = idxs => {
    const out = [];
    for (const i of idxs) {
      const a = getArc(i);
      for (let k = out.length ? 1 : 0; k < a.length; k++) out.push(a[k]);
    }
    return out;
  };
  const geom = g => {
    if (!g || !g.arcs) return null;
    if (g.type === "Polygon") return {type: "Polygon", coordinates: g.arcs.map(ring)};
    if (g.type === "MultiPolygon") return {type: "MultiPolygon", coordinates: g.arcs.map(p => p.map(ring))};
    return null;
  };
  const features = [];
  for (const g of obj.geometries) {
    const geometry = geom(g);
    if (geometry) features.push({type: "Feature", id: g.id,
                                 properties: g.properties || {}, geometry: geometry});
  }
  return {type: "FeatureCollection", features: features};
}

/* Aggregate the payload's IOC records per country honouring the kind filter. */
function geoBuild() {
  const all = ((DATA.geo || {}).items) || [];
  const items = all.filter(it => geoKind === "all" || it.kind === geoKind);
  const byCc = {};
  for (const it of items) {
    const g = byCc[it.cc] || (byCc[it.cc] = {cc: it.cc, n: 0, worst: "unknown",
                                             kinds: {}, items: [], asns: []});
    g.n++;
    g.items.push(it);
    g.kinds[it.kind] = (g.kinds[it.kind] || 0) + 1;
    if (vRank(it.verdict) > vRank(g.worst)) g.worst = it.verdict;
    const asn = (it.asn || "") + " " + (it.asn_name || "");
    if (it.asn && g.asns.indexOf(asn.trim()) < 0) g.asns.push(asn.trim());
  }
  const rows = Object.keys(byCc).map(k => byCc[k])
    .sort((a, b) => b.n - a.n || (a.cc < b.cc ? -1 : 1));

  const byAsn = {}, seen = {}, arcs = [];
  for (const it of items) {
    if (!it.asn) continue;
    (byAsn[it.asn] = byAsn[it.asn] || {})[it.cc] = 1;
  }
  for (const asn in byAsn) {
    const ccs = Object.keys(byAsn[asn]).sort();
    for (let i = 0; i < ccs.length; i++)
      for (let j = i + 1; j < ccs.length; j++) {
        const key = ccs[i] + "|" + ccs[j];
        if (seen[key]) { if (seen[key].asns.indexOf(asn) < 0) seen[key].asns.push(asn); continue; }
        seen[key] = {a: ccs[i], b: ccs[j], asns: [asn]};
        arcs.push(seen[key]);
      }
  }
  geoState = {rows: rows, items: items, arcs: arcs, pos: {}};
  return geoState;
}

/* ═══ Threat Map: info graph (VT-style D3 force) ═══ */
let threatFilter = "all";




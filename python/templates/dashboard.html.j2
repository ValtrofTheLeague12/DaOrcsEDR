/* Detail panel for a single IOC record. */
function showIocDetail(it) {
  let html = sect("IOC") + kv("Value", it.value) + kv("Kind", it.kind)
           + kv("Verdict", it.verdict) + kv("CTI score", it.score);
  if (it.cc) html += kv("Country", ccName(it.cc) + " (" + it.cc + ")")
                   + kv("Country source", it.source === "tld" ? "inferred from TLD" : "CTI provider");
  if (it.asn) html += sect("Network") + kv(it.asn, it.asn_name || "")
                   + kv("Org", it.org) + kv("Registrar", it.registrar);
  if ((it.resolved_ips || []).length) html += kv("Resolved IPs", it.resolved_ips.join(", "));
  if (it.reason) html += sect("Provider note") + kv("Reason", it.reason);
  if (it.skip_reason) html += kv("Skipped", it.skip_reason);
  if ((it.families || []).length)
    html += sect("Families") + '<div class="dt-attacks">' +
            it.families.map(f => "<span>" + esc(f) + "</span>").join("") + "</div>";
  if ((it.findings || []).length)
    html += sect("Findings") + '<ul class="dt-list">' + it.findings.map(f =>
      '<li><div class="li-main">' + esc(f.provider) + '</div><div class="li-sub">' +
      esc(f.summary) + (f.verdict ? " · " + esc(f.verdict) : "") + "</div></li>").join("") + "</ul>";
  showDetail(it.value, html, {type: "ioc",
    sub: it.kind + (it.cc ? " · " + it.cc : ""), id: it.cc || it.kind});
}

/* Detail panel for one country bubble / side-panel row. */
function geoDetail(cc) {
  const row = geoState.rows.filter(r => r.cc === cc)[0];
  if (!row) return;
  const sorted = row.items.slice().sort((a, b) =>
    vRank(b.verdict) - vRank(a.verdict) || String(a.kind).localeCompare(String(b.kind)));
  let html = sect("Location") + kv("Country", ccName(cc) + " (" + cc + ")")
           + kv("IOCs", row.n) + kv("Worst verdict", row.worst)
           + kv("Kinds", Object.keys(row.kinds).map(k => k + " × " + row.kinds[k]).join(", "));
  if (row.asns.length) {
    html += sect("ASN / hosting");
    for (const a of row.asns) {
      const bits = a.split(" ");
      html += kv(bits[0], bits.slice(1).join(" ") || "—");
    }
  }
  html += sect("IOCs (" + sorted.length + ")");
  html += '<ul class="dt-list">' + sorted.map(it => {
    const bits = [];
    if (it.asn) bits.push(it.asn + (it.asn_name ? " " + it.asn_name : ""));
    if (it.verdict && it.verdict !== "unknown") bits.push("verdict: " + it.verdict);
    if (it.source === "tld") bits.push("country inferred from TLD");
    if (it.reason) bits.push(it.reason);
    const f = (it.findings || []).length
      ? '<div class="li-sub">' + it.findings.map(x =>
          esc((x.provider || "?") + ": " + (x.summary || ""))).join("<br>") + "</div>"
      : "";
    return '<li><div class="li-main">' + esc(it.value) +
           ' <span class="mono" style="color:var(--dim)">[' + esc(it.kind) + "]</span></div>" +
           (bits.length ? '<div class="li-sub">' + esc(bits.join(" · ")) + "</div>" : "") +
           f + "</li>";
  }).join("") + "</ul>";
  showDetail(ccName(cc), html, {type: "ioc", sub: row.n + " IOC(s) · " + cc, id: cc});
}


/* Static (non-simulated) layout for the info graph: one column per info-block
   type, root linked to every node so nothing appears orphaned. Kept separate
   from drawInfoGraph() so it can also be unit-tested / reused. */
function drawInfoGraphStatic(svg, W, H, gd) {
  const raw = (gd.nodes || []).filter(n => n.id !== "root");
  const root = {id:"root", label:DATA.fileinfo.filename || "sample", type:"sample", sub:(DATA.hash.sha256 || "").slice(0,20), results:[
    {type:"hash",value:DATA.hash.sha256 || ""},{type:"fileinfo",entry:DATA.fileinfo || {}},
    {type:"extraction_summary",entry:(DATA.extraction || {}).summary || {}}
  ]};
  const nodes = [root].concat(raw.map(n => ({...n, results:n.results || [{type:"note",value:"No result data"}]})));
  const byId = new Map(nodes.map(n => [n.id, n]));
  const order = ["analysis","function","section","dll","capability","ioc","family","malicious"];
  const groups = new Map(); for (const n of raw) { const t=n.type || "section"; if (!groups.has(t)) groups.set(t,[]); groups.get(t).push(n); }
  const cols = Math.max(1, groups.size), colW = Math.max(190, (W - 80) / cols);
  const pos = new Map([["root",{x:W/2,y:H/2}]]);
  [...groups.entries()].sort((a,b)=>order.indexOf(a[0])-order.indexOf(b[0])).forEach(([type,items],ci)=>{
    items.forEach((n,i)=>pos.set(n.id,{x:55+ci*colW+Math.min(55,colW/2-55), y:42+i*46}));
  });
  const g = svg.append("g").attr("class","info-static");
  // Root links to every info block (not just the first) so nothing renders as
  // visually orphaned; explicit cross-links from the payload are kept too.
  const links = raw.map(n => ({source:"root", target:n.id}))
    .concat((gd.links || []).filter(e=>byId.has(e.source)&&byId.has(e.target)));
  const line = g.append("g").selectAll("line").data(links).join("line").attr("class","gedge")
    .attr("x1",e=>pos.get(e.source)?pos.get(e.source).x:pos.get("root").x).attr("y1",e=>pos.get(e.source)?pos.get(e.source).y:pos.get("root").y)
    .attr("x2",e=>pos.get(e.target).x).attr("y2",e=>pos.get(e.target).y);
  const ng = g.append("g").selectAll("g").data(nodes).join("g").attr("class","gnode info-node")
    .attr("data-id",d=>d.id).attr("data-type",d=>d.type)
    .attr("transform",d=>`translate(${pos.get(d.id).x},${pos.get(d.id).y})`);
  ng.append("rect").attr("class","info-box").attr("x",-82).attr("y",-18).attr("width",164).attr("height",36);
  ng.append("circle").attr("class","core").attr("cx",-68).attr("cy",0).attr("r",6).attr("fill",d=>TC[d.type]||"#4d8dff");
  ng.append("text").attr("class","node-label").attr("x",-55).attr("y",-1).text(d=>{const s=String(d.label||d.id);return s.length>22?s.slice(0,21)+"…":s;});
  ng.append("text").attr("class","node-sub").attr("x",-55).attr("y",11).text(d=>String(d.sub||d.type||"").slice(0,25));
  ng.append("title").text(d=>d.label||d.id);
  ng.on("click",(ev,d)=>{ev.stopPropagation();showDetail(d.label,d.results||[],{type:d.type,sub:d.sub||"",id:d.id,connections:links.filter(e=>(e.source===d.id||e.target===d.id)).length});});
  ng.on("mouseenter",function(ev,d){
    const near = new Set([d.id]);
    links.forEach(e => { if (e.source===d.id) near.add(e.target); if (e.target===d.id) near.add(e.source); });
    ng.classed("dimmed", n => !near.has(n.id));
    line.classed("dimmed", e => e.source!==d.id && e.target!==d.id).classed("highlighted", e => e.source===d.id || e.target===d.id);
  }).on("mouseleave", () => { ng.classed("dimmed", false); line.classed("dimmed", false).classed("highlighted", false); });
  const st=document.getElementById("threatStats"); if(st) st.innerHTML=`<div class="stat-card"><div class="sv">${raw.length}</div><div class="sl">Info Blocks</div></div><div class="stat-card"><div class="sv">${links.length}</div><div class="sl">Relationships</div></div>`;
  return {nodeEls: ng, edgeEls: line};
}

function drawInfoGraph() {
  const svgEl = document.getElementById("threatSvg");
  if (!svgEl) return;
  const W = svgEl.clientWidth || 900, H = svgEl.clientHeight || 600;
  const svg = d3.select(svgEl);
  svg.selectAll("*").remove();
  svg.attr("viewBox", `0 0 ${W} ${H}`);

  const gd = DATA.threat_graph || {nodes:[],links:[]};
  if (!gd.nodes || !gd.nodes.length) {
    svg.append("text").attr("class", "graph-empty").attr("x", W / 2).attr("y", H / 2)
      .text("No information blocks are available for this sample.");
    document.querySelectorAll(".fbtn[data-filter]").forEach(btn => { btn.onclick = null; });
    return;
  }
  const { nodeEls, edgeEls } = drawInfoGraphStatic(svg, W, H, gd);

  /* click empty space -> close the detail panel, same as the geo view */
  svg.on("click", () => detailEl.classList.remove("open"));

  /* filters (info graph only — the geo view uses .kbtn chips) */
  document.querySelectorAll(".fbtn[data-filter]").forEach(btn => {
    btn.onclick = () => {
      document.querySelectorAll(".fbtn[data-filter]").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      threatFilter = btn.dataset.filter;
      nodeEls.style("display", n =>
        threatFilter === "all" || n.type === threatFilter || n.id === "root" ? null : "none");
      edgeEls.style("display", e => {
        if (threatFilter === "all") return null;
        const sType = (e.source === "root") ? "root" : (byIdType(gd, e.source) || "root");
        const tType = (e.target === "root") ? "root" : (byIdType(gd, e.target) || "root");
        return sType === threatFilter || tType === threatFilter || sType === "root" || tType === "root" ? null : "none";
      });
    };
  });
}

/* Small helper for the filter above: looks up a node's type by id without
   keeping a second closure-scoped map alive between drawInfoGraph() calls. */
function byIdType(gd, id) {
  const n = (gd.nodes || []).find(n => n.id === id);
  return n ? n.type : null;
}


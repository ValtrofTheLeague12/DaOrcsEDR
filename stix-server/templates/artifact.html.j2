<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#080d12">
    <title>DAORCS · {{ a.sample_name | default("Artifact") }}</title>
    <link rel="stylesheet" href="{{ css_url | default('static/css/catalog.css') }}">
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <div class="ambient ambient-three" aria-hidden="true"></div>

    {% set download_href = a.download_url | default('/download/' ~ a.sample_name) %}
    {% set own_password = (bundle_passwords | default({})).get(a.sample_name) %}
    {% set archive_password = own_password or bundle_password %}

    <div class="app-shell">

      <header class="topbar">
        <a class="brand" href="/" aria-label="DAORCS home">
          <pre class="brand-logo">{{ logo }}</pre>
          <span class="brand-copy">
            <strong>DAORCS</strong>
            <span>THREAT INTELLIGENCE</span>
          </span>
        </a>
        <div class="topbar-right">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="status-label">Artifact detail</span>
          {% if current_user %}
          <span class="user-chip" title="Signed in from {{ current_user.ip }}">
            <span class="user-dot" aria-hidden="true"></span>{{ current_user.username }}
          </span>
          <form class="logout-form" method="post" action="/logout">
            <button class="logout-btn" type="submit">Log out</button>
          </form>
          {% endif %}
        </div>
      </header>

      <main>

        <section class="hero hero-detail">
          <div class="hero-copy">
            <p class="eyebrow"><span>01</span> ARTIFACT DETAIL</p>
            <h1><span>{{ a.sample_name | default("Unknown") }}</span></h1>
            <p class="hero-desc">
              Extracted metadata from the verified evidence bundle: identity,
              size, PE sections and a disassembly excerpt.
            </p>
          </div>
          <div class="detail-actions">
            <a class="link-btn link-btn-primary" href="{{ download_href }}" download>
              Download bundle <span aria-hidden="true">↓</span>
            </a>
            {% if a.mega_link %}
            <a class="link-btn" href="{{ a.mega_link }}" target="_blank" rel="noopener noreferrer">
              MEGA <span aria-hidden="true">↗</span>
            </a>
            {% endif %}
            <a class="link-btn link-btn-quiet" href="/">Back to catalog</a>
          </div>
        </section>

        <section class="detail-section" aria-labelledby="identity-title">
          <div class="section-header">
            <div>
              <p class="eyebrow"><span>02</span> IDENTITY</p>
              <h2 id="identity-title">Sample metadata</h2>
            </div>
            {% if a.hash_verified %}
            <span class="pill pill-ok">HASH VERIFIED</span>
            {% endif %}
          </div>
          <dl class="detail-grid">
            <div>
              <dt>Sample name</dt>
              <dd>{{ a.sample_name | default("Unknown") }}</dd>
            </div>
            <div>
              <dt>Bundle</dt>
              <dd>{{ a.bundle_name | default("—") }}</dd>
            </div>
            <div>
              <dt>File size</dt>
              <dd>
                {% if a.sample_size_human %}{{ a.sample_size_human }}
                {% elif a.sample_size %}{{ a.sample_size }} B
                {% else %}—{% endif %}
              </dd>
            </div>
            <div>
              <dt>Archive size</dt>
              <dd>{{ a.archive_size_human | default("—") or "—" }}</dd>
            </div>
            <div>
              <dt>Submitted</dt>
              <dd>
                {% if a.submitted_at %}
                <time datetime="{{ a.submitted_at }}">{{ a.submitted_at }}</time>
                {% else %}—{% endif %}
              </dd>
            </div>
            <div>
              <dt>Evidence files</dt>
              <dd>{{ a.file_count | default(0) }}</dd>
            </div>
            <div>
              <dt>Protection</dt>
              <dd>
                {% if a.encrypted %}
                <span class="badge badge-enc">AES-256</span>
                {% if own_password %}
                <span class="badge badge-scope">OWN PASSWORD</span>
                {% elif bundle_password %}
                <span class="badge badge-scope">SHARED PASSWORD</span>
                {% endif %}
                {% else %}Plain archive{% endif %}
              </dd>
            </div>
            {% if a.encrypted and archive_password %}
            <div class="detail-grid-wide password-detail">
              <dt>Archive password</dt>
              <dd>
                <span class="hash-wrap">
                  <code class="password">{{ archive_password }}</code>
                  <button type="button" class="link-btn password-copy"
                          data-copy="{{ archive_password }}">Copy</button>
                </span>
                <span class="password-hint-inline">
                  {% if own_password %}
                  WinZip AES-256 — generated for this bundle alone; it opens
                  no other artifact's archive.
                  {% else %}
                  WinZip AES-256 — the shared archive password; required to
                  extract the downloaded bundle.
                  {% endif %}
                </span>
              </dd>
            </div>
            {% endif %}
            <div class="detail-grid-wide">
              <dt>SHA-256</dt>
              <dd>
                {% if a.sha256 %}
                <code class="hash" title="{{ a.sha256 }}">{{ a.sha256 }}</code>
                {% else %}—{% endif %}
              </dd>
            </div>
          </dl>
        </section>

        <section class="detail-section" aria-labelledby="sections-title">
          <div class="section-header">
            <div>
              <p class="eyebrow"><span>03</span> LAYOUT</p>
              <h2 id="sections-title">PE sections</h2>
            </div>
            <span class="pill">{{ a.sections | length }} SECTIONS</span>
          </div>
          {% if a.sections %}
          <div class="table-wrap">
            <table class="sections-table">
              <thead>
                <tr>
                  <th scope="col">Section</th>
                  <th scope="col">Virtual address</th>
                  <th scope="col">Size</th>
                  <th scope="col">Entropy</th>
                </tr>
              </thead>
              <tbody>
                {% for section in a.sections %}
                <tr>
                  <td><code>{{ section.name }}</code></td>
                  <td>
                    {% if section.virtual_address is not none %}
                    <code>0x{{ "%x" | format(section.virtual_address) }}</code>
                    {% else %}—{% endif %}
                  </td>
                  <td>
                    {% if section.size is not none %}
                    {{ section.size }} B
                    {% else %}—{% endif %}
                  </td>
                  <td>
                    {% if section.entropy is not none %}
                    {{ "%.2f" | format(section.entropy) }}
                    {% else %}—{% endif %}
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <p class="detail-empty">No section table was extracted for this bundle.</p>
          {% endif %}
        </section>

        <section class="detail-section" aria-labelledby="asm-title">
          <div class="section-header">
            <div>
              <p class="eyebrow"><span>04</span> DISASSEMBLY</p>
              <h2 id="asm-title">Assembly excerpt</h2>
            </div>
            {% if a.asm_truncated %}
            <span class="pill">TRUNCATED</span>
            {% endif %}
          </div>
          {% if a.asm %}
          <pre class="asm-block">{{ a.asm }}</pre>
          {% if a.asm_truncated %}
          <p class="detail-empty">Only the first entries are shown; download the bundle for the full disassembly.</p>
          {% endif %}
          {% else %}
          <p class="detail-empty">No disassembly was extracted for this bundle.</p>
          {% endif %}
        </section>

      </main>

      <footer class="footer">
        <span>DAORCS EDR <span class="sep">/</span> THREAT INTELLIGENCE</span>
        <span>Evidence catalog — hash-verified only</span>
      </footer>

    </div>
    <script>
      document.querySelectorAll('[data-copy]').forEach(function (button) {
        button.addEventListener('click', function () {
          var value = button.getAttribute('data-copy') || '';
          if (!navigator.clipboard || !navigator.clipboard.writeText) return;
          navigator.clipboard.writeText(value).then(function () {
            var label = button.textContent;
            button.textContent = 'Copied';
            window.setTimeout(function () { button.textContent = label; }, 1500);
          });
        });
      });
    </script>
  </body>
</html>

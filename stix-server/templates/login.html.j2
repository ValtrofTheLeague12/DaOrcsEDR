<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#080d12">
    <meta name="robots" content="noindex, nofollow">
    <title>DAORCS · Sign in</title>
    <link rel="stylesheet" href="{{ css_url | default('static/css/catalog.css') }}">
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <div class="ambient ambient-three" aria-hidden="true"></div>

    <div class="app-shell auth-shell">

      <header class="topbar">
        <a class="brand" href="/login" aria-label="DAORCS sign in">
          <pre class="brand-logo">{{ logo }}</pre>
          <span class="brand-copy">
            <strong>DAORCS</strong>
            <span>THREAT INTELLIGENCE</span>
          </span>
        </a>
        <div class="topbar-right">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="status-label">Restricted access</span>
        </div>
      </header>

      <main class="auth-main">
        <section class="auth-card" aria-labelledby="login-title">
          <div class="auth-head">
            <p class="eyebrow"><span>01</span> OPERATOR SIGN IN</p>
            <h1 id="login-title">Access the <span>catalog</span></h1>
            <p class="auth-desc">
              Credentials are checked against the authorized user list, and this
              connection's address must match the IP provisioned for that account.
            </p>
          </div>

          {% if error %}
          <div class="auth-error" role="alert">
            <span class="auth-error-mark" aria-hidden="true">!</span>
            <span>{{ error }}</span>
          </div>
          {% endif %}

          <form class="auth-form" method="post" action="/login" autocomplete="on">
            <input type="hidden" name="next" value="{{ next_path | default('/') }}">
            <label class="auth-field">
              <span>Username</span>
              <input
                type="text"
                name="username"
                required
                autofocus
                autocomplete="username"
                spellcheck="false"
                autocapitalize="none">
            </label>
            <label class="auth-field">
              <span>Password</span>
              <input
                type="password"
                name="password"
                required
                autocomplete="current-password">
            </label>
            <button class="auth-submit" type="submit">
              Sign in <span aria-hidden="true">→</span>
            </button>
          </form>

          <div class="auth-meta">
            <span class="auth-meta-label">CLIENT ADDRESS</span>
            <code class="auth-meta-value">{{ client_ip or "unavailable" }}</code>
          </div>
        </section>
      </main>

      <footer class="footer">
        <span>DAORCS EDR <span class="sep">/</span> THREAT INTELLIGENCE</span>
        <span>Authorized operators only</span>
      </footer>

    </div>
  </body>
</html>

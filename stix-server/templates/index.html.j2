<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#080d12">
    <title>DAORCS · Threat Intelligence</title>
    <link rel="stylesheet" href="{{ css_url | default('static/css/catalog.css') }}">
  </head>
  <body>
    <div class="ambient ambient-one" aria-hidden="true"></div>
    <div class="ambient ambient-two" aria-hidden="true"></div>
    <div class="ambient ambient-three" aria-hidden="true"></div>

    <div class="app-shell">

      <header class="topbar">
        <a class="brand" href="/" aria-label="DAORCS home">
          <pre class="brand-logo">{{ logo }}</pre>
          <span class="brand-copy">
            <strong>DAORCS</strong>
            <span>THREAT INTELLIGENCE</span>
          </span>
        </a>
        <div class="topbar-right">
          <span class="status-dot" aria-hidden="true"></span>
          <span class="status-label">Evidence catalog</span>
          {% if generated_at %}
          <span class="generated-at">{{ generated_at }}</span>
          {% endif %}
          {% if current_user %}
          <span class="user-chip" title="Signed in from {{ current_user.ip }}">
            <span class="user-dot" aria-hidden="true"></span>{{ current_user.username }}
          </span>
          <form class="logout-form" method="post" action="/logout">
            <button class="logout-btn" type="submit">Log out</button>
          </form>
          {% endif %}
        </div>
      </header>

      <main>

        <section class="hero">
          <div class="hero-copy">
            <p class="eyebrow"><span>01</span> COLLECTION OVERVIEW</p>
            <h1>Artifact <span>intelligence</span></h1>
            <p class="hero-desc">
              Collected evidence with integrity hashes, submission dates,
              and MEGA export links. Only hash-verified artifacts are shown.
            </p>
          </div>
          <div class="stat-block">
            <div class="stat">
              <span class="stat-label">ARTIFACTS</span>
              <strong class="stat-value">{{ artifacts|length }}</strong>
              <span class="stat-caption">in catalog</span>
            </div>
            <div class="stat">
              <span class="stat-label">STATUS</span>
              <strong class="stat-value verified">✓</strong>
              <span class="stat-caption">hash-verified</span>
            </div>
          </div>
        </section>

        {% set pw_map = bundle_passwords | default({}) %}
        {% set encrypted_artifacts = artifacts | selectattr('encrypted') | list %}
        {% set per_bundle_names = encrypted_artifacts
                                 | map(attribute='sample_name')
                                 | select('in', pw_map)
                                 | list %}
        {% if bundle_password and encrypted_artifacts | length > per_bundle_names | length %}
        <section class="password-banner" aria-labelledby="password-title">
          <div class="password-copy">
            <p class="eyebrow"><span>!</span> ARCHIVE PASSWORD</p>
            <h2 id="password-title">Open the encrypted downloads with this password</h2>
            <p class="password-hint">
              Bundles marked <span class="badge badge-enc">ENC</span> are WinZip
              AES-256 archives. This shared password opens the bundles that use
              it; bundles with a password of their own show theirs in their row.
            </p>
          </div>
          <div class="password-value">
            <code class="password">{{ bundle_password }}</code>
            <button type="button" class="link-btn password-copy"
                    data-copy="{{ bundle_password }}">Copy password</button>
          </div>
        </section>
        {% elif per_bundle_names %}
        <section class="password-banner" aria-labelledby="password-title">
          <div class="password-copy">
            <p class="eyebrow"><span>!</span> ARCHIVE PASSWORDS</p>
            <h2 id="password-title">Every encrypted bundle has its own password</h2>
            <p class="password-hint">
              Bundles marked <span class="badge badge-enc">ENC</span> are WinZip
              AES-256 archives, each sealed with a freshly generated password.
              Each row below shows the password that opens that bundle — one
              leaked value opens one bundle, not the catalog.
            </p>
          </div>
        </section>
        {% endif %}

        <section class="catalog-section" aria-labelledby="catalog-title">

          <div class="section-header">
            <div>
              <p class="eyebrow"><span>02</span> EVIDENCE INDEX</p>
              <h2 id="catalog-title">Collected artifacts</h2>
            </div>
            <span class="pill">{{ artifacts|length }} RECORDS</span>
          </div>

          {% if artifacts %}
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Sample</th>
                  <th scope="col">Size</th>
                  <th scope="col">Sections</th>
                  <th scope="col">SHA-256</th>
                  <th scope="col">Files</th>
                  <th scope="col">Submitted</th>
                  <th scope="col">Actions</th>
                </tr>
              </thead>
              <tbody>
                {% for a in artifacts %}
                {% set detail_href = a.artifacts_url | default('/artifact/' ~ a.sample_name) %}
                {% set download_href = a.download_url | default('/download/' ~ a.sample_name) %}
                {% set own_password = pw_map.get(a.sample_name) %}
                <tr>
                  <td class="col-sample">
                    <a class="sample-name" href="{{ detail_href }}">{{ a.sample_name | default(a.name | default("Unknown")) }}</a>
                    {% if a.bundle_name %}
                    <span class="bundle-tag">{{ a.bundle_name }}</span>
                    {% endif %}
                    {% if a.encrypted %}
                    <span class="badge badge-enc" title="AES-256 encrypted">ENC</span>
                    {% endif %}
                    {% if a.encrypted and own_password %}
                    <span class="own-password">
                      <code class="password" title="Generated for this bundle alone">{{ own_password }}</code>
                      <button type="button" class="link-btn password-copy"
                              data-copy="{{ own_password }}">Copy</button>
                    </span>
                    {% endif %}
                  </td>
                  <td class="col-size">
                    {% if a.sample_size_human %}
                    <span class="file-size">{{ a.sample_size_human }}</span>
                    {% elif a.sample_size %}
                    <span class="file-size">{{ a.sample_size }} B</span>
                    {% elif a.archive_size_human %}
                    <span class="file-size">{{ a.archive_size_human }}</span>
                    {% else %}
                    <span class="muted">—</span>
                    {% endif %}
                  </td>
                  <td class="col-sections">
                    {% if a.sections %}
                    <span class="section-count" title="{{ a.sections | map(attribute='name') | join(', ') }}">{{ a.sections | length }} sections</span>
                    <span class="section-names">{{ a.sections[:5] | map(attribute='name') | join(' · ') }}</span>
                    {% else %}
                    <span class="muted">—</span>
                    {% endif %}
                  </td>
                  <td class="col-hash">
                    {% if a.sha256 %}
                    <span class="hash-wrap">
                      <code class="hash" title="{{ a.sha256 }}">{{ a.sha256[:16] }}…</code>
                      <span class="hash-badge verified" title="Hash verified">✓</span>
                    </span>
                    {% else %}
                    <span class="muted">—</span>
                    {% endif %}
                  </td>
                  <td class="col-files">
                    {% if a.file_count %}
                    <span class="file-count">{{ a.file_count }}</span>
                    {% else %}
                    <span class="muted">—</span>
                    {% endif %}
                  </td>
                  <td class="col-date">
                    {% if a.submitted_at %}
                    <time datetime="{{ a.submitted_at }}">{{ a.submitted_at[:10] }}</time>
                    {% else %}
                    <span class="muted">—</span>
                    {% endif %}
                  </td>
                  <td class="col-link">
                    <div class="row-actions">
                      <a class="link-btn" href="{{ download_href }}" download>
                        Download <span aria-hidden="true">↓</span>
                      </a>
                      {% if a.mega_link %}
                      <a class="link-btn link-btn-mega" href="{{ a.mega_link }}" target="_blank" rel="noopener noreferrer">
                        MEGA <span aria-hidden="true">↗</span>
                      </a>
                      {% endif %}
                      <a class="link-btn link-btn-quiet" href="{{ detail_href }}">Details</a>
                    </div>
                  </td>
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>

          {% else %}
          <div class="empty-state">
            <span class="empty-icon" aria-hidden="true">◇</span>
            <h3>No artifacts collected yet</h3>
            <p>Hash-verified evidence will appear here once bundles are
               pulled from MEGA and pass the integrity check.</p>
          </div>
          {% endif %}

        </section>
      </main>

      <footer class="footer">
        <span>DAORCS EDR <span class="sep">/</span> THREAT INTELLIGENCE</span>
        <span>Evidence catalog — hash-verified only</span>
      </footer>

    </div>
    <script>
      document.querySelectorAll('[data-copy]').forEach(function (button) {
        button.addEventListener('click', function () {
          var value = button.getAttribute('data-copy') || '';
          if (!navigator.clipboard || !navigator.clipboard.writeText) return;
          navigator.clipboard.writeText(value).then(function () {
            var label = button.textContent;
            button.textContent = 'Copied';
            window.setTimeout(function () { button.textContent = label; }, 1500);
          });
        });
      });
    </script>
  </body>
</html>

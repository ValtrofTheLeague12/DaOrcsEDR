"""Flask CTI catalog server.

Auto-generated by ``host_server.py`` from ``templates/server.py.j2``.
Do not edit directly — re-run ``python host_server.py --generate-only``.

The catalog and the ban list are read on every request, from
``artifact_catalog.json`` and ``config/cti_config.json`` respectively.
The panel writes the ban list while this server is running, so caching it
at startup would make every Ban/Unban action require a restart.

Authentication
--------------
Every catalog, detail and download route is gated by the Supabase
``allowed_users`` + ``ip_list`` tables. A session cookie is signed with
``CTI_SESSION_KEY`` (or ``config/.session-key``) and bound to the client IP
that created it. ``/login``, ``/logout``, ``/health`` and ``/static/*`` are
public; ``auth.enabled`` in ``config/cti_config.json`` turns the gate off.
"""

from __future__ import annotations

import json
import logging
import os
import sys
import threading
from pathlib import Path

from flask import (
    Flask,
    abort,
    g,
    make_response,
    redirect,
    render_template,
    request,
    send_file,
    url_for,
)
from jinja2 import select_autoescape

BASE_DIR      = Path(__file__).resolve().parent
CONFIG_PATH   = BASE_DIR / "config" / "cti_config.json"
CATALOG_PATH  = BASE_DIR / "artifact_catalog.json"
LOGO_PATH     = BASE_DIR / "static" / "daorcs.logo"
EXPORT_DIR    = BASE_DIR / "exported_evidence"
SESSION_KEY_PATH = BASE_DIR / "config" / ".session-key"
BUNDLE_PASSWORD_PATH = BASE_DIR / "config" / "bundle-password"
BUNDLE_PASSWORDS_PATH = BASE_DIR / "config" / "bundle-passwords.json"

if str(BASE_DIR) not in sys.path:
    sys.path.insert(0, str(BASE_DIR))

import cti_auth  # noqa: E402  (same directory as this generated file)

ARTIFACT_NAME_FIELDS = ("sample_name", "name", "bundle_name")
ARTIFACT_HASH_FIELDS = ("sha256", "sha256_hash")

PUBLIC_ENDPOINTS = frozenset({"login", "logout", "health", "static"})
COOKIE_NAME = cti_auth.SESSION_COOKIE

_SUPABASE_CLIENT = None
_SUPABASE_LOCK = threading.Lock()


# ---------------------------------------------------------------------------
# Config / ban helpers
# ---------------------------------------------------------------------------

def _load_config() -> dict:
    try:
        # utf-8-sig tolerates a BOM from Windows editors/PowerShell writers.
        return json.loads(CONFIG_PATH.read_text(encoding="utf-8-sig"))
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise RuntimeError(f"Cannot read {CONFIG_PATH.name}: {exc}") from exc


def _parse_banned(value: object) -> set[str]:
    """Return a normalised set of banned names/hashes.

    Accepts both a flat string list (new format) and the legacy
    ``[{"name": "...", "hash": "..."}]`` object list.
    """
    if value is None:
        return set()
    if not isinstance(value, list):
        raise RuntimeError("banned_artifacts must be a JSON array")
    out: set[str] = set()
    for entry in value:
        if isinstance(entry, str):
            v = entry.strip()
            if v:
                out.add(v.lower())
        elif isinstance(entry, dict):
            for key in ("name", "hash"):
                v = entry.get(key, "")
                if isinstance(v, str) and v.strip():
                    out.add(v.strip().lower())
        else:
            raise RuntimeError(f"banned_artifacts entries must be strings or objects, got {type(entry)}")
    return out


def _artifact_identifiers(artifact: object) -> set[str]:
    """Every identifier a ban may match for one catalog row (lowercased)."""
    if not isinstance(artifact, dict):
        return set()
    out: set[str] = set()
    for field in ARTIFACT_NAME_FIELDS + ARTIFACT_HASH_FIELDS:
        v = artifact.get(field)
        if isinstance(v, str):
            s = v.strip().lower()
            if s:
                out.add(s)
    return out


def _is_banned(artifact: object, banned: set[str]) -> bool:
    return bool(banned) and bool(_artifact_identifiers(artifact) & banned)


def _visible(artifacts: list, banned: set[str]) -> list:
    if not banned:
        return artifacts
    return [a for a in artifacts if not _is_banned(a, banned)]


def _find_artifact(catalog: list, name: str):
    """Match a catalog row by artifact name, bundle name or hash."""
    wanted = name.strip().lower()
    if not wanted:
        return None
    for artifact in catalog:
        if wanted in _artifact_identifiers(artifact):
            return artifact
        if isinstance(artifact, dict):
            bundle = artifact.get("bundle_name")
            if isinstance(bundle, str) and bundle.strip().lower() == wanted:
                return artifact
    return None


def _bundle_dir(name: str) -> Path:
    """Resolve <name> or <name>_artifact inside exported_evidence/."""
    cleaned = name.strip().strip("/\\")
    if not cleaned or ".." in cleaned or "/" in cleaned or "\\" in cleaned:
        abort(404)
    root = EXPORT_DIR.resolve()
    for folder in (cleaned, f"{cleaned}_artifact"):
        candidate = (EXPORT_DIR / folder).resolve()
        try:
            candidate.relative_to(root)
        except ValueError:
            continue
        if candidate.is_dir():
            return candidate
    abort(404)


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

def _validate_config(config: dict) -> None:
    server = config.get("server")
    if not isinstance(server, dict):
        raise RuntimeError("cti_config.json must contain a 'server' object")
    host = server.get("ip")
    port = server.get("port")
    if not isinstance(host, str) or not host.strip():
        raise RuntimeError("server.ip must be a non-empty string")
    if isinstance(port, bool) or not isinstance(port, int) or not (1 <= port <= 65535):
        raise RuntimeError("server.port must be an integer 1-65535")


# ---------------------------------------------------------------------------
# Auth helpers
# ---------------------------------------------------------------------------

def _auth_settings(config: dict) -> dict:
    """Read the ``auth`` block with safe defaults (gate on by default)."""
    raw = config.get("auth") if isinstance(config, dict) else None
    raw = raw if isinstance(raw, dict) else {}

    def _int(key: str, default: int, minimum: int) -> int:
        value = raw.get(key, default)
        if isinstance(value, bool):
            return default
        try:
            return max(minimum, int(value))
        except (TypeError, ValueError):
            return default

    debug_env = os.environ.get("CTI_AUTH_DEBUG", "").strip().lower()
    return {
        "enabled": bool(raw.get("enabled", True)),
        "session_ttl_hours": _int("session_ttl_hours", cti_auth.DEFAULT_SESSION_TTL_HOURS, 1),
        "cookie_secure": bool(raw.get("cookie_secure", False)),
        "trust_proxy": bool(raw.get("trust_proxy", False)),
        "allow_loopback": bool(raw.get("allow_loopback", False)),
        "max_attempts": _int("max_attempts", 5, 1),
        "lockout_seconds": _int("lockout_seconds", 300, 1),
        # Verbose auth diagnostics. Off by default; ``CTI_AUTH_DEBUG=1`` turns
        # it on for one process without editing the saved config. No password
        # or session token is ever logged.
        "debug": bool(raw.get("debug", False)) or debug_env in ("1", "true", "yes", "on"),
    }


def _entry_fields(entry):
    """Return ``(ip_address, decision)`` for an IpListEntry or a dict row."""
    if entry is None:
        return None, None
    if isinstance(entry, dict):
        return entry.get("ip_address"), entry.get("decision")
    return getattr(entry, "ip_address", None), getattr(entry, "decision", None)


def _supabase_client():
    """Lazily build one Supabase client; None when the SDK/credentials fail."""
    global _SUPABASE_CLIENT
    with _SUPABASE_LOCK:
        if _SUPABASE_CLIENT is not None:
            return _SUPABASE_CLIENT
        supabase_dir = BASE_DIR.parent / "supabase"
        if str(supabase_dir) not in sys.path:
            sys.path.append(str(supabase_dir))
        try:
            import User as _User
            _SUPABASE_CLIENT = _User.SupabaseClient()
        except Exception:
            return None
        return _SUPABASE_CLIENT


# ---------------------------------------------------------------------------
# Flask app factory
# ---------------------------------------------------------------------------

def create_app() -> Flask:
    config = _load_config()
    _validate_config(config)

    def current_bans() -> set[str]:
        """Read the hide-list afresh; the panel edits it while we serve."""
        return _parse_banned(_load_config().get("banned_artifacts"))

    app = Flask(
        __name__,
        root_path=str(BASE_DIR),
        template_folder="templates",
        static_folder="static",
    )
    app.jinja_env.autoescape = select_autoescape(
        enabled_extensions=("html", "htm", "xml", "html.j2"),
        default_for_string=True,
    )
    app.extensions["cti_session_key"] = cti_auth.load_session_key(SESSION_KEY_PATH)
    app.extensions["cti_failures"] = cti_auth.FailureTracker()
    if _auth_settings(config)["debug"]:
        app.logger.setLevel(logging.DEBUG)
        app.logger.debug(
            "CTI auth debug logging enabled (config auth.debug or CTI_AUTH_DEBUG)")

    catalog_file = str(config.get("catalog_file", "artifact_catalog.json"))
    catalog_path = (BASE_DIR / catalog_file).resolve()
    try:
        catalog_path.relative_to(BASE_DIR)
    except ValueError:
        raise RuntimeError("catalog_file must stay inside the server directory")

    def read_catalog() -> list:
        try:
            raw = json.loads(catalog_path.read_text(encoding="utf-8"))
        except FileNotFoundError:
            raw = []
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            abort(500, description=f"Cannot read artifact catalog: {exc}")
        if not isinstance(raw, list):
            abort(500, description="Artifact catalog must be a JSON array")
        return raw

    def read_logo() -> str:
        try:
            return LOGO_PATH.read_text(encoding="utf-8")
        except (OSError, UnicodeError) as exc:
            abort(500, description=f"Cannot read logo: {exc}")

    def read_bundle_password() -> str | None:
        """The ZIP password for downloaded bundles, or None when unset.

        ``host_server.py`` copies the operator password into
        ``config/bundle-password`` (git-ignored) at generation time, so a
        deployed catalog does not need the operator's profile. The value is
        rendered only on pages behind this server's login gate; it is never
        part of the catalog JSON or the static assets. ``IA_BUNDLE_PASSWORD_FILE``
        wins when set, matching ``mega/protect.py``.
        """
        candidates = []
        override = os.environ.get("IA_BUNDLE_PASSWORD_FILE")
        if override:
            candidates.append(Path(override))
        candidates.append(BUNDLE_PASSWORD_PATH)
        for path in candidates:
            try:
                raw = path.read_bytes()
            except OSError:
                continue
            if raw.endswith(b"\r\n"):
                raw = raw[:-2]
            elif raw.endswith(b"\n"):
                raw = raw[:-1]
            try:
                return raw.decode("utf-8")
            except UnicodeDecodeError:
                return None
        return None

    def read_bundle_passwords() -> dict:
        """Per-bundle ZIP passwords as {sample_name: password}; {} when unset.

        ``host_server.py`` mirrors the values mega/protect.py generated (one
        per exported bundle) into ``config/bundle-passwords.json`` at
        generation time, and ``mega/upload.py`` keeps the file fresh after
        every export, so a deployed catalog does not need the operator's
        profile. Same rules as the shared password above: rendered only
        behind the login gate, one artifact's value on that artifact's page
        only, never in the catalog JSON or static assets. A missing or
        unreadable file is an empty mapping, not an error - bundles exported
        under the shared password simply have no entry here, and the shared
        banner still covers them.
        """
        try:
            raw = json.loads(BUNDLE_PASSWORDS_PATH.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError):
            return {}
        if not isinstance(raw, dict):
            return {}
        return {k: v for k, v in raw.items()
                if isinstance(k, str) and isinstance(v, str)}

    def settings() -> dict:
        return _auth_settings(_load_config())

    def request_address(opts: dict) -> str | None:
        return cti_auth.client_ip(
            request.remote_addr,
            request.headers.get("X-Forwarded-For"),
            opts["trust_proxy"],
        )

    def signer(opts: dict) -> cti_auth.SessionSigner:
        return cti_auth.SessionSigner(
            app.extensions["cti_session_key"],
            opts["session_ttl_hours"] * 3600,
        )

    def failures() -> cti_auth.FailureTracker:
        tracker = app.extensions["cti_failures"]
        opts = settings()
        tracker.max_attempts = opts["max_attempts"]
        tracker.window_seconds = opts["lockout_seconds"]
        return tracker

    def render_login(address, next_path, error=None, status=200):
        page = render_template(
            "login.html.j2",
            logo=read_logo(),
            client_ip=address,
            next_path=next_path,
            error=error,
            css_url=url_for("static", filename="css/catalog.css"),
        )
        return make_response(page, status)

    # -- gate ------------------------------------------------------------

    @app.before_request
    def _require_login():
        opts = settings()
        g.auth_settings = opts
        g.current_user = None
        if not opts["enabled"]:
            return None
        if request.endpoint in PUBLIC_ENDPOINTS:
            return None
        address = request_address(opts)
        token = request.cookies.get(COOKIE_NAME)
        payload, reason = signer(opts).read_with_reason(token, address)
        if payload is not None:
            g.current_user = payload
            if opts["debug"]:
                app.logger.debug(
                    "CTI gate accepted %s %s for user=%r (id=%s) from %r",
                    request.method, request.full_path, payload.get("username"),
                    payload.get("uid"), address)
            return None
        if opts["debug"]:
            app.logger.debug(
                "CTI gate rejected %s %s from %r: %s (cookie=%s)",
                request.method, request.full_path, address, reason, bool(token))
        if request.method in ("GET", "HEAD"):
            target = cti_auth.safe_next_path(request.full_path.rstrip("?"), "/")
            return redirect(url_for("login", next=target))
        return redirect(url_for("login"))

    @app.context_processor
    def _inject_auth():
        opts = g.get("auth_settings") or {}
        return {
            "current_user": g.get("current_user"),
            "auth_enabled": bool(opts.get("enabled", True)),
        }

    # -- login / logout --------------------------------------------------

    @app.route("/login", methods=["GET", "POST"])
    def login():
        opts = settings()
        address = request_address(opts)
        next_path = cti_auth.safe_next_path(
            request.values.get("next"), "/")

        if not opts["enabled"]:
            return redirect(next_path)

        active_signer = signer(opts)

        if request.method == "GET":
            if active_signer.read(request.cookies.get(COOKIE_NAME), address):
                return redirect(next_path)
            return render_login(address, next_path)

        username = (request.form.get("username") or "").strip()
        password = request.form.get("password") or ""

        if opts["debug"]:
            # Never log the password itself - only whether one was supplied.
            app.logger.debug(
                "CTI login attempt username=%r from %r next=%r password_supplied=%s",
                username, address, next_path, bool(password))

        tracker = failures()
        key = f"{username.casefold()}|{address or '-'}"
        if tracker.blocked(key):
            wait = tracker.retry_after(key)
            if opts["debug"]:
                app.logger.debug(
                    "CTI login rate-limited username=%r from %r retry_in=%ss",
                    username, address, wait)
            return render_login(
                address, next_path,
                f"Too many failed attempts. Try again in {wait} seconds.", 429)

        if not username or not password:
            tracker.record_failure(key)
            if opts["debug"]:
                app.logger.debug(
                    "CTI login rejected username=%r from %r: missing %s",
                    username, address,
                    "username" if not username else "password")
            return render_login(
                address, next_path, "Enter both a username and a password.", 400)

        client = _supabase_client()
        if client is None:
            app.logger.error("Supabase client unavailable; cannot verify logins")
            return render_login(
                address, next_path,
                "Authentication is temporarily unavailable. Contact the operator.",
                503)

        try:
            user = client.get_user_by_username(username)
            entry = client.get_ip_entry(user.id_user) if user is not None else None
        except Exception:
            app.logger.exception("Supabase lookup failed for username=%r", username)
            return render_login(
                address, next_path,
                "Authentication is temporarily unavailable. Contact the operator.",
                503)

        if user is None:
            # Spend the same bcrypt work as a real check so a missing username
            # is not measurably faster than a wrong password.
            cti_auth.burn_password_check(password)
            tracker.record_failure(key)
            if opts["debug"]:
                app.logger.debug(
                    "CTI login lookup username=%r from %r: no such account",
                    username, address)
            app.logger.warning(
                "Rejected login for username=%r from %s: unknown account",
                username, address)
            return render_login(
                address, next_path, "Invalid username or password.", 401)

        if opts["debug"]:
            stored_ip, decision = _entry_fields(entry)
            stored_hash = user.password or ""
            pepper = user.unique_peper or ""
            app.logger.debug(
                "CTI login lookup username=%r -> id=%s hash_prefix=%r hash_len=%s "
                "pepper_present=%s pepper_len=%s ip_row=%s ip_address=%r decision=%r",
                username, user.id_user, stored_hash[:7], len(stored_hash),
                bool(pepper), len(pepper), entry is not None, stored_ip, decision)

        password_ok = cti_auth.verify_password(
            password, user.password, user.unique_peper)
        if opts["debug"]:
            app.logger.debug(
                "CTI login password check username=%r from %r: %s",
                username, address, "match" if password_ok else "mismatch")
        if not password_ok:
            tracker.record_failure(key)
            app.logger.warning(
                "Rejected login for username=%r from %s: bad credentials",
                username, address)
            return render_login(
                address, next_path, "Invalid username or password.", 401)

        allowed, reason = cti_auth.check_access(
            entry, address, opts["allow_loopback"])
        if opts["debug"]:
            stored_ip, decision = _entry_fields(entry)
            app.logger.debug(
                "CTI login access check username=%r client_ip=%r stored_ip=%r "
                "decision=%r allow_loopback=%s -> %s (%s)",
                username, address, stored_ip, decision,
                opts["allow_loopback"], "allow" if allowed else "deny", reason)
        if not allowed:
            tracker.record_failure(key)
            app.logger.warning(
                "Rejected login for username=%r from %s: %s",
                username, address, reason)
            return render_login(address, next_path, reason, 403)

        tracker.reset(key)
        token = active_signer.issue(user.id_user, user.username, address)
        response = redirect(next_path)
        response.set_cookie(
            COOKIE_NAME,
            token,
            max_age=opts["session_ttl_hours"] * 3600,
            httponly=True,
            samesite="Lax",
            secure=opts["cookie_secure"],
            path="/",
        )
        app.logger.info(
            "Login succeeded for username=%r id=%s from %s",
            user.username, user.id_user, address)
        if opts["debug"]:
            # The token itself is deliberately never logged.
            app.logger.debug(
                "CTI login session issued username=%r id=%s from %r ttl_hours=%s "
                "cookie_secure=%s",
                user.username, user.id_user, address,
                opts["session_ttl_hours"], opts["cookie_secure"])
        return response

    @app.post("/logout")
    def logout():
        response = redirect(url_for("login"))
        response.delete_cookie(COOKIE_NAME, path="/")
        return response

    @app.after_request
    def _security_headers(response):
        response.headers.setdefault("X-Content-Type-Options", "nosniff")
        response.headers.setdefault("X-Frame-Options", "DENY")
        response.headers.setdefault("Referrer-Policy", "same-origin")
        if request.endpoint in ("login", "logout"):
            response.headers.setdefault("Cache-Control", "no-store")
        return response

    # -- catalog ---------------------------------------------------------

    @app.get("/")
    def index():
        artifacts = _visible(read_catalog(), current_bans())
        return render_template(
            "index.html.j2",
            artifacts=artifacts,
            logo=read_logo(),
            generated_at=None,   # live server always shows fresh data
            bundle_password=read_bundle_password(),
            bundle_passwords=read_bundle_passwords(),
            css_url=url_for("static", filename="css/catalog.css"),
        )

    @app.get("/artifact/<path:name>")
    def artifact_detail(name: str):
        """Detail page: identity, sections and disassembly for one artifact."""
        artifact = _find_artifact(read_catalog(), name)
        if artifact is None or _is_banned(artifact, current_bans()):
            abort(404)
        return render_template(
            "artifact.html.j2",
            a=artifact,
            logo=read_logo(),
            generated_at=None,
            bundle_password=read_bundle_password(),
            bundle_passwords=read_bundle_passwords(),
            css_url=url_for("static", filename="css/catalog.css"),
        )

    @app.get("/download/<path:name>")
    def download(name: str):
        """Download the sealed evidence archive for a visible artifact."""
        artifact = _find_artifact(read_catalog(), name)
        if artifact is None or _is_banned(artifact, current_bans()):
            abort(404)
        bundle = _bundle_dir(
            str(artifact.get("bundle_name") or artifact.get("sample_name") or name)
            if isinstance(artifact, dict) else name)
        for pattern in ("*_evidence.zip", "*_evidence.tar.gz", "*.zip", "*.tar.gz"):
            for path in sorted(bundle.glob(pattern)):
                if path.is_file():
                    return send_file(
                        path,
                        as_attachment=True,
                        download_name=path.name,
                    )
        abort(404, description="No archive found for this artifact")

    @app.get("/health")
    def health():
        try:
            raw = json.loads(catalog_path.read_text(encoding="utf-8"))
            count = len(_visible(raw if isinstance(raw, list) else [], current_bans()))
        except Exception:
            count = 0
        return {"ok": True, "artifact_count": count}

    return app


if __name__ == "__main__":
    settings = _load_config()["server"]
    create_app().run(
        host=settings["ip"],
        port=settings["port"],
        debug=False,
        use_reloader=False,
    )

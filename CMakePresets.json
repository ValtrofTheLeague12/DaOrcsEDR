{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "ucrt64",
      "displayName": "MSYS2 UCRT64",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build-ucrt",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "STATIC_ANALYZER_ENABLE_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "ucrt64-release",
      "configurePreset": "ucrt64",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "ucrt64-tests",
      "configurePreset": "ucrt64",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}